# =================================================
# INTERFORMA.DIGITAL — Variables de entorno
# =================================================
# Copia este archivo como .env para desarrollo local.
# NUNCA commitear el archivo .env real.
# =================================================

# ── Analytics ─────────────────────────────────────
# Google Analytics 4 Measurement ID (ej: G-XXXXXXXXXX)
# Dejar vacío para desactivar GA4 (usará ConsoleAdapter en dev)
PUBLIC_GA4_MEASUREMENT_ID=

# ── Sitio ─────────────────────────────────────────
PUBLIC_SITE_URL=https://interforma.digital

# ── Contacto (valores públicos — aparecen en la UI) ─
# Número en formato internacional sin espacios ni guiones (ej: 56912345678)
PUBLIC_WHATSAPP_NUMBER=
# Mensaje predefinido al abrir WhatsApp (URL-encoded se aplica en código)
PUBLIC_WHATSAPP_MESSAGE=
# Email de contacto público
PUBLIC_CONTACT_EMAIL=
