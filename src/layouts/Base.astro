---
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import WhatsAppFloat from '@components/utility/WhatsAppFloat.astro';
import SEOHead from '@components/utility/SEOHead.astro';
import SkipToContent from '@components/utility/SkipToContent.astro';
import '@styles/global.css';
import '@styles/utilities.css';
import type { SEOProps } from '@t/seo';
import { ACTIVE_FONT } from '@config/typography';

export interface Props extends SEOProps {
  bodyClass?: string;
  showFloat?: boolean;
}

const { bodyClass, showFloat = true, ...seoProps } = Astro.props;

const clarityId = import.meta.env.PUBLIC_CLARITY_ID || 'xwqi4gkp67';
const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID?.trim();
---
<!DOCTYPE html>
<html lang="es" class={`font-${ACTIVE_FONT}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#2655E8" />
    <SEOHead {...seoProps} />
    <slot name="head" />
    <!-- Google Analytics 4 -->
    {ga4Id && (
      <Fragment set:html={`<script async src="https://www.googletagmanager.com/gtag/js?id=${ga4Id}"></script><script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ga4Id}');</script>`} />
    )}
    <!-- Microsoft Clarity -->
    <script is:inline define:vars={{ clarityId }}>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window,document,"clarity","script",clarityId);
    </script>
  </head>
  <body class={bodyClass}>
    <SkipToContent />
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <slot name="footer">
      <Footer />
    </slot>
    {showFloat && <WhatsAppFloat />}
    <script>
      import { initScrollTracking } from '@lib/analytics/scroll';
      initScrollTracking();
    </script>
  </body>
</html>
