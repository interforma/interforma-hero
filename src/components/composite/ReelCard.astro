---
import type { Reel } from '@config/reels';
import { serieLabels } from '@config/reels';

export interface Props {
  reel: Reel;
}

const { reel } = Astro.props;
const serieLabel = serieLabels[reel.serie];
---

<article class="reel-card" data-reel-id={reel.id}>
  <div class="reel-card__video-wrap">
    <video
      class="reel-card__video"
      src={reel.src}
      poster={reel.poster}
      playsinline
      muted
      loop
      preload="none"
      aria-label={reel.caption}
    />
    <button
      type="button"
      class="reel-card__play"
      aria-label="Reproducir reel"
    >
      <svg width="56" height="56" viewBox="0 0 56 56" fill="none" aria-hidden="true">
        <circle cx="28" cy="28" r="28" fill="var(--ink)" fill-opacity="0.5" />
        <path d="M22 17l16 11-16 11V17z" fill="var(--white)" />
      </svg>
    </button>
    <button
      type="button"
      class="reel-card__sound"
      aria-label="Activar sonido"
      hidden
    >
      <svg class="reel-card__sound-off" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M11 5L6 9H2v6h4l5 4V5z" fill="var(--white)"/>
        <path d="M23 9l-6 6M17 9l6 6" stroke="var(--white)" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <svg class="reel-card__sound-on" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="display:none">
        <path d="M11 5L6 9H2v6h4l5 4V5z" fill="var(--white)"/>
        <path d="M15.54 8.46a5 5 0 010 7.07M19.07 4.93a10 10 0 010 14.14" stroke="var(--white)" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <span class="reel-card__badge">{serieLabel}</span>
  </div>
  <div class="reel-card__info">
    <p class="reel-card__caption">{reel.caption}</p>
    {reel.instagram && (
      <a
        class="reel-card__link"
        href={reel.instagram}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Ver en Instagram: ${reel.caption}`}
      >
        Ver en Instagram
        <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3.5 10.5L10.5 3.5M10.5 3.5H5M10.5 3.5V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    )}
  </div>
</article>

<style>
  .reel-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-shrink: 0;
    width: 260px;
  }

  .reel-card__video-wrap {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--gray-100);
    cursor: pointer;
  }

  .reel-card__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .reel-card__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.3s var(--easing-default);
  }
  .reel-card__play:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }
  .reel-card__play[data-playing] {
    opacity: 0;
  }
  .reel-card__play[data-playing]:hover {
    opacity: 1;
  }

  .reel-card__sound {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-full);
    background: var(--ink);
    background-color: rgba(40, 31, 24, 0.6);
    border: none;
    cursor: pointer;
    transition: opacity 0.2s var(--easing-default);
    z-index: 1;
  }
  .reel-card__sound:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .reel-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    background: var(--white);
    color: var(--ink);
    font-family: var(--font-family-ui);
    font-size: 11px;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.02em;
    line-height: 1.4;
    pointer-events: none;
  }

  .reel-card__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0 2px;
  }

  .reel-card__caption {
    margin: 0;
    font-size: var(--font-size-body-sm);
    line-height: 1.45;
    color: var(--gray-500);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .reel-card__link {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 11px;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--primary-500);
    text-decoration: none;
    transition: color 0.2s var(--easing-default);
  }
  .reel-card__link:hover { color: var(--ink); }
  .reel-card__link:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }
</style>
