---
import Icon from '@components/base/Icon.astro';
import { site } from '@config/site';

export interface Props {
  label?: string;
  size?: 'sm' | 'md' | 'lg';
  variant?: 'primary' | 'secondary';
  class?: string;
  showIcon?: boolean;
  /** Origen del clic para analytics (evento click_whatsapp). */
  placement?: string;
}

const {
  label = 'Hablar por WhatsApp',
  size = 'md',
  variant = 'primary',
  class: className,
  showIcon = true,
  placement = 'whatsapp_button',
} = Astro.props;

const number = site.whatsappNumber;
const message = site.whatsappMessage;
const href = number
  ? `https://wa.me/${number}${message ? `?text=${encodeURIComponent(message)}` : ''}`
  : '#contacto';
const isExternal = !!number;
---
<a
  href={href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  aria-label={label}
  class:list={['wa-btn', `wa-btn--${variant}`, `wa-btn--${size}`, className]}
  data-track-event="click_whatsapp"
  data-track-placement={placement}
>
  {showIcon && <Icon name="whatsapp" size={size === 'sm' ? 16 : size === 'lg' ? 22 : 18} aria-hidden="true" />}
  <span>{label}</span>
</a>

<script>
  import { track } from '@lib/analytics/track';
  document.querySelectorAll<HTMLAnchorElement>('a.wa-btn').forEach((el) => {
    if (el.dataset.trackBound) return;
    el.dataset.trackBound = '1';
    el.addEventListener('click', () =>
      track('click_whatsapp', { placement: el.dataset.trackPlacement, page_path: location.pathname }));
  });
</script>

<style>
  .wa-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    border-radius: var(--radius-btn);
    font-family: inherit;
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    border: 2px solid transparent;
    cursor: pointer;
    transition:
      background var(--duration-fast) var(--easing-default),
      color var(--duration-fast) var(--easing-default),
      border-color var(--duration-fast) var(--easing-default),
      transform var(--duration-fast) var(--easing-default);
    white-space: nowrap;
  }

  .wa-btn:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .wa-btn:active {
    transform: scale(0.98);
  }

  /* Variants — acción principal Energía con texto Umbra (DESIGN.md §Botones) */
  .wa-btn--primary {
    background: var(--color-action-bg);
    color: var(--color-action-text);
    border-color: var(--color-action-bg);
  }
  .wa-btn--primary:hover {
    background: var(--color-action-bg-hover);
    border-color: var(--color-action-bg-hover);
  }

  .wa-btn--secondary {
    background: transparent;
    color: var(--ink);
    border-color: var(--ink);
  }
  .wa-btn--secondary:hover {
    background: var(--color-interactive-subtle);
  }

  /* Sizes */
  .wa-btn--sm {
    padding: var(--spacing-2) var(--spacing-4);
    font-size: var(--font-size-body-sm);
  }
  .wa-btn--md {
    padding: var(--spacing-3) var(--spacing-5);
    font-size: var(--font-size-body-md);
  }
  .wa-btn--lg {
    padding: var(--spacing-4) var(--spacing-8);
    font-size: var(--font-size-body-lg);
  }
</style>
