---
import type { EstadoCaso } from '@lib/casos';
import { estadoTono } from '@lib/casos';

export interface Props {
  estado: EstadoCaso;
}
const { estado } = Astro.props;
const tono = estadoTono[estado];
---
<span class={`status status--${tono}`}><span class="status__dot" aria-hidden="true"></span>{estado}</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: var(--radius-badge);
    font-size: var(--font-size-label-md);
    font-weight: var(--font-weight-semibold);
    line-height: 1.3;
    white-space: nowrap;
  }
  .status__dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: currentColor;
  }
  .status--success { background: var(--color-success-50); color: var(--color-success-500); }
  .status--warning { background: var(--color-warning-50); color: var(--color-warning-500); }
  .status--info    { background: var(--sky); color: var(--ink); }
</style>
