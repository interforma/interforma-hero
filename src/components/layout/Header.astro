---
import Wordmark from '@components/base/Wordmark.astro';
import { navigation } from '@config/navigation';
---

<!-- Global header height token -->
<style is:global>
  :root {
    --header-height: 60px;
  }
  @media (min-width: 1024px) {
    :root {
      --header-height: 76px;
    }
  }
</style>

<header id="site-header" class="header" data-scrolled="false">
  <div class="header__inner">

    <Wordmark />

    <!-- Desktop pill nav -->
    <nav class="header__nav" aria-label="Navegación principal">
      <ul class="header__nav-list" role="list">
        {navigation.map((item) => (
          <li>
            <a href={item.href} class="header__nav-link" data-track-event={item.trackEvent}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Desktop CTA -->
    <a
      href="https://wa.me/56985408771"
      class="header__cta"
      data-track-event="click_whatsapp"
    >
      Hablar por WhatsApp
    </a>

    <!-- Mobile toggle -->
    <button
      id="mobile-menu-toggle"
      class="header__toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú de navegación"
      type="button"
    >
      <svg class="icon icon--menu" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg class="icon icon--close" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile overlay -->
<div
  id="mobile-menu"
  class="mobile-overlay"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
>
  <nav class="mobile-overlay__nav" aria-label="Menú principal">
    <ul class="mobile-overlay__list" role="list">
      {navigation.map((item) => (
        <li>
          <a href={item.href} class="mobile-overlay__link" data-track-event={item.trackEvent}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="mobile-overlay__footer">
    <a href="https://wa.me/56985408771" class="mobile-overlay__cta">
      Hablar por WhatsApp
    </a>
  </div>
</div>

<style>
  /* ── Shell ───────────────────────────────────────────── */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-height);
    background: var(--white);
    border-bottom: 1px solid var(--gray-100);
    transition:
      box-shadow 200ms var(--ease-default),
      border-color 200ms var(--ease-default);
  }

  .header[data-scrolled="true"] {
    box-shadow: var(--shadow-sm);
    border-bottom-color: var(--gray-200);
  }

  .header__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5.5vw, 80px);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-6);
  }

  /* ── Pill nav ────────────────────────────────────────── */
  .header__nav {
    display: none;
    background: var(--paper);
    border-radius: var(--radius-cta);
    padding: 6px;
  }

  .header__nav-list {
    display: flex;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__nav-link {
    display: block;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 15px;
    font-weight: var(--font-weight-medium);
    color: var(--gray-700);
    text-decoration: none;
    transition: background 150ms, color 150ms;
  }

  .header__nav-link:hover,
  .header__nav-link.is-active {
    background: var(--white);
    color: var(--ink);
  }

  .header__nav-link:focus-visible {
    outline: 2px solid var(--primary-500);
    outline-offset: 2px;
    border-radius: 20px;
  }

  /* ── Desktop CTA ─────────────────────────────────────── */
  .header__cta {
    display: none;
    align-items: center;
    height: 44px;
    padding: 0 20px;
    background: var(--primary-500);
    color: var(--white);
    border-radius: var(--radius-btn);
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    flex-shrink: 0;
    transition: background 150ms;
  }

  .header__cta:hover {
    background: var(--primary-600);
    color: var(--white);
  }

  .header__cta:focus-visible {
    outline: 2px solid var(--primary-500);
    outline-offset: 3px;
    border-radius: var(--radius-btn);
  }

  /* ── Mobile toggle ───────────────────────────────────── */
  .header__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: var(--radius-md);
    color: var(--ink);
    cursor: pointer;
    transition: background 150ms;
  }

  .header__toggle:hover { background: var(--paper); }

  .header__toggle:focus-visible {
    outline: 2px solid var(--primary-500);
    outline-offset: 2px;
  }

  .icon--close { display: none; }
  .header__toggle[aria-expanded="true"] .icon--menu  { display: none; }
  .header__toggle[aria-expanded="true"] .icon--close { display: block; }

  /* ── Mobile overlay ──────────────────────────────────── */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    top: var(--header-height);
    z-index: 99;
    background: var(--white);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--spacing-8) var(--spacing-6) var(--spacing-10);
    border-top: 1px solid var(--gray-200);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 200ms var(--ease-default),
      visibility 200ms,
      transform 200ms var(--ease-default);
  }

  .mobile-overlay[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .mobile-overlay__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .mobile-overlay__link {
    display: block;
    font-size: var(--font-size-heading-md);
    font-weight: var(--font-weight-semibold);
    color: var(--ink);
    text-decoration: none;
    padding: var(--spacing-3) var(--spacing-2);
    border-radius: var(--radius-md);
    transition: background 150ms, color 150ms;
  }

  .mobile-overlay__link:hover { background: var(--paper); }

  .mobile-overlay__link:focus-visible {
    outline: 2px solid var(--primary-500);
    outline-offset: 2px;
  }

  .mobile-overlay__footer {
    padding-top: var(--spacing-8);
    border-top: 1px solid var(--gray-200);
  }

  .mobile-overlay__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 52px;
    background: var(--primary-500);
    color: var(--white);
    border-radius: var(--radius-cta);
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    transition: background 150ms;
  }

  .mobile-overlay__cta:hover { background: var(--primary-600); }

  /* ── Desktop breakpoint ──────────────────────────────── */
  @media (min-width: 1024px) {
    .header__nav  { display: flex; }
    .header__cta  { display: inline-flex; }
    .header__toggle { display: none; }
    .mobile-overlay { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-overlay { transition: none; }
  }
</style>

<script>
  import { track } from '@lib/analytics/track';

  const header  = document.getElementById('site-header') as HTMLElement;
  const toggle  = document.getElementById('mobile-menu-toggle') as HTMLButtonElement;
  const overlay = document.getElementById('mobile-menu') as HTMLElement;

  // ── Scroll state ──────────────────────────────────────
  function updateScrolled() {
    header.dataset.scrolled = (window.scrollY > 10).toString();
  }
  updateScrolled();
  window.addEventListener('scroll', updateScrolled, { passive: true });

  if (toggle && overlay) {
    let isOpen = false;

    function openMenu() {
      isOpen = true;
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Cerrar menú');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      isOpen = false;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menú de navegación');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      toggle.focus();
    }

    toggle.addEventListener('click', () => isOpen ? closeMenu() : openMenu());

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) closeMenu();
    });

    overlay.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
        track({ name: 'nav_click', properties: { destination: link.getAttribute('href'), placement: 'mobile_menu' } });
      });
    });
  }

  // ── Scroll-spy ────────────────────────────────────────
  const navLinks = Array.from(header.querySelectorAll<HTMLAnchorElement>('.header__nav-link'));
  const sectionIds = navLinks.map(a => a.getAttribute('href')?.slice(1)).filter(Boolean) as string[];
  const intersecting = new Set<string>();

  function updateActiveLink() {
    let activeId: string | null = null;
    let minTop = Infinity;
    for (const id of intersecting) {
      const el = document.getElementById(id);
      if (!el) continue;
      const top = Math.abs(el.getBoundingClientRect().top);
      if (top < minTop) { minTop = top; activeId = id; }
    }
    if (!activeId) {
      for (let i = sectionIds.length - 1; i >= 0; i--) {
        const el = document.getElementById(sectionIds[i]);
        if (el && el.getBoundingClientRect().top <= 80) { activeId = sectionIds[i]; break; }
      }
    }
    navLinks.forEach(a => {
      const matches = a.getAttribute('href') === `#${activeId}`;
      a.classList.toggle('is-active', matches);
    });
  }

  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        entry.isIntersecting ? intersecting.add(entry.target.id) : intersecting.delete(entry.target.id);
      }
      updateActiveLink();
    },
    { rootMargin: '-10% 0px -50% 0px', threshold: 0 }
  );

  sectionIds.forEach(id => { const el = document.getElementById(id); if (el) spy.observe(el); });
  updateActiveLink();

  // ── Analytics ─────────────────────────────────────────
  header.querySelectorAll<HTMLAnchorElement>('[data-track-event="click_whatsapp"]').forEach(el => {
    el.addEventListener('click', () => track({ name: 'click_whatsapp', properties: { placement: 'header' } }));
  });
</script>
