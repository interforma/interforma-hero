---
import NavLink from '@components/composite/NavLink.astro';
import WhatsAppButton from '@components/composite/WhatsAppButton.astro';
import { navigation } from '@config/navigation';
---

<!-- Global header height token (used by sections for scroll offset) -->
<style is:global>
  :root {
    --header-height: 56px;
  }
  @media (min-width: 768px) {
    :root {
      --header-height: 64px;
    }
  }
</style>

<header
  id="site-header"
  class="header"
  data-scrolled="false"
>
  <div class="container header__inner">

    <!-- Logo -->
    <a href="/#inicio" class="header__logo" aria-label="Interforma — ir al inicio">
      <span class="header__logo-text">Interforma</span>
    </a>

    <!-- Desktop navigation -->
    <nav class="header__nav" aria-label="Navegación principal">
      <ul class="header__nav-list" role="list">
        {navigation.map((item) => (
          <li>
            <NavLink href={item.href} trackEvent={item.trackEvent} class="header__nav-link">
              {item.label}
            </NavLink>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Desktop CTA + Mobile toggle -->
    <div class="header__actions">
      <WhatsAppButton
        label="Hablar por WhatsApp"
        size="md"
        class="header__wa-cta"
      />

      <button
        id="mobile-menu-toggle"
        class="header__toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
        type="button"
      >
        <!-- Menu icon (visible when closed) -->
        <svg
          class="header__toggle-icon header__toggle-icon--menu"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <!-- Close icon (visible when open) -->
        <svg
          class="header__toggle-icon header__toggle-icon--close"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile overlay -->
<div
  id="mobile-menu"
  class="mobile-overlay"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
>
  <nav class="mobile-overlay__nav" aria-label="Menú principal">
    <ul class="mobile-overlay__list" role="list">
      {navigation.map((item) => (
        <li class="mobile-overlay__item">
          <a
            href={item.href}
            class="mobile-overlay__link"
            data-track-event={item.trackEvent}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="mobile-overlay__footer">
    <WhatsAppButton label="Hablar por WhatsApp" size="lg" class="mobile-overlay__wa-cta" />
  </div>
</div>

<style>
  /* ── Header shell ─────────────────────────────────────────────── */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-height);
    background: var(--color-bg-page);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--duration-fast) var(--easing-default),
      box-shadow var(--duration-fast) var(--easing-default),
      background var(--duration-fast) var(--easing-default);
  }

  .header[data-scrolled="true"] {
    background: var(--color-bg-surface);
    border-bottom-color: var(--color-border-subtle);
    box-shadow: var(--shadow-sm);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: var(--spacing-6);
  }

  /* ── Logo ─────────────────────────────────────────────────────── */
  .header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__logo-text {
    font-size: var(--font-size-heading-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .header__logo:focus-visible {
    outline: 2px solid var(--color-interactive-default);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  /* ── Desktop nav ──────────────────────────────────────────────── */
  .header__nav {
    display: none;
    flex: 1;
    justify-content: center;
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ── Actions ──────────────────────────────────────────────────── */
  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    flex-shrink: 0;
  }

  .header__wa-cta {
    display: none;
  }

  /* ── Mobile toggle ────────────────────────────────────────────── */
  .header__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: background var(--duration-fast) var(--easing-default);
  }

  .header__toggle:hover {
    background: var(--color-neutral-100);
  }

  .header__toggle:focus-visible {
    outline: 2px solid var(--color-interactive-default);
    outline-offset: 2px;
  }

  /* Toggle icon swap via aria-expanded */
  .header__toggle-icon--close {
    display: none;
  }

  .header__toggle[aria-expanded="true"] .header__toggle-icon--menu {
    display: none;
  }

  .header__toggle[aria-expanded="true"] .header__toggle-icon--close {
    display: block;
  }

  /* ── Mobile overlay ───────────────────────────────────────────── */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    top: var(--header-height);
    z-index: 99;
    background: var(--color-bg-surface);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--spacing-8) var(--spacing-6) var(--spacing-10);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition:
      opacity var(--duration-normal) var(--easing-default),
      visibility var(--duration-normal) var(--easing-default),
      transform var(--duration-normal) var(--easing-default);
    border-top: 1px solid var(--color-border-subtle);
  }

  .mobile-overlay[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mobile-overlay__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .mobile-overlay__link {
    display: block;
    font-size: var(--font-size-heading-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    text-decoration: none;
    padding: var(--spacing-3) var(--spacing-2);
    border-radius: var(--radius-md);
    transition: color var(--duration-fast) var(--easing-default),
                background var(--duration-fast) var(--easing-default);
  }

  .mobile-overlay__link:hover {
    color: var(--color-interactive-default);
    background: var(--color-primary-50);
  }

  .mobile-overlay__link:focus-visible {
    outline: 2px solid var(--color-interactive-default);
    outline-offset: 2px;
    color: var(--color-interactive-default);
  }

  .mobile-overlay__footer {
    padding-top: var(--spacing-8);
    border-top: 1px solid var(--color-border-subtle);
  }

  .mobile-overlay__wa-cta {
    width: 100%;
    justify-content: center;
  }

  /* ── Tablet / Desktop breakpoints ────────────────────────────── */
  @media (min-width: 768px) {
    .header__nav {
      display: flex;
    }

    .header__wa-cta {
      display: inline-flex;
    }

    .header__toggle {
      display: none;
    }

    .mobile-overlay {
      display: none;
    }
  }
</style>

<script>
  import { track } from '@lib/analytics/track';

  const header = document.getElementById('site-header') as HTMLElement;
  const toggle = document.getElementById('mobile-menu-toggle') as HTMLButtonElement;
  const overlay = document.getElementById('mobile-menu') as HTMLElement;

  if (!header || !toggle || !overlay) {
    console.warn('[Header] Required elements not found');
  } else {
    // ── Scroll state ─────────────────────────────────────────────
    function updateScrollState() {
      header.dataset.scrolled = (window.scrollY > 10).toString();
    }
    updateScrollState();
    window.addEventListener('scroll', updateScrollState, { passive: true });

    // ── Focus trap ───────────────────────────────────────────────
    function getFocusable(container: HTMLElement): HTMLElement[] {
      return Array.from(
        container.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      );
    }

    let trapHandler: ((e: KeyboardEvent) => void) | null = null;

    function activateTrap() {
      const els = getFocusable(overlay);
      const first = els[0];
      const last = els[els.length - 1];

      trapHandler = (e: KeyboardEvent) => {
        if (e.key !== 'Tab') return;
        if (e.shiftKey) {
          if (document.activeElement === first) {
            e.preventDefault();
            last?.focus();
          }
        } else {
          if (document.activeElement === last) {
            e.preventDefault();
            first?.focus();
          }
        }
      };

      overlay.addEventListener('keydown', trapHandler);
      first?.focus();
    }

    function deactivateTrap() {
      if (trapHandler) {
        overlay.removeEventListener('keydown', trapHandler);
        trapHandler = null;
      }
    }

    // ── Open / close ─────────────────────────────────────────────
    let isOpen = false;

    function openMenu() {
      isOpen = true;
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Cerrar menú de navegación');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      activateTrap();
      track({ name: 'menu_open', properties: { placement: 'header' } });
    }

    function closeMenu(returnFocus = true) {
      isOpen = false;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menú de navegación');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      deactivateTrap();
      if (returnFocus) toggle.focus();
    }

    // ── Toggle button ─────────────────────────────────────────────
    toggle.addEventListener('click', () => {
      isOpen ? closeMenu() : openMenu();
    });

    // ── Escape key ────────────────────────────────────────────────
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) closeMenu();
    });

    // ── Mobile nav links: close on click ─────────────────────────
    overlay.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu(false);
        track({
          name: 'nav_click',
          properties: {
            destination: link.getAttribute('href'),
            placement: 'mobile_menu',
            event: link.dataset.trackEvent,
          },
        });
      });
    });

    // ── Desktop nav links: track clicks ──────────────────────────
    header.querySelectorAll<HTMLAnchorElement>('.header__nav-link a').forEach((link) => {
      link.addEventListener('click', () => {
        track({
          name: 'nav_click',
          properties: {
            destination: link.getAttribute('href'),
            placement: 'header_desktop',
            event: link.dataset.trackEvent,
          },
        });
      });
    });

    // ── WhatsApp CTA tracking (scoped to header to avoid double-fire) ─
    header.querySelectorAll<HTMLAnchorElement>('[data-track-event="click_whatsapp"]').forEach((el) => {
      el.addEventListener('click', () => {
        track({ name: 'click_whatsapp', properties: { placement: 'header' } });
      });
    });

    // ── Scroll-spy: active nav link via IntersectionObserver ──────
    const navLinks = Array.from(
      header.querySelectorAll<HTMLAnchorElement>('.nav-link[href^="#"]')
    );

    const sectionIds = navLinks
      .map((a) => a.getAttribute('href')?.slice(1))
      .filter(Boolean) as string[];

    const intersecting = new Set<string>();

    function updateActiveLink() {
      // Pick the section nearest the top of the viewport among those intersecting
      let activeId: string | null = null;
      let minTop = Infinity;

      for (const id of intersecting) {
        const el = document.getElementById(id);
        if (!el) continue;
        const top = Math.abs(el.getBoundingClientRect().top);
        if (top < minTop) {
          minTop = top;
          activeId = id;
        }
      }

      // If nothing is intersecting, fall back to section before scroll position
      if (!activeId) {
        for (let i = sectionIds.length - 1; i >= 0; i--) {
          const el = document.getElementById(sectionIds[i]);
          if (el && el.getBoundingClientRect().top <= 80) {
            activeId = sectionIds[i];
            break;
          }
        }
      }

      navLinks.forEach((a) => {
        const matches = a.getAttribute('href') === `#${activeId}`;
        a.classList.toggle('is-active', matches);
        a.setAttribute('aria-current', matches ? 'true' : 'false');
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const id = entry.target.id;
          if (entry.isIntersecting) {
            intersecting.add(id);
          } else {
            intersecting.delete(id);
          }
        }
        updateActiveLink();
      },
      { rootMargin: '-10% 0px -50% 0px', threshold: 0 }
    );

    sectionIds.forEach((id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });

    // Initial pass for page load with hash or pre-scrolled state
    updateActiveLink();
  }
</script>
