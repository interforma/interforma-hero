---
import Wordmark from '@components/base/Wordmark.astro';
---

<footer class="footer" role="contentinfo">
  <div class="footer__inner">

    <!-- Brand + tagline -->
    <div class="footer__brand">
      <Wordmark size="sm" href="/#inicio" />
      <span class="footer__tagline">Transformación digital con método.</span>
    </div>

    <!-- Nav -->
    <nav class="footer__nav" aria-label="Mapa del sitio">
      <ul class="footer__nav-list" role="list">
        <li><a href="#metodo"    class="footer__link">Método</a></li>
        <li><a href="#servicios" class="footer__link">Servicios</a></li>
        <li><a href="#sectores"  class="footer__link">Sectores</a></li>
        <li><a href="/privacidad" class="footer__link">Privacidad</a></li>
      </ul>
    </nav>

    <!-- Legal -->
    <span class="footer__copy">&copy; {new Date().getFullYear()} Interforma · Chile</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--gray-100);
    padding: 40px clamp(20px, 5.5vw, 80px);
  }

  .footer__inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  /* ── Brand ───────────────────────────────────────────── */
  .footer__brand {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .footer__tagline {
    font-size: var(--font-size-body-sm);
    color: var(--gray-500);
  }

  /* ── Nav ─────────────────────────────────────────────── */
  .footer__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
  }

  .footer__link {
    font-size: var(--font-size-body-sm);
    color: var(--gray-700);
    text-decoration: none;
    transition: color 150ms;
  }

  .footer__link:hover { color: var(--ink); }

  .footer__link:focus-visible {
    outline: 2px solid var(--primary-500);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* ── Legal ───────────────────────────────────────────── */
  .footer__copy {
    font-size: var(--font-size-body-sm);
    color: var(--gray-500);
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 640px) {
    .footer__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .footer__nav-list { gap: 16px; }
  }
</style>
