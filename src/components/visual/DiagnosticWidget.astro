---
/**
 * DiagnosticWidget.astro
 * Tarjeta de vista previa estilo booking para el Hero (rediseño v2).
 * Referencia: handoff/moodboard-calcom.html — sección .widget
 *
 * Estático — sin JS. Aria-hidden porque es decorativo.
 */
---

<div class="dw" aria-hidden="true">

  <!-- columna izquierda: datos de sesión -->
  <div class="dw__left">
    <div class="dw__avatar">IF</div>
    <p class="dw__org">Equipo Interforma</p>
    <p class="dw__title">Diagnóstico exprés</p>
    <p class="dw__desc">
      Una conversación para mapear tus procesos reales y detectar el cuello
      de botella principal.
    </p>

    <div class="dw__durations">
      <span>15m</span>
      <span class="dw__dur--on">30m</span>
      <span>45m</span>
    </div>

    <div class="dw__meta">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
      </svg>
      Videollamada
    </div>
    <div class="dw__meta">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/>
      </svg>
      Chile · remoto
    </div>
  </div>

  <!-- columna derecha: mini calendario -->
  <div class="dw__right">
    <p class="dw__month">Agosto 2026</p>
    <div class="dw__cal">
      <span>10</span><span>11</span>
      <span class="dw__day--avail">12</span>
      <span class="dw__day--avail">13</span>
      <span>14</span>

      <span>17</span>
      <span class="dw__day--sel">18</span>
      <span class="dw__day--avail">19</span>
      <span class="dw__day--avail">20</span>
      <span>21</span>
    </div>
  </div>

</div>

<style>
  /* ── Widget shell ─────────────────────────────────────────── */
  .dw {
    background: var(--cj-white);
    border: 1px solid var(--cj-gray-200);
    border-radius: var(--radius-card-lg);
    box-shadow: 0 24px 48px -28px rgba(17, 17, 16, 0.22);
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    width: 100%;
    max-width: 460px;
  }

  /* ── Left column ──────────────────────────────────────────── */
  .dw__left {
    padding: 22px 20px;
    border-right: 1px solid var(--cj-gray-100);
  }

  .dw__avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--cj-gray-100);
    border: 1px solid var(--cj-gray-200);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    color: var(--cj-gray-500);
    margin-bottom: 12px;
    font-family: var(--font-family-heading);
  }

  .dw__org {
    font-size: 11.5px;
    color: var(--cj-gray-500);
    margin-bottom: 2px;
    line-height: 1.4;
  }

  .dw__title {
    font-family: var(--font-family-heading);
    font-size: 15px;
    font-weight: 700;
    color: var(--cj-ink);
    margin-bottom: 8px;
    line-height: 1.25;
  }

  .dw__desc {
    font-size: 11.5px;
    color: var(--cj-gray-500);
    line-height: 1.5;
    margin-bottom: 14px;
  }

  /* Duration pills */
  .dw__durations {
    display: flex;
    gap: 6px;
    margin-bottom: 14px;
  }

  .dw__durations span {
    font-size: 11px;
    padding: 4px 8px;
    border-radius: var(--radius-md);
    border: 1px solid var(--cj-gray-200);
    color: var(--cj-gray-500);
    font-family: var(--font-family-ui);
  }

  .dw__dur--on {
    background: var(--cj-ink) !important;
    color: var(--cj-white) !important;
    border-color: var(--cj-ink) !important;
  }

  /* Meta rows */
  .dw__meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    color: var(--cj-gray-500);
    margin-bottom: 6px;
    font-family: var(--font-family-ui);
  }

  /* ── Right column: calendar ───────────────────────────────── */
  .dw__right {
    padding: 20px 16px;
  }

  .dw__month {
    font-family: var(--font-family-heading);
    font-weight: 700;
    font-size: 12.5px;
    color: var(--cj-ink);
    margin-bottom: 12px;
  }

  .dw__cal {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 4px;
  }

  .dw__cal span {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    color: var(--cj-gray-400);
    border-radius: 6px;
    font-family: var(--font-family-ui);
  }

  .dw__day--avail {
    background: var(--cj-gray-50);
    color: var(--cj-ink) !important;
  }

  .dw__day--sel {
    background: var(--cj-ink);
    color: var(--cj-white) !important;
    font-weight: 700;
  }
</style>
