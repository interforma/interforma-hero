---
/**
 * MethodSystemDiagram.astro — v4
 * Sistema/máquina: Datos · Procesos · Equipos → IF Método → Sistema · Claridad · Resultados
 * Particles follow actual SVG bezier paths via getPointAtLength().
 * Plays once on inView, replays on pointerenter.
 * Decorativo — aria-hidden="true", role="presentation".
 */
---

<div class="msd" aria-hidden="true" role="presentation">
  <svg
    class="msd__svg"
    viewBox="0 0 480 304"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
  >
    <defs>
      <filter id="msd-hub-glow" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="5" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>

      <!-- userSpaceOnUse avoids degenerate-bbox failure on horizontal lines -->
      <linearGradient id="msd-grad-e" gradientUnits="userSpaceOnUse"
        x1="74" y1="150" x2="240" y2="150">
        <stop offset="0%"   stop-color="#2655E8" stop-opacity="0.22"/>
        <stop offset="100%" stop-color="#2655E8" stop-opacity="1"/>
      </linearGradient>
      <linearGradient id="msd-grad-s" gradientUnits="userSpaceOnUse"
        x1="240" y1="150" x2="406" y2="150">
        <stop offset="0%"   stop-color="#2655E8" stop-opacity="1"/>
        <stop offset="100%" stop-color="#1A44C9" stop-opacity="1"/>
      </linearGradient>
    </defs>

    <!-- ── Zone dividers ───────────────────────────────────────── -->
    <line x1="160" y1="16" x2="160" y2="272"
      stroke="rgba(21,23,28,0.09)" stroke-width="1" stroke-dasharray="2 9"/>
    <line x1="320" y1="16" x2="320" y2="272"
      stroke="rgba(21,23,28,0.09)" stroke-width="1" stroke-dasharray="2 9"/>

    <!-- ── Corner registration marks ──────────────────────────── -->
    <g class="msd-tick">
      <path d="M28 20 h10 M28 20 v10"/>
      <path d="M452 20 h-10 M452 20 v10"/>
      <path d="M28 284 h10 M28 284 v-10"/>
      <path d="M452 284 h-10 M452 284 v-10"/>
    </g>

    <!-- ── Ghost paths (always faint) ─────────────────────────── -->
    <g stroke="rgba(21,23,28,0.1)" stroke-width="1" stroke-linecap="round">
      <path d="M 94,68  C 160,68  176,150 202,150"/>
      <path d="M 94,150 L 202,150"/>
      <path d="M 94,232 C 160,232 176,150 202,150"/>
      <path d="M 278,150 C 304,150 320,68  386,68"/>
      <path d="M 278,150 L 386,150"/>
      <path d="M 278,150 C 304,150 320,232 386,232"/>
    </g>

    <!-- ── Active paths: ENTRADA → HUB ───────────────────────── -->
    <path class="msd-conn msd-conn-e1" id="msd-ce1" d="M 94,68  C 160,68  176,150 202,150"
      stroke="url(#msd-grad-e)" stroke-width="1.2" stroke-linecap="round"/>
    <path class="msd-conn msd-conn-e2" id="msd-ce2" d="M 94,150 L 202,150"
      stroke="url(#msd-grad-e)" stroke-width="1.2" stroke-linecap="round"/>
    <path class="msd-conn msd-conn-e3" id="msd-ce3" d="M 94,232 C 160,232 176,150 202,150"
      stroke="url(#msd-grad-e)" stroke-width="1.2" stroke-linecap="round"/>

    <!-- ── Active paths: HUB → SALIDA ─────────────────────────── -->
    <path class="msd-conn msd-conn-s1" id="msd-cs1" d="M 278,150 C 304,150 320,68  386,68"
      stroke="url(#msd-grad-s)" stroke-width="1.2" stroke-linecap="round"/>
    <path class="msd-conn msd-conn-s2" id="msd-cs2" d="M 278,150 L 386,150"
      stroke="url(#msd-grad-s)" stroke-width="1.2" stroke-linecap="round"/>
    <path class="msd-conn msd-conn-s3" id="msd-cs3" d="M 278,150 C 304,150 320,232 386,232"
      stroke="url(#msd-grad-s)" stroke-width="1.2" stroke-linecap="round"/>

    <!-- ── ENTRADA nodes ───────────────────────────────────────── -->
    <g class="msd-node msd-node-e1">
      <circle cx="74" cy="68"  r="27" class="msd-node__halo"/>
      <circle cx="74" cy="68"  r="20" class="msd-node__ring"/>
      <circle cx="74" cy="68"  r="5"  class="msd-node__dot"/>
      <circle cx="94" cy="68"  r="2.5" class="msd-node__port"/>
      <text x="74" y="100" class="msd-label">Datos</text>
    </g>

    <g class="msd-node msd-node-e2">
      <circle cx="74" cy="150" r="27" class="msd-node__halo"/>
      <circle cx="74" cy="150" r="20" class="msd-node__ring"/>
      <circle cx="74" cy="150" r="5"  class="msd-node__dot"/>
      <circle cx="94" cy="150" r="2.5" class="msd-node__port"/>
      <text x="74" y="182" class="msd-label">Procesos</text>
    </g>

    <g class="msd-node msd-node-e3">
      <circle cx="74" cy="232" r="27" class="msd-node__halo"/>
      <circle cx="74" cy="232" r="20" class="msd-node__ring"/>
      <circle cx="74" cy="232" r="5"  class="msd-node__dot"/>
      <circle cx="94" cy="232" r="2.5" class="msd-node__port"/>
      <text x="74" y="264" class="msd-label">Equipos</text>
    </g>

    <!-- ── Hub: IF Método ──────────────────────────────────────── -->
    <g class="msd-hub" id="msd-hub">
      <!-- Ambient glow -->
      <circle cx="240" cy="150" r="54" class="msd-hub__glow"/>
      <!-- Outer accent ring -->
      <circle cx="240" cy="150" r="40" class="msd-hub__outer"/>
      <!-- Filled core — scale animates on .on -->
      <circle cx="240" cy="150" r="30" class="msd-hub__core"
        transform-box="fill-box" transform-origin="center"
        filter="url(#msd-hub-glow)"/>
      <!-- Port dots -->
      <circle cx="202" cy="150" r="2.5" class="msd-hub__port"/>
      <circle cx="278" cy="150" r="2.5" class="msd-hub__port"/>
      <!-- Text -->
      <text x="240" y="147" class="msd-hub__if">IF</text>
      <text x="240" y="162" class="msd-hub__method">MÉTODO</text>
    </g>

    <!-- ── SALIDA nodes ────────────────────────────────────────── -->
    <g class="msd-node msd-node-s1">
      <circle cx="406" cy="68"  r="27" class="msd-node__halo"/>
      <circle cx="406" cy="68"  r="20" class="msd-node__ring"/>
      <circle cx="406" cy="68"  r="5"  class="msd-node__dot"/>
      <circle cx="386" cy="68"  r="2.5" class="msd-node__port"/>
      <text x="406" y="100" class="msd-label">Sistema</text>
    </g>

    <g class="msd-node msd-node-s2">
      <circle cx="406" cy="150" r="27" class="msd-node__halo"/>
      <circle cx="406" cy="150" r="20" class="msd-node__ring"/>
      <circle cx="406" cy="150" r="5"  class="msd-node__dot"/>
      <circle cx="386" cy="150" r="2.5" class="msd-node__port"/>
      <text x="406" y="182" class="msd-label">Claridad</text>
    </g>

    <g class="msd-node msd-node-s3">
      <circle cx="406" cy="232" r="27" class="msd-node__halo"/>
      <circle cx="406" cy="232" r="20" class="msd-node__ring"/>
      <circle cx="406" cy="232" r="5"  class="msd-node__dot"/>
      <circle cx="386" cy="232" r="2.5" class="msd-node__port"/>
      <text x="406" y="264" class="msd-label">Resultados</text>
    </g>

    <!-- ── Particles (positioned by JS via getPointAtLength) ───── -->
    <circle class="msd-p" id="msd-pe1" r="3" fill="#2655E8" opacity="0"/>
    <circle class="msd-p" id="msd-pe2" r="3" fill="#2655E8" opacity="0"/>
    <circle class="msd-p" id="msd-pe3" r="3" fill="#2655E8" opacity="0"/>
    <circle class="msd-p" id="msd-ps1" r="3" fill="#2655E8" opacity="0"/>
    <circle class="msd-p" id="msd-ps2" r="3" fill="#2655E8" opacity="0"/>
    <circle class="msd-p" id="msd-ps3" r="3" fill="#2655E8" opacity="0"/>

    <!-- ── Zone labels (always visible) ──────────────────────── -->
    <text x="74"  y="294" class="msd-zone">ENTRADA</text>
    <text x="240" y="294" class="msd-zone">TRANSFORMACIÓN</text>
    <text x="406" y="294" class="msd-zone">SALIDA</text>
  </svg>
</div>

<style>
  /* ── Wrapper ──────────────────────────────────────────────── */
  .msd {
    width: 100%;
    position: relative;
  }

  .msd__svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  /* ── Suppress transitions during instant reset ───────────── */
  .msd.no-transition * {
    transition: none !important;
    animation: none !important;
  }

  /* ── Corner ticks ─────────────────────────────────────────── */
  .msd-tick path {
    stroke: rgba(21, 23, 28, 0.18);
    stroke-width: 1;
    stroke-linecap: square;
    fill: none;
  }

  /* ── Active connection lines — initially hidden ───────────── */
  .msd-conn {
    fill: none;
    /* stroke-dasharray / stroke-dashoffset set by JS */
    transition: stroke-dashoffset 0.95s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .msd-conn.on { stroke-dashoffset: 0 !important; }

  /* ── Node elements — always visible, colors change on .on ── */
  .msd-node__halo {
    fill: #2655E8;
    opacity: 0;
    transition: opacity 0.55s ease;
  }
  .msd-node.on .msd-node__halo { opacity: 0.08; }

  .msd-node__ring {
    fill: white;
    stroke: rgba(21, 23, 28, 0.14);
    stroke-width: 1.25;
    transition: stroke 0.55s ease, fill 0.55s ease;
  }
  .msd-node.on .msd-node__ring {
    stroke: rgba(38, 85, 232, 0.38);
    fill: #f5f8ff;
  }

  .msd-node__dot {
    fill: rgba(21, 23, 28, 0.28);
    transition: fill 0.55s ease;
  }
  .msd-node.on .msd-node__dot { fill: #2655E8; }

  .msd-node__port {
    fill: rgba(21, 23, 28, 0.14);
    transition: fill 0.55s ease;
  }
  .msd-node.on .msd-node__port { fill: rgba(38, 85, 232, 0.45); }

  /* ── Labels ───────────────────────────────────────────────── */
  .msd-label {
    font-size: 10px;
    font-family: var(--font-family-base);
    font-weight: 600;
    text-anchor: middle;
    letter-spacing: 0.02em;
    fill: rgba(17, 17, 16, 0.65);
    transition: fill 0.55s ease, opacity 0.55s ease;
  }
  .msd-node.on .msd-label { fill: #2655E8; }

  /* ── Hub ──────────────────────────────────────────────────── */
  .msd-hub__glow {
    fill: #2655E8;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .msd-hub.on .msd-hub__glow { opacity: 0.07; }

  .msd-hub__outer {
    fill: none;
    stroke: #2655E8;
    stroke-width: 1.5;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .msd-hub.on .msd-hub__outer { opacity: 0.3; }

  .msd-hub__core {
    fill: #2655E8;
    transform: scale(0.78);
    transition: transform 0.5s cubic-bezier(0.34, 1.38, 0.64, 1);
  }
  .msd-hub.on .msd-hub__core { transform: scale(1); }

  .msd-hub__port {
    fill: #2655E8;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .msd-hub.on .msd-hub__port { opacity: 0.5; }

  .msd-hub__if {
    fill: white;
    font-size: 13px;
    font-family: var(--font-family-base);
    font-weight: 700;
    text-anchor: middle;
    letter-spacing: 0.1em;
  }

  .msd-hub__method {
    fill: rgba(255, 255, 255, 0.78);
    font-size: 6.5px;
    font-family: var(--font-family-base);
    font-weight: 600;
    text-anchor: middle;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* ── Zone labels ──────────────────────────────────────────── */
  .msd-zone {
    fill: rgba(21, 23, 28, 0.38);
    font-size: 8px;
    font-family: var(--font-family-base);
    font-weight: 700;
    text-anchor: middle;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* ── prefers-reduced-motion: fully-active static state ───── */
  @media (prefers-reduced-motion: reduce) {
    .msd-conn           { stroke-dashoffset: 0 !important; }
    .msd-node__halo     { opacity: 0.08; }
    .msd-node__ring     { stroke: rgba(38,85,232,0.38); fill: #f5f8ff; }
    .msd-node__dot      { fill: #2655E8; }
    .msd-node__port     { fill: rgba(38,85,232,0.45); }
    .msd-label          { fill: #2655E8; }
    .msd-hub__glow      { opacity: 0.07; }
    .msd-hub__outer     { opacity: 0.3; }
    .msd-hub__core      { transform: scale(1); }
    .msd-hub__port      { opacity: 0.5; }
  }
</style>

<script>
  import { inView } from 'motion';
  import { prefersReducedMotion } from '@lib/motion';

  const root = document.querySelector<HTMLElement>('.msd');
  if (!root) throw new Error('[MethodSystemDiagram] .msd not found');

  // ── Element references ───────────────────────────────────────
  const nodeE1 = root.querySelector('.msd-node-e1')!;
  const nodeE2 = root.querySelector('.msd-node-e2')!;
  const nodeE3 = root.querySelector('.msd-node-e3')!;
  const hub    = root.querySelector('#msd-hub')!;
  const nodeS1 = root.querySelector('.msd-node-s1')!;
  const nodeS2 = root.querySelector('.msd-node-s2')!;
  const nodeS3 = root.querySelector('.msd-node-s3')!;

  const ceE1 = root.querySelector('#msd-ce1') as SVGPathElement;
  const ceE2 = root.querySelector('#msd-ce2') as SVGPathElement;
  const ceE3 = root.querySelector('#msd-ce3') as SVGPathElement;
  const ceS1 = root.querySelector('#msd-cs1') as SVGPathElement;
  const ceS2 = root.querySelector('#msd-cs2') as SVGPathElement;
  const ceS3 = root.querySelector('#msd-cs3') as SVGPathElement;

  const pE1 = root.querySelector('#msd-pe1') as SVGCircleElement;
  const pE2 = root.querySelector('#msd-pe2') as SVGCircleElement;
  const pE3 = root.querySelector('#msd-pe3') as SVGCircleElement;
  const pS1 = root.querySelector('#msd-ps1') as SVGCircleElement;
  const pS2 = root.querySelector('#msd-ps2') as SVGCircleElement;
  const pS3 = root.querySelector('#msd-ps3') as SVGCircleElement;

  const allConns = [ceE1, ceE2, ceE3, ceS1, ceS2, ceS3];
  const allNodes = [nodeE1, nodeE2, nodeE3, nodeS1, nodeS2, nodeS3];
  const allParticles = [pE1, pE2, pE3, pS1, pS2, pS3];

  // ── Prime dasharray from actual path lengths ─────────────────
  for (const path of allConns) {
    const len = path.getTotalLength();
    path.style.strokeDasharray  = String(len);
    path.style.strokeDashoffset = String(len);
  }

  // ── Timer management ─────────────────────────────────────────
  let timers: ReturnType<typeof setTimeout>[] = [];
  let rafs:   number[] = [];

  function clearAll() {
    timers.forEach(clearTimeout);
    rafs.forEach(cancelAnimationFrame);
    timers = [];
    rafs = [];
  }

  function d(ms: number, fn: () => void) {
    timers.push(setTimeout(fn, ms));
  }

  // ── Instant reset (suppress transitions for one frame) ───────
  function reset() {
    clearAll();
    root.classList.add('no-transition');

    // Remove all .on classes
    [...allNodes, hub].forEach(el => el.classList.remove('on'));
    allConns.forEach(path => {
      path.classList.remove('on');
      path.style.strokeDashoffset = String(path.getTotalLength());
    });

    // Reset particles
    for (const p of allParticles) {
      p.style.opacity = '0';
      p.setAttribute('cx', '0');
      p.setAttribute('cy', '0');
    }

    // Re-enable transitions after two frames
    requestAnimationFrame(() => requestAnimationFrame(() => {
      root.classList.remove('no-transition');
    }));
  }

  // ── Particle travel along actual SVG path ────────────────────
  function travel(
    particle: SVGCircleElement,
    path: SVGPathElement,
    duration: number,
    delay: number
  ) {
    const len = path.getTotalLength();

    d(delay, () => {
      particle.style.opacity = '1';
      const start = performance.now();

      function step(now: number) {
        const t = Math.min((now - start) / duration, 1);
        // ease-in-out
        const e = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
        const pt = path.getPointAtLength(e * len);
        particle.setAttribute('cx', String(pt.x));
        particle.setAttribute('cy', String(pt.y));
        // Fade out in last 12% of travel
        particle.style.opacity = t > 0.88 ? String(Math.max(0, (1 - t) / 0.12)) : '1';

        if (t < 1) {
          rafs.push(requestAnimationFrame(step));
        } else {
          particle.style.opacity = '0';
        }
      }

      rafs.push(requestAnimationFrame(step));
    });
  }

  // ── Main play sequence ───────────────────────────────────────
  let playing = false;

  function play() {
    if (prefersReducedMotion()) return;

    playing = true;
    reset();

    // Small breathing room after reset
    d(60, () => {
      // 1. Input nodes light up simultaneously
      d(400, () => {
        [nodeE1, nodeE2, nodeE3].forEach(n => n.classList.add('on'));
      });

      // 2. Input paths draw simultaneously
      d(660, () => {
        [ceE1, ceE2, ceE3].forEach(c => c.classList.add('on'));
      });

      // 3. Particles → hub (staggered 70ms: top, mid, bottom)
      travel(pE1, ceE1, 1100, 720);   // top bezier,   arrives ~1820ms
      travel(pE2, ceE2,  920, 790);   // mid straight, arrives ~1710ms
      travel(pE3, ceE3, 1100, 860);   // bot bezier,   arrives ~1960ms

      // 4. Hub activates when last particle arrives
      d(1700, () => hub.classList.add('on'));

      // 5. Output paths draw
      d(1920, () => {
        [ceS1, ceS2, ceS3].forEach(c => c.classList.add('on'));
      });

      // 6. Particles → output nodes (staggered 70ms)
      travel(pS1, ceS1, 1100, 1980);  // top bezier
      travel(pS2, ceS2,  920, 2050);  // mid straight
      travel(pS3, ceS3, 1100, 2120);  // bot bezier

      // 7. Output nodes light up as particles arrive
      d(2900, () => {
        [nodeS1, nodeS2, nodeS3].forEach(n => n.classList.add('on'));
      });

      // 8. Sequence complete — release playing lock
      d(3800, () => { playing = false; });
    });
  }

  // ── Trigger on inView (first time) ──────────────────────────
  let started = false;
  inView(root, () => {
    if (started || prefersReducedMotion()) return;
    started = true;
    d(300, play);
  }, { amount: 0.25 });

  // ── Replay on hover ──────────────────────────────────────────
  root.addEventListener('pointerenter', () => {
    if (!started || prefersReducedMotion()) return;
    play();
  });
</script>
