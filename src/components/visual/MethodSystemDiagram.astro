---
/**
 * MethodSystemDiagram.astro — v2
 * Sistema/máquina: Datos · Procesos · Equipos → IF Método → Sistema · Claridad · Resultados
 * Bezier connections, layered hub, sequential scroll-triggered activation.
 * Decorativo — aria-hidden="true", role="presentation".
 */
---

<div class="diagram" aria-hidden="true" role="presentation">
  <svg
    class="diagram__svg"
    viewBox="0 0 480 304"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
  >
    <defs>
      <!-- Dot grid -->
      <pattern id="mgrid" width="24" height="24" patternUnits="userSpaceOnUse">
        <circle cx="0"  cy="0"  r="0.7" fill="rgba(0,0,0,0.045)"/>
        <circle cx="24" cy="0"  r="0.7" fill="rgba(0,0,0,0.045)"/>
        <circle cx="0"  cy="24" r="0.7" fill="rgba(0,0,0,0.045)"/>
        <circle cx="24" cy="24" r="0.7" fill="rgba(0,0,0,0.045)"/>
      </pattern>

      <!-- Hub glow -->
      <filter id="hub-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="6" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>

      <!-- Output node glow -->
      <filter id="out-glow" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>

      <!-- Blue gradient for active paths -->
      <linearGradient id="conn-grad-e" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%"   stop-color="var(--color-neutral-300)"/>
        <stop offset="100%" stop-color="var(--color-primary-500)"/>
      </linearGradient>
      <linearGradient id="conn-grad-s" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%"   stop-color="var(--color-primary-500)"/>
        <stop offset="100%" stop-color="var(--color-primary-600)"/>
      </linearGradient>
    </defs>

    <!-- ── Background ────────────────────────────────────────── -->
    <rect width="480" height="304" fill="url(#mgrid)"/>

    <!-- ── Zone dividers ─────────────────────────────────────── -->
    <line
      x1="160" y1="12" x2="160" y2="278"
      stroke="var(--color-neutral-200)" stroke-width="1"
      stroke-dasharray="2 9" opacity="0.55"/>
    <line
      x1="320" y1="12" x2="320" y2="278"
      stroke="var(--color-neutral-200)" stroke-width="1"
      stroke-dasharray="2 9" opacity="0.55"/>

    <!-- ── Ghost paths (skeleton, always visible) ────────────── -->
    <g class="conn-ghosts" stroke="var(--color-neutral-200)" stroke-width="1" stroke-linecap="round">
      <path d="M 94,68 C 160,68 176,150 202,150"/>
      <path d="M 94,150 L 202,150"/>
      <path d="M 94,232 C 160,232 176,150 202,150"/>
      <path d="M 278,150 C 304,150 320,68 386,68"/>
      <path d="M 278,150 L 386,150"/>
      <path d="M 278,150 C 304,150 320,232 386,232"/>
    </g>

    <!-- ── Active paths: ENTRADA → HUB ──────────────────────── -->
    <path class="conn conn-e1" d="M 94,68 C 160,68 176,150 202,150"
      stroke="url(#conn-grad-e)" stroke-width="1.5" stroke-linecap="round"/>
    <path class="conn conn-e2" d="M 94,150 L 202,150"
      stroke="url(#conn-grad-e)" stroke-width="1.5" stroke-linecap="round"/>
    <path class="conn conn-e3" d="M 94,232 C 160,232 176,150 202,150"
      stroke="url(#conn-grad-e)" stroke-width="1.5" stroke-linecap="round"/>

    <!-- ── Active paths: HUB → SALIDA ────────────────────────── -->
    <path class="conn conn-s1" d="M 278,150 C 304,150 320,68 386,68"
      stroke="url(#conn-grad-s)" stroke-width="1.5" stroke-linecap="round"/>
    <path class="conn conn-s2" d="M 278,150 L 386,150"
      stroke="url(#conn-grad-s)" stroke-width="1.5" stroke-linecap="round"/>
    <path class="conn conn-s3" d="M 278,150 C 304,150 320,232 386,232"
      stroke="url(#conn-grad-s)" stroke-width="1.5" stroke-linecap="round"/>

    <!-- ── ENTRADA nodes ──────────────────────────────────────── -->
    <!-- Datos -->
    <g class="node node-e1">
      <!-- Outer ring -->
      <circle cx="74" cy="68"  r="20"
        fill="var(--color-bg-surface)"
        stroke="var(--color-neutral-300)" stroke-width="1.5"/>
      <!-- Inner dot -->
      <circle cx="74" cy="68"  r="6"
        fill="var(--color-neutral-400)"/>
      <!-- Connection port -->
      <circle cx="94" cy="68"  r="2.5"
        fill="var(--color-neutral-300)"/>
      <text x="74" y="99" class="node__label">Datos</text>
    </g>

    <!-- Procesos -->
    <g class="node node-e2">
      <circle cx="74" cy="150" r="20"
        fill="var(--color-bg-surface)"
        stroke="var(--color-neutral-300)" stroke-width="1.5"/>
      <circle cx="74" cy="150" r="6"
        fill="var(--color-neutral-400)"/>
      <circle cx="94" cy="150" r="2.5"
        fill="var(--color-neutral-300)"/>
      <text x="74" y="181" class="node__label">Procesos</text>
    </g>

    <!-- Equipos -->
    <g class="node node-e3">
      <circle cx="74" cy="232" r="20"
        fill="var(--color-bg-surface)"
        stroke="var(--color-neutral-300)" stroke-width="1.5"/>
      <circle cx="74" cy="232" r="6"
        fill="var(--color-neutral-400)"/>
      <circle cx="94" cy="232" r="2.5"
        fill="var(--color-neutral-300)"/>
      <text x="74" y="263" class="node__label">Equipos</text>
    </g>

    <!-- ── Central hub — IF Método ────────────────────────────── -->
    <g class="hub">
      <!-- Ambient halo (pulse via CSS) -->
      <circle cx="240" cy="150" r="50"
        class="hub__halo"
        fill="var(--color-primary-50)"
        transform-box="fill-box" transform-origin="center"/>

      <!-- Port indicators (where connections meet) -->
      <circle cx="202" cy="150" r="3" class="hub__port" fill="var(--color-primary-500)" opacity="0.6"/>
      <circle cx="278" cy="150" r="3" class="hub__port" fill="var(--color-primary-500)" opacity="0.6"/>

      <!-- Outer ring (accent border) -->
      <circle cx="240" cy="150" r="38"
        fill="var(--color-bg-surface)"
        stroke="var(--color-primary-500)" stroke-width="1.5"/>

      <!-- Main filled circle -->
      <circle cx="240" cy="150" r="30"
        fill="var(--color-primary-500)"
        filter="url(#hub-glow)"/>

      <!-- Brand text -->
      <text x="240" y="145" class="hub__label-if">IF</text>
      <text x="240" y="161" class="hub__label-sub">método</text>
    </g>

    <!-- ── SALIDA nodes ────────────────────────────────────────── -->
    <!-- Sistema -->
    <g class="node node-s1">
      <circle cx="406" cy="68"  r="20"
        fill="var(--color-primary-50)"
        stroke="var(--color-primary-500)" stroke-width="1.5"
        filter="url(#out-glow)"/>
      <circle cx="406" cy="68"  r="6"
        fill="var(--color-primary-500)"/>
      <circle cx="386" cy="68"  r="2.5"
        fill="var(--color-primary-400)" opacity="0.7"/>
      <text x="406" y="99" class="node__label node__label--salida">Sistema</text>
    </g>

    <!-- Claridad -->
    <g class="node node-s2">
      <circle cx="406" cy="150" r="20"
        fill="var(--color-primary-50)"
        stroke="var(--color-primary-500)" stroke-width="1.5"
        filter="url(#out-glow)"/>
      <circle cx="406" cy="150" r="6"
        fill="var(--color-primary-500)"/>
      <circle cx="386" cy="150" r="2.5"
        fill="var(--color-primary-400)" opacity="0.7"/>
      <text x="406" y="181" class="node__label node__label--salida">Claridad</text>
    </g>

    <!-- Resultados -->
    <g class="node node-s3">
      <circle cx="406" cy="232" r="20"
        fill="var(--color-primary-50)"
        stroke="var(--color-primary-500)" stroke-width="1.5"
        filter="url(#out-glow)"/>
      <circle cx="406" cy="232" r="6"
        fill="var(--color-primary-500)"/>
      <circle cx="386" cy="232" r="2.5"
        fill="var(--color-primary-400)" opacity="0.7"/>
      <text x="406" y="263" class="node__label node__label--salida">Resultados</text>
    </g>

    <!-- ── Zone labels ─────────────────────────────────────────── -->
    <text x="74"  y="296" class="zone-label">ENTRADA</text>
    <text x="240" y="296" class="zone-label">TRANSFORMACIÓN</text>
    <text x="406" y="296" class="zone-label">SALIDA</text>

    <!-- ── Ambient flow particle ──────────────────────────────── -->
    <circle class="flow-dot" cx="0" cy="0" r="3" opacity="0"
      fill="var(--color-primary-500)"/>
  </svg>
</div>

<style>
  /* ── Wrapper ──────────────────────────────────────────────── */
  .diagram {
    background: var(--color-bg-diagram);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-lg);
    padding: var(--spacing-3);
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .diagram__svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── Connection paths ─────────────────────────────────────── */
  .conn {
    stroke-dasharray: 240;
    stroke-dashoffset: 240;
    fill: none;
  }

  /* ── Nodes ────────────────────────────────────────────────── */
  .node {
    opacity: 0;
  }

  /* ── Node labels ──────────────────────────────────────────── */
  .node__label {
    fill: var(--color-text-secondary);
    font-size: 10px;
    font-family: var(--font-family-base);
    font-weight: 500;
    text-anchor: middle;
    letter-spacing: 0.03em;
  }

  .node__label--salida {
    fill: var(--color-primary-700);
    font-weight: 600;
  }

  /* ── Hub ──────────────────────────────────────────────────── */
  .hub {
    opacity: 0;
  }

  .hub__halo {
    opacity: 0;
  }

  /* CSS pulse — starts once hub is revealed via JS class */
  .hub.is-active .hub__halo {
    animation: hub-pulse 2.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes hub-pulse {
    0%   { transform: scale(1);    opacity: 0.5; }
    70%  { transform: scale(1.18); opacity: 0;   }
    100% { transform: scale(1.18); opacity: 0;   }
  }

  .hub__label-if {
    fill: var(--color-neutral-0);
    font-size: 14px;
    font-family: var(--font-family-base);
    font-weight: 700;
    text-anchor: middle;
    letter-spacing: 0.08em;
  }

  .hub__label-sub {
    fill: rgba(255, 255, 255, 0.7);
    font-size: 8px;
    font-family: var(--font-family-base);
    font-weight: 500;
    text-anchor: middle;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* ── Zone labels ──────────────────────────────────────────── */
  .zone-label {
    fill: var(--color-text-tertiary);
    font-size: 8px;
    font-family: var(--font-family-base);
    font-weight: 600;
    text-anchor: middle;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* ── Flow dot ─────────────────────────────────────────────── */
  .flow-dot {
    transform-box: view-box;
    will-change: transform;
  }

  /* ── Pointer interaction target ───────────────────────────── */
  [data-parallax] {
    transform-box: view-box;
    will-change: transform;
  }

  /* ── prefers-reduced-motion ───────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .conn {
      stroke-dashoffset: 0;
    }
    .node,
    .hub {
      opacity: 1;
    }
    .hub.is-active .hub__halo {
      animation: none;
      opacity: 0.35;
    }
    .flow-dot {
      display: none;
    }
  }
</style>

<script>
  import { animate, inView, hover, stagger } from 'motion';
  import { prefersReducedMotion, isPageVisible } from '@lib/motion';

  const diagramEl = document.querySelector<HTMLElement>('.diagram');
  if (!diagramEl) throw new Error('[MethodSystemDiagram] .diagram not found');
  const diagram: HTMLElement = diagramEl;

  // ── Element references ─────────────────────────────────────
  const nodeE1  = diagram.querySelector('.node-e1') as Element;
  const nodeE2  = diagram.querySelector('.node-e2') as Element;
  const nodeE3  = diagram.querySelector('.node-e3') as Element;
  const hub     = diagram.querySelector('.hub') as Element;
  const nodeS1  = diagram.querySelector('.node-s1') as Element;
  const nodeS2  = diagram.querySelector('.node-s2') as Element;
  const nodeS3  = diagram.querySelector('.node-s3') as Element;
  const connE1  = diagram.querySelector('.conn-e1') as SVGPathElement;
  const connE2  = diagram.querySelector('.conn-e2') as SVGPathElement;
  const connE3  = diagram.querySelector('.conn-e3') as SVGPathElement;
  const connS1  = diagram.querySelector('.conn-s1') as SVGPathElement;
  const connS2  = diagram.querySelector('.conn-s2') as SVGPathElement;
  const connS3  = diagram.querySelector('.conn-s3') as SVGPathElement;
  const flowDot = diagram.querySelector('.flow-dot') as Element;

  // ── Compute exact path lengths and prime dasharray ─────────
  const conns = [connE1, connE2, connE3, connS1, connS2, connS3];
  for (const path of conns) {
    if (!(path instanceof SVGPathElement)) continue;
    const len = path.getTotalLength();
    path.style.strokeDasharray = String(len);
    path.style.strokeDashoffset = String(len);
  }

  // ── Easing shorthand ───────────────────────────────────────
  const ease = [0, 0, 0.2, 1] as const;

  // ── Ambient flow loop ──────────────────────────────────────
  let flowTimer: ReturnType<typeof setTimeout> | null = null;
  let entranceDone = false;

  async function runFlowLoop() {
    if (prefersReducedMotion() || !isPageVisible() || !entranceDone) return;

    // Reset position to E2 connection start, invisible
    animate(flowDot, { x: 94, y: 150, opacity: 0 }, { duration: 0 });

    // Fade in
    await animate(flowDot, { opacity: 0.85 }, { duration: 0.2 }).finished;

    // Traverse to hub along E2 path (straight horizontal)
    await animate(flowDot, { x: 240 }, {
      duration: 1.1, ease: [0.4, 0, 0.2, 1]
    }).finished;

    // Brief pause at hub center
    await new Promise<void>((r) => { flowTimer = setTimeout(r, 280); });

    // Hub to S2 (straight horizontal)
    await animate(flowDot, { x: 386 }, {
      duration: 1.0, ease: [0.4, 0, 0.2, 1]
    }).finished;

    // Fade out at S2
    await animate(flowDot, { opacity: 0 }, { duration: 0.2 }).finished;

    // Loop with pause
    flowTimer = setTimeout(runFlowLoop, 1400);
  }

  // ── Entrance sequence ──────────────────────────────────────
  function runEntrance() {
    if (entranceDone) return;
    entranceDone = true;

    if (prefersReducedMotion()) {
      animate([nodeE1, nodeE2, nodeE3, hub, nodeS1, nodeS2, nodeS3],
        { opacity: 1 }, { duration: 0 });
      for (const conn of conns) {
        (conn as HTMLElement).style.strokeDashoffset = '0';
      }
      hub.classList.add('is-active');
      return;
    }

    // Phase 1 — input nodes appear (0–350ms)
    animate([nodeE1, nodeE2, nodeE3],
      { opacity: [0, 1], y: [4, 0] },
      { delay: stagger(0.09), duration: 0.32, ease }
    );

    // Phase 2 — lines draw toward hub (380–780ms)
    animate(connE1, { strokeDashoffset: 0 }, { delay: 0.38, duration: 0.46, ease });
    animate(connE2, { strokeDashoffset: 0 }, { delay: 0.47, duration: 0.38, ease });
    animate(connE3, { strokeDashoffset: 0 }, { delay: 0.56, duration: 0.46, ease });

    // Phase 3 — hub activates (820ms)
    setTimeout(() => {
      animate(hub, { opacity: [0, 1] }, { duration: 0.30, ease });
      setTimeout(() => hub.classList.add('is-active'), 320);
    }, 820);

    // Phase 4 — lines draw from hub (980–1360ms)
    animate(connS1, { strokeDashoffset: 0 }, { delay: 0.98, duration: 0.46, ease });
    animate(connS2, { strokeDashoffset: 0 }, { delay: 1.06, duration: 0.38, ease });
    animate(connS3, { strokeDashoffset: 0 }, { delay: 1.14, duration: 0.46, ease });

    // Phase 5 — output nodes appear (1380–1540ms)
    animate([nodeS1, nodeS2, nodeS3],
      { opacity: [0, 1], y: [4, 0] },
      { delay: stagger(0.08, { startDelay: 1.38 }), duration: 0.30, ease }
    );

    // Phase 6 — ambient flow starts after full sequence
    flowTimer = setTimeout(runFlowLoop, 2100);
  }

  // ── Trigger on inView ──────────────────────────────────────
  inView(diagram, () => {
    runEntrance();
  }, { amount: 0.25 });

  // ── Pointer parallax on nodes ──────────────────────────────
  const parallaxNodes = [nodeE1, nodeE2, nodeE3, nodeS1, nodeS2, nodeS3];
  const factors = [0.8, 0.4, 0.8, 0.7, 0.35, 0.7];
  const springCfg = { type: 'spring', stiffness: 160, damping: 18, mass: 0.45 } as const;

  diagram.addEventListener('pointermove', (e: Event) => {
    if (!entranceDone) return;
    const pe = e as PointerEvent;
    const rect = diagram.getBoundingClientRect();
    const nx = ((pe.clientX - rect.left)  / rect.width  - 0.5) * 2;
    const ny = ((pe.clientY - rect.top)   / rect.height - 0.5) * 2;
    const max = 5;

    parallaxNodes.forEach((n, i) => {
      animate(n, { x: nx * max * (factors[i] ?? 0.5), y: ny * max * (factors[i] ?? 0.5) }, springCfg);
    });
  });

  diagram.addEventListener('pointerleave', () => {
    parallaxNodes.forEach((n) => animate(n, { x: 0, y: 0 }, springCfg));
  });

  // ── Hover: emphasize connected path ───────────────────────
  const allConns = [connE1, connE2, connE3, connS1, connS2, connS3] as Element[];

  function emphasize(primary: Element[], rest: Element[]) {
    if (!entranceDone) return;
    animate(primary, { opacity: 1,   strokeWidth: 2.2 }, { duration: 0.15 });
    animate(rest,    { opacity: 0.18, strokeWidth: 1.5 }, { duration: 0.15 });
  }
  function restore() {
    animate(allConns, { opacity: 1, strokeWidth: 1.5 }, { duration: 0.18 });
  }

  hover(nodeE1, () => { emphasize([connE1], allConns.filter(c => c !== connE1)); return restore; });
  hover(nodeE2, () => { emphasize([connE2], allConns.filter(c => c !== connE2)); return restore; });
  hover(nodeE3, () => { emphasize([connE3], allConns.filter(c => c !== connE3)); return restore; });
  hover(nodeS1, () => { emphasize([connS1], allConns.filter(c => c !== connS1)); return restore; });
  hover(nodeS2, () => { emphasize([connS2], allConns.filter(c => c !== connS2)); return restore; });
  hover(nodeS3, () => { emphasize([connS3], allConns.filter(c => c !== connS3)); return restore; });
  hover(hub,    () => {
    if (!entranceDone) return () => {};
    animate(allConns, { opacity: 1, strokeWidth: 2 }, { duration: 0.15 });
    return restore;
  });

  // ── Page visibility — pause ambient ───────────────────────
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      if (flowTimer) { clearTimeout(flowTimer); flowTimer = null; }
      animate(flowDot, { opacity: 0 }, { duration: 0.1 });
    } else if (entranceDone && !prefersReducedMotion()) {
      flowTimer = setTimeout(runFlowLoop, 700);
    }
  });
</script>
