---
/**
 * MethodSystemDiagram.astro
 * Diagrama abstracto e interactivo: el sistema de transformación Interforma.
 * Tres zonas: ENTRADA → TRANSFORMACIÓN → SALIDA
 * Tema: claro — superficie neutral-0, borde neutral-200, líneas activas primary-500.
 * Trigger: Motion inView (threshold 0.25)
 * Decorativo: aria-hidden="true", role="presentation"
 */
---

<div class="diagram" aria-hidden="true" role="presentation">
  <svg
    class="diagram__svg"
    viewBox="0 0 380 300"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
  >
    <defs>
      <!-- Subtle dot grid (dark dots on light bg) -->
      <pattern id="dgrid" width="20" height="20" patternUnits="userSpaceOnUse">
        <circle cx="0" cy="0" r="0.8" fill="rgba(0,0,0,0.06)"/>
        <circle cx="20" cy="0" r="0.8" fill="rgba(0,0,0,0.06)"/>
        <circle cx="0" cy="20" r="0.8" fill="rgba(0,0,0,0.06)"/>
        <circle cx="20" cy="20" r="0.8" fill="rgba(0,0,0,0.06)"/>
      </pattern>
    </defs>

    <!-- ── Background grid ──────────────────────────────── -->
    <rect width="380" height="300" fill="url(#dgrid)"/>

    <!-- ── Zone dividers ───────────────────────────────── -->
    <line x1="127" y1="20" x2="127" y2="270"
      stroke="var(--color-neutral-200)" stroke-width="1" stroke-dasharray="3 7" opacity="0.6"/>
    <line x1="253" y1="20" x2="253" y2="270"
      stroke="var(--color-neutral-200)" stroke-width="1" stroke-dasharray="3 7" opacity="0.6"/>

    <!-- ── Ghost lines: skeleton always visible ─────────
         Neutral-200 — represents potential connections
    ─────────────────────────────────────────────────── -->
    <g class="conn-ghosts">
      <line x1="54" y1="58"  x2="190" y2="150"/>
      <line x1="54" y1="150" x2="190" y2="150"/>
      <line x1="54" y1="242" x2="190" y2="150"/>
      <line x1="190" y1="150" x2="326" y2="58"/>
      <line x1="190" y1="150" x2="326" y2="150"/>
      <line x1="190" y1="150" x2="326" y2="242"/>
    </g>

    <!-- ── Animated lines: ENTRADA → CENTER ────────────── -->
    <line class="conn conn-e1" x1="54" y1="58"  x2="190" y2="150"/>
    <line class="conn conn-e2" x1="54" y1="150" x2="190" y2="150"/>
    <line class="conn conn-e3" x1="54" y1="242" x2="190" y2="150"/>

    <!-- ── Animated lines: CENTER → SALIDA ─────────────── -->
    <line class="conn conn-s1" x1="190" y1="150" x2="326" y2="58"/>
    <line class="conn conn-s2" x1="190" y1="150" x2="326" y2="150"/>
    <line class="conn conn-s3" x1="190" y1="150" x2="326" y2="242"/>

    <!-- ── ENTRADA nodes ──────────────────────────────────
         Datos, Procesos, Equipos — estado neutro / sin sistema
    ─────────────────────────────────────────────────────── -->
    <g class="node node-e1" data-node="e1">
      <circle cx="54" cy="58"  r="12" class="node__ring node__ring--entrada"/>
      <circle cx="54" cy="58"  r="5"  class="node__dot node__dot--entrada"/>
      <text x="54" y="79" class="node__label">Datos</text>
    </g>
    <g class="node node-e2" data-node="e2">
      <circle cx="54" cy="150" r="12" class="node__ring node__ring--entrada"/>
      <circle cx="54" cy="150" r="5"  class="node__dot node__dot--entrada"/>
      <text x="54" y="171" class="node__label">Procesos</text>
    </g>
    <g class="node node-e3" data-node="e3">
      <circle cx="54" cy="242" r="12" class="node__ring node__ring--entrada"/>
      <circle cx="54" cy="242" r="5"  class="node__dot node__dot--entrada"/>
      <text x="54" y="263" class="node__label">Equipos</text>
    </g>

    <!-- ── CENTER hub — Interforma ───────────────────────
         Motor de transformación: el Método
    ─────────────────────────────────────────────────────── -->
    <g class="hub">
      <!-- Ambient pulse ring (starts after sequence) -->
      <circle cx="190" cy="150" r="44" class="hub__pulse"/>
      <!-- Main hub -->
      <circle cx="190" cy="150" r="31" class="hub__circle"/>
      <!-- Brand mark -->
      <text x="190" y="146" class="hub__label-brand">IF</text>
      <text x="190" y="161" class="hub__label-sub">método</text>
    </g>

    <!-- ── SALIDA nodes ───────────────────────────────────
         Sistema, Claridad, Resultados — estado conectado
    ─────────────────────────────────────────────────────── -->
    <g class="node node-s1" data-node="s1">
      <circle cx="326" cy="58"  r="12" class="node__ring node__ring--salida"/>
      <circle cx="326" cy="58"  r="5"  class="node__dot node__dot--salida"/>
      <text x="326" y="79" class="node__label node__label--salida">Sistema</text>
    </g>
    <g class="node node-s2" data-node="s2">
      <circle cx="326" cy="150" r="12" class="node__ring node__ring--salida"/>
      <circle cx="326" cy="150" r="5"  class="node__dot node__dot--salida"/>
      <text x="326" y="171" class="node__label node__label--salida">Claridad</text>
    </g>
    <g class="node node-s3" data-node="s3">
      <circle cx="326" cy="242" r="12" class="node__ring node__ring--salida"/>
      <circle cx="326" cy="242" r="5"  class="node__dot node__dot--salida"/>
      <text x="326" y="263" class="node__label node__label--salida">Resultados</text>
    </g>

    <!-- ── Zone labels ───────────────────────────────────── -->
    <text x="54"  y="291" class="zone-label">ENTRADA</text>
    <text x="190" y="291" class="zone-label">TRANSFORMACIÓN</text>
    <text x="326" y="291" class="zone-label">SALIDA</text>

    <!-- Ambient flow indicator — positioned via JS transform -->
    <circle class="flow-dot" cx="0" cy="0" r="3.5" opacity="0" />
  </svg>
</div>

<style>
  /* ── Wrapper — superficie clara delimitada ────────────────── */
  .diagram {
    background: var(--color-bg-diagram);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-lg);
    padding: var(--spacing-3);
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .diagram__svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── Ghost lines: skeleton (always visible, neutral) ─────── */
  .conn-ghosts line {
    stroke: var(--color-line-inactive);
    stroke-width: 1;
    stroke-linecap: round;
  }

  /* ── Animated lines: draw in primary color on trigger ─────── */
  .conn {
    stroke: var(--color-primary-500);
    stroke-width: 1.5;
    stroke-dasharray: 170;
    stroke-dashoffset: 170;
    stroke-linecap: round;
  }

  /* ── Nodes ────────────────────────────────────────────────── */
  .node {
    opacity: 0;
  }

  /* ENTRADA: neutral — datos sin procesar */
  .node__ring--entrada {
    fill: var(--color-bg-surface);
    stroke: var(--color-neutral-300);
    stroke-width: 1.5;
  }
  .node__dot--entrada {
    fill: var(--color-neutral-400);
  }

  /* SALIDA: brand — sistema conectado */
  .node__ring--salida {
    fill: var(--color-primary-50);
    stroke: var(--color-primary-500);
    stroke-width: 1.5;
  }
  .node__dot--salida {
    fill: var(--color-primary-500);
  }

  .node__label {
    fill: var(--color-text-secondary);
    font-size: 10px;
    font-family: var(--font-family-base);
    text-anchor: middle;
    letter-spacing: 0.02em;
  }

  .node__label--salida {
    fill: var(--color-primary-700);
    font-weight: 500;
  }

  /* ── Central hub ──────────────────────────────────────────── */
  .hub {
    opacity: 0;
  }

  .hub__pulse {
    fill: var(--color-primary-50);
    transform-box: fill-box;
    transform-origin: center;
  }

  .hub__circle {
    fill: var(--color-primary-500);
    stroke: var(--color-primary-600);
    stroke-width: 1.5;
    filter: drop-shadow(0 0 8px rgba(38, 85, 232, 0.18));
  }

  .hub__label-brand {
    fill: var(--color-neutral-0);
    font-size: 13px;
    font-family: var(--font-family-base);
    font-weight: 700;
    text-anchor: middle;
    letter-spacing: 0.1em;
  }

  .hub__label-sub {
    fill: rgba(255, 255, 255, 0.65);
    font-size: 8px;
    font-family: var(--font-family-base);
    font-weight: 500;
    text-anchor: middle;
    letter-spacing: 0.12em;
  }

  /* ── Zone labels ──────────────────────────────────────────── */
  .zone-label {
    fill: var(--color-text-tertiary);
    font-size: 8px;
    font-family: var(--font-family-base);
    font-weight: 600;
    text-anchor: middle;
    letter-spacing: 0.14em;
  }

  /* ── Flow dot ─────────────────────────────────────────────── */
  .flow-dot {
    fill: var(--color-primary-500);
    transform-box: view-box;
  }

  /* ── Pointer-movable nodes ────────────────────────────────── */
  [data-node] {
    transform-box: view-box;
    will-change: transform;
  }

  /* ── prefers-reduced-motion ───────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .conn { stroke-dashoffset: 0; }
    .node, .hub { opacity: 1; }
    .hub__pulse { animation: none; }
    .flow-dot { display: none; }
  }
</style>

<script>
  import { animate, inView, hover, stagger } from 'motion';
  import { prefersReducedMotion, isPageVisible } from '@lib/motion';

  const diagramEl = document.querySelector<HTMLElement>('.diagram');
  if (!diagramEl) throw new Error('MethodSystemDiagram: .diagram not found');

  // Keep a non-null reference for closures
  const diagram: HTMLElement = diagramEl;

  // ── Element references ─────────────────────────────────────────
  // Cast to Element so Motion uses the DOM overload (not the Object overload)
  const nodeE1 = diagram.querySelector('.node-e1') as Element;
  const nodeE2 = diagram.querySelector('.node-e2') as Element;
  const nodeE3 = diagram.querySelector('.node-e3') as Element;
  const nodeS1 = diagram.querySelector('.node-s1') as Element;
  const nodeS2 = diagram.querySelector('.node-s2') as Element;
  const nodeS3 = diagram.querySelector('.node-s3') as Element;
  const hub    = diagram.querySelector('.hub') as Element;
  const connE1 = diagram.querySelector('.conn-e1') as Element;
  const connE2 = diagram.querySelector('.conn-e2') as Element;
  const connE3 = diagram.querySelector('.conn-e3') as Element;
  const connS1 = diagram.querySelector('.conn-s1') as Element;
  const connS2 = diagram.querySelector('.conn-s2') as Element;
  const connS3 = diagram.querySelector('.conn-s3') as Element;
  const flowDot = diagram.querySelector('.flow-dot') as Element;

  const movableNodes: Element[] = [nodeE1, nodeE2, nodeE3, nodeS1, nodeS2, nodeS3];
  // Varying spring response factors per node (creates organic feel)
  const pointerFactors = [0.85, 0.45, 0.85, 0.75, 0.40, 0.75];

  // ── Ambient flow loop ──────────────────────────────────────────
  let flowTimer: ReturnType<typeof setTimeout> | null = null;

  async function runFlowLoop() {
    if (prefersReducedMotion() || !isPageVisible()) return;

    // Position at E2, fade in
    await animate(flowDot, { opacity: 0.75 }, { duration: 0.25 }).finished;
    animate(flowDot, { x: 54, y: 150 }, { duration: 0 });

    // Traverse E2 → HUB
    await animate(flowDot, { x: 190 }, {
      duration: 1.2, ease: [0.4, 0, 0.2, 1]
    }).finished;

    // Brief pause at hub
    await new Promise<void>((r) => { flowTimer = setTimeout(r, 350); });

    // HUB → S2
    await animate(flowDot, { x: 326 }, {
      duration: 1.2, ease: [0.4, 0, 0.2, 1]
    }).finished;

    // Fade out
    await animate(flowDot, { opacity: 0 }, { duration: 0.25 }).finished;

    // Reset position silently, then loop
    animate(flowDot, { x: 54, y: 150, opacity: 0 }, { duration: 0 });
    flowTimer = setTimeout(runFlowLoop, 1600);
  }

  // ── Entrance sequence ──────────────────────────────────────────
  let entranceDone = false;

  function runEntrance() {
    if (entranceDone) return;
    entranceDone = true;

    if (prefersReducedMotion()) {
      // Show everything immediately
      animate([nodeE1, nodeE2, nodeE3, hub, nodeS1, nodeS2, nodeS3], { opacity: 1 }, { duration: 0 });
      animate([connE1, connE2, connE3, connS1, connS2, connS3], { strokeDashoffset: 0 }, { duration: 0 });
      return;
    }

    // Phase 1: ENTRADA nodes appear (0–240ms)
    animate([nodeE1, nodeE2, nodeE3], { opacity: [0, 1] }, {
      delay: stagger(0.08), duration: 0.3, ease: [0, 0, 0.2, 1]
    });

    // Phase 2: lines draw E→HUB (360–680ms)
    animate(connE1, { strokeDashoffset: 0 }, { delay: 0.36, duration: 0.48, ease: [0, 0, 0.2, 1] });
    animate(connE2, { strokeDashoffset: 0 }, { delay: 0.44, duration: 0.48, ease: [0, 0, 0.2, 1] });
    animate(connE3, { strokeDashoffset: 0 }, { delay: 0.52, duration: 0.48, ease: [0, 0, 0.2, 1] });

    // Phase 3: hub activates (800ms)
    animate(hub, { opacity: [0, 1] }, { delay: 0.80, duration: 0.28, ease: [0, 0, 0.2, 1] });

    // Phase 4: lines draw HUB→SALIDA (1000–1360ms)
    animate(connS1, { strokeDashoffset: 0 }, { delay: 1.00, duration: 0.48, ease: [0, 0, 0.2, 1] });
    animate(connS2, { strokeDashoffset: 0 }, { delay: 1.08, duration: 0.48, ease: [0, 0, 0.2, 1] });
    animate(connS3, { strokeDashoffset: 0 }, { delay: 1.16, duration: 0.48, ease: [0, 0, 0.2, 1] });

    // Phase 5: SALIDA nodes appear (1400–1560ms)
    animate([nodeS1, nodeS2, nodeS3], { opacity: [0, 1] }, {
      delay: stagger(0.08, { startDelay: 1.40 }), duration: 0.3, ease: [0, 0, 0.2, 1]
    });

    // Phase 6: start ambient flow after full sequence
    flowTimer = setTimeout(runFlowLoop, 2200);
  }

  // ── IntersectionObserver via Motion inView ─────────────────────
  inView(diagram, () => {
    runEntrance();
    // inView fires once; return nothing so it doesn't re-run on exit
  }, { amount: 0.25 });

  // ── Pointer spring interaction ─────────────────────────────────
  const springCfg = { type: 'spring', stiffness: 180, damping: 18, mass: 0.4 } as const;

  function onPointerMove(e: PointerEvent) {
    if (!entranceDone) return;
    const rect = diagram.getBoundingClientRect();
    const nx = ((e.clientX - rect.left) / rect.width - 0.5) * 2;   // -1..1
    const ny = ((e.clientY - rect.top)  / rect.height - 0.5) * 2;  // -1..1
    const maxPx = 5;

    movableNodes.forEach((node, i) => {
      const f = pointerFactors[i] ?? 0.5;
      animate(node, { x: nx * maxPx * f, y: ny * maxPx * f }, springCfg);
    });
  }

  function onPointerLeave() {
    movableNodes.forEach((node) => {
      animate(node, { x: 0, y: 0 }, springCfg);
    });
  }

  diagram.addEventListener('pointermove', onPointerMove);
  diagram.addEventListener('pointerleave', onPointerLeave);

  // ── Node hover interactions ────────────────────────────────────
  const allConns: Element[] = [connE1, connE2, connE3, connS1, connS2, connS3];

  function emphasize(primary: Element[], rest: Element[]) {
    animate(primary, { opacity: 1, strokeWidth: 2.2 }, { duration: 0.15 });
    animate(rest, { opacity: 0.2 }, { duration: 0.15 });
  }
  function restore() {
    animate(allConns, { opacity: 1, strokeWidth: 1.5 }, { duration: 0.15 });
  }

  hover(nodeE1, () => { emphasize([connE1], [connE2, connE3, connS1, connS2, connS3]); return restore; });
  hover(nodeE2, () => { emphasize([connE2], [connE1, connE3, connS1, connS2, connS3]); return restore; });
  hover(nodeE3, () => { emphasize([connE3], [connE1, connE2, connS1, connS2, connS3]); return restore; });
  hover(nodeS1, () => { emphasize([connS1], [connE1, connE2, connE3, connS2, connS3]); return restore; });
  hover(nodeS2, () => { emphasize([connS2], [connE1, connE2, connE3, connS1, connS3]); return restore; });
  hover(nodeS3, () => { emphasize([connS3], [connE1, connE2, connE3, connS1, connS2]); return restore; });
  hover(hub,    () => { animate(allConns, { opacity: 1, strokeWidth: 2 }, { duration: 0.15 }); return restore; });

  // ── Page visibility — pause ambient ───────────────────────────
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      if (flowTimer) { clearTimeout(flowTimer); flowTimer = null; }
      animate(flowDot, { opacity: 0 }, { duration: 0.1 });
    } else if (entranceDone && !prefersReducedMotion()) {
      flowTimer = setTimeout(runFlowLoop, 800);
    }
  });
</script>
