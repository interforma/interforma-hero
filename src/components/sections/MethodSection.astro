---
import { methodSteps, methodCopy } from '@config/content';
---

<section id="metodo" class="method" aria-labelledby="method-headline">

  <!-- Canvas fills the full section as background layer -->
  <canvas class="method__canvas" id="methodCanvas" aria-hidden="true"></canvas>

  <div class="container method__inner">

    <!-- ── Header ──────────────────────────────────────────────── -->
    <div class="method__header">
      <p class="method__definition">
        Interforma es una consultora digital chilena especializada en transformación empresarial mediante estrategia, procesos, tecnología, automatización e inteligencia artificial.
      </p>
      <p class="eyebrow method__eyebrow">{methodCopy.eyebrow}</p>
      <h2 id="method-headline" class="method__headline">{methodCopy.headline}</h2>
      <p class="method__subheadline">{methodCopy.subheadline}</p>
    </div>

    <!-- ── Steps (normal flow, no sticky) ─────────────────────── -->
    <ol class="method__steps" role="list">
      {methodSteps.map((step) => (
        <li class="method-step" data-step={step.id - 1}>
          <span class="method-step__gate" aria-hidden="true"></span>
          <div class="method-step__num-col" aria-hidden="true">
            <span class="method-step__indicator"></span>
            <span class="method-step__num">{step.number}</span>
          </div>
          <div class="method-step__content">
            <h3 class="method-step__name">{step.name}</h3>
            <p class="method-step__desc">{step.description}</p>
            <p class="method-step__output">→ {step.output}</p>
          </div>
        </li>
      ))}
    </ol>

    <p class="method__legend">Cada etapa cierra con una puerta de decisión: continuar, ajustar o detener, según la evidencia.</p>
    <p class="method__foot">El proceso manda. La herramienta sirve.</p>

  </div>
</section>

<style>
  /* ── Section shell ────────────────────────────────────────── */
  .method {
    position: relative;
    background: var(--color-bg-dark-refined);
    color: var(--color-text-on-dark-primary);
    scroll-margin-top: var(--header-height);
    overflow: hidden;
  }

  /* ── Canvas: absolute, fills entire section ───────────────── */
  .method__canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  /* ── Inner container above canvas ─────────────────────────── */
  .method__inner {
    position: relative;
    z-index: 1;
    padding-block: var(--spacing-20) var(--spacing-16);
  }

  /* ── Header ───────────────────────────────────────────────── */
  .method__definition {
    font-size: var(--font-size-body-sm);
    color: rgba(255, 255, 255, 0.45);
    max-width: 72ch;
    margin-bottom: var(--spacing-10);
    line-height: var(--line-height-body-lg);
  }

  .method__eyebrow {
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: var(--spacing-4);
  }

  .method__headline {
    font-size: var(--font-size-display-md);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-display-md);
    letter-spacing: -0.02em;
    color: var(--color-text-on-dark-primary);
    margin-bottom: var(--spacing-4);
  }

  .method__subheadline {
    font-size: var(--font-size-body-lg);
    line-height: var(--line-height-body-lg);
    color: rgba(255, 255, 255, 0.65);
    max-width: 52ch;
    margin-bottom: 0;
  }

  /* ── Steps list ───────────────────────────────────────────── */
  .method__steps {
    list-style: none;
    padding: 0;
    margin: var(--spacing-16) 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
  }

  /* ── Single step ──────────────────────────────────────────── */
  .method-step {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--spacing-6);
    padding-block: var(--spacing-8);
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
    align-items: start;
    opacity: 0.38;
    transition: opacity var(--duration-motion-normal) var(--ease-standard);
  }

  .method-step.is-active {
    opacity: 1;
  }

  /* ── Gate diamond ────────────────────────────────────────── */
  .method-step__gate {
    position: absolute;
    top: var(--spacing-8);
    right: 0;
    width: 9px;
    height: 9px;
    background: var(--agents-500);
    transform: rotate(45deg);
    flex-shrink: 0;
    opacity: 0.55;
    transition: opacity var(--duration-motion-fast) var(--ease-standard);
  }

  .method-step.is-active .method-step__gate {
    opacity: 1;
  }

  /* ── Legend ───────────────────────────────────────────────── */
  .method__legend {
    font-size: var(--font-size-body-sm);
    color: rgba(255, 255, 255, 0.45);
    max-width: 60ch;
    margin-top: var(--spacing-8);
    margin-bottom: 0;
    line-height: var(--line-height-body-md);
    padding-left: 16px;
    border-left: 2px solid var(--agents-500);
  }

  /* ── Number column ────────────────────────────────────────── */
  .method-step__num-col {
    padding-top: var(--spacing-1);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-2);
  }

  .method-step__indicator {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.35);
    flex-shrink: 0;
    transition:
      background  var(--duration-motion-fast) var(--ease-standard),
      border-color var(--duration-motion-fast) var(--ease-standard),
      box-shadow  var(--duration-motion-fast) var(--ease-standard);
  }

  .method-step.is-active .method-step__indicator {
    background: rgba(255, 255, 255, 0.85);
    border-color: rgba(255, 255, 255, 0.85);
    box-shadow: 0 0 6px rgba(255, 255, 255, 0.25);
  }

  .method-step__num {
    font-size: var(--font-size-heading-lg);
    font-weight: var(--font-weight-bold);
    color: rgba(255, 255, 255, 0.45);
    line-height: 1;
    letter-spacing: -0.04em;
    transition: color var(--duration-motion-fast) var(--ease-standard);
  }

  .method-step.is-active .method-step__num {
    color: rgba(255, 255, 255, 0.85);
  }

  /* ── Step content ─────────────────────────────────────────── */
  .method-step__name {
    font-size: var(--font-size-heading-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-heading-xl);
    color: var(--color-neutral-0);
    margin-bottom: var(--spacing-3);
  }

  .method-step__desc {
    font-size: var(--font-size-body-lg);
    line-height: var(--line-height-body-lg);
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: var(--spacing-4);
    max-width: 52ch;
  }

  .method-step__output {
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-medium);
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.01em;
  }

  /* ── Footer tagline ───────────────────────────────────────── */
  .method__foot {
    font-size: var(--font-size-body-sm);
    color: rgba(255, 255, 255, 0.35);
    border-top: 1px solid rgba(255, 255, 255, 0.13);
    padding-top: var(--spacing-3);
    margin-top: var(--spacing-8);
    letter-spacing: 0.01em;
  }

  /* ── Tablet ───────────────────────────────────────────────── */
  @media (min-width: 768px) {
    .method__headline {
      font-size: var(--font-size-display-lg);
      line-height: var(--line-height-display-lg);
    }

    .method-step {
      grid-template-columns: 72px 1fr;
      gap: var(--spacing-8);
      padding-block: var(--spacing-10);
    }

    .method-step__num {
      font-size: var(--font-size-heading-xl);
    }
  }

  /* ── Desktop ──────────────────────────────────────────────── */
  @media (min-width: 1024px) {
    .method__inner {
      padding-block: var(--spacing-24) var(--spacing-20);
    }

    .method__steps {
      margin-top: var(--spacing-20);
    }

    .method-step {
      grid-template-columns: 96px 1fr;
      gap: var(--spacing-10);
      padding-block: var(--spacing-12);
    }

    .method-step__name {
      font-size: var(--font-size-display-md);
      line-height: var(--line-height-display-md);
    }

    .method-step__desc {
      font-size: var(--font-size-body-xl);
      line-height: var(--line-height-body-xl);
    }
  }

  /* ── prefers-reduced-motion ──────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .method__canvas {
      display: none;
    }

    .method-step {
      opacity: 1;
      transition: none;
    }
  }
</style>

<script>
  // ── Method canvas: caos → estructura (IntersectionObserver-driven) ──
  (() => {
    const methodEl = document.querySelector('.method');
    const canvas   = document.getElementById('methodCanvas');
    if (!canvas || !methodEl) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const ctx = canvas.getContext('2d');
    let MW = 1, MH = 1, MD = 1;
    let targetProgress = 0, currentProgress = 0, activeStep = -1;

    const clamp  = (v, a, b) => Math.max(a, Math.min(b, v));
    const smooth = (a, b, x) => { const t = clamp((x - a) / (b - a), 0, 1); return t * t * (3 - 2 * t); };
    const noise  = (x, y, t = 0) =>
      Math.sin(x * 1.71 + y * 0.73 + t) +
      Math.sin(x * 0.51 - y * 1.21 - t * 0.43) * 0.55 +
      Math.cos(y * 0.31 + x * 0.24 + t * 0.19) * 0.31;

    const steps = [...document.querySelectorAll('.method-step')];
    const total = steps.length - 1; // = 5

    function sizeCanvas() {
      const r = methodEl.getBoundingClientRect();
      MD = Math.min(devicePixelRatio || 1, 2);
      MW = Math.max(1, Math.floor(r.width  * MD));
      MH = Math.max(1, Math.floor(r.height * MD));
      canvas.width  = MW;
      canvas.height = MH;
    }

    // ── IntersectionObserver: step entering viewport center ────
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const idx = parseInt(entry.target.dataset.step, 10);
        if (isNaN(idx)) return;
        targetProgress = idx / total;
        if (idx !== activeStep) {
          activeStep = idx;
          steps.forEach((el, i) => el.classList.toggle('is-active', i === idx));
        }
      });
    }, {
      // Step is "active" when it occupies the middle 40% of the viewport
      rootMargin: '-30% 0px -30% 0px',
      threshold: 0,
    });

    steps.forEach((step) => observer.observe(step));

    // ── Draw loop ──────────────────────────────────────────────
    function draw(t) {
      // Lerp toward target — smooth transition between steps
      currentProgress += (targetProgress - currentProgress) * 0.05;

      ctx.fillStyle = '#131310';
      ctx.fillRect(0, 0, MW, MH);

      const lineCount = 68, top = MH * 0.06, bottom = MH * 0.94;
      for (let i = 0; i < lineCount; i++) {
        const u        = i / (lineCount - 1);
        const targetX  = MW * (0.09 + u * 0.82);
        const chaos    = (1 - smooth(0,   1,   currentProgress)) * MW * 0.085;
        const organize = smooth(0,   0.8, currentProgress);
        const clarity  = smooth(0.5, 1,   currentProgress);

        ctx.beginPath();
        for (let j = 0; j <= 90; j++) {
          const v = j / 90;
          const y = top + v * (bottom - top);
          let x = targetX
            + noise(u * 9, v * 7, t * 0.00017 + i * 0.02) * chaos * (0.55 + 0.45 * Math.sin(v * Math.PI));
          x += Math.sin(v * 8 + t * 0.00044 + i * 0.12) * MW * 0.006 * (1 - clarity);
          x += Math.sin((u - 0.5) * Math.PI) * Math.sin(v * Math.PI) * MW * 0.038 * (1 - organize);

          if (clarity > 0.01) {
            const lx   = MW * 0.31, rx = MW * 0.69;
            const pull = clarity * Math.exp(-Math.pow((u - (u < 0.5 ? 0.36 : 0.64)) / 0.14, 2)) * 0.32;
            x = x * (1 - pull) + (u < 0.5 ? lx : rx) * pull;
          }
          j === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        }
        ctx.strokeStyle = `rgba(233,225,210,${(0.10 + organize * 0.16 + clarity * 0.18).toFixed(3)})`;
        ctx.lineWidth   = Math.max(0.55 * MD, (0.6 + clarity * 0.35) * MD);
        ctx.stroke();
      }

      // Grid structure emerges from step 04 onwards
      const rv = smooth(0.67, 1, currentProgress);
      if (rv > 0.001) {
        const x = MW * 0.31, y = MH * 0.27, w = MW * 0.38, h = MH * 0.46;
        ctx.strokeStyle = `rgba(233,225,210,${(0.08 + rv * 0.55).toFixed(3)})`;
        ctx.lineWidth   = MD;
        ctx.strokeRect(x, y, w, h);

        for (let i = 1; i < 5; i++) {
          ctx.beginPath();
          ctx.moveTo(x + w * i / 5, y);
          ctx.lineTo(x + w * i / 5, y + h);
          ctx.strokeStyle = `rgba(233,225,210,${(0.03 + rv * 0.12).toFixed(3)})`;
          ctx.stroke();
        }
        for (let i = 1; i < 4; i++) {
          ctx.beginPath();
          ctx.moveTo(x, y + h * i / 4);
          ctx.lineTo(x + w, y + h * i / 4);
          ctx.stroke();
        }
      }

      requestAnimationFrame(draw);
    }

    // Resize: re-measure section height (canvas is absolute, fills section)
    const ro = new ResizeObserver(sizeCanvas);
    ro.observe(methodEl);

    sizeCanvas();
    requestAnimationFrame(draw);
  })();
</script>
