---
import { methodSteps, methodCopy } from '@config/content';
---

<section id="metodo" class="method" aria-labelledby="method-headline">
  <div class="container method__grid">

    <!-- ── Columna izquierda: copy (sticky en desktop) ────────── -->
    <div class="method__copy">
      <div class="method__copy-top">
        <p class="method__definition">
          Interforma es una consultora digital chilena especializada en transformación empresarial mediante estrategia, procesos, tecnología, automatización e inteligencia artificial.
        </p>
        <p class="eyebrow method__eyebrow">{methodCopy.eyebrow}</p>
        <h2 id="method-headline" class="method__headline">{methodCopy.headline}</h2>
        <p class="method__subheadline">{methodCopy.subheadline}</p>
      </div>
      <p class="method__foot">El proceso manda. La herramienta sirve.</p>
    </div>

    <!-- ── Columna derecha: stage sticky (canvas + steps) ─────── -->
    <div class="method__stage">
      <canvas class="method__canvas" id="methodCanvas" aria-hidden="true"></canvas>
      <ol
        class="method__steps-overlay"
        role="list"
        aria-label="Etapas del Método Interforma"
      >
        {methodSteps.map((step) => (
          <li class="method-step" data-step={step.id - 1}>
            <span class="method-step__idx" aria-hidden="true">{step.number}</span>
            <strong class="method-step__name">{step.name}</strong>
            <span class="method-step__outcome">{step.output}</span>
          </li>
        ))}
      </ol>
    </div>

  </div>
</section>

<style>
  /* ── Section ──────────────────────────────────────────────── */
  .method {
    min-height: 160svh;
    background: var(--color-bg-dark-refined);
    color: var(--color-text-on-dark-primary);
    scroll-margin-top: var(--header-height);
  }

  .method__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-8);
    align-items: start;
    padding-block: var(--spacing-20) var(--spacing-12);
  }

  /* ── Left column ──────────────────────────────────────────── */
  .method__copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--spacing-8);
  }

  .method__definition {
    font-size: var(--font-size-body-sm);
    color: rgba(255, 255, 255, 0.45);
    max-width: 72ch;
    margin-bottom: var(--spacing-10);
    line-height: var(--line-height-body-lg);
  }

  .method__eyebrow {
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: var(--spacing-4);
  }

  .method__headline {
    font-size: var(--font-size-display-md);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-display-md);
    letter-spacing: -0.02em;
    color: var(--color-text-on-dark-primary);
    margin-bottom: var(--spacing-4);
  }

  .method__subheadline {
    font-size: var(--font-size-body-lg);
    line-height: var(--line-height-body-lg);
    color: rgba(255, 255, 255, 0.65);
    max-width: 38ch;
  }

  .method__foot {
    font-size: var(--font-size-body-sm);
    color: rgba(255, 255, 255, 0.45);
    border-top: 1px solid rgba(255, 255, 255, 0.13);
    padding-top: var(--spacing-3);
    letter-spacing: 0.01em;
  }

  /* ── Right column: canvas stage ──────────────────────────── */
  .method__stage {
    position: relative;
    height: calc(100svh - var(--header-height) - var(--spacing-12));
    border: 1px solid rgba(233, 225, 210, 0.15);
    background: #131310;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .method__canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ── Steps overlay ────────────────────────────────────────── */
  .method__steps-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: repeat(6, 1fr);
    list-style: none;
    padding: 0;
    margin: 0;
    z-index: 4;
    pointer-events: none;
  }

  .method-step {
    display: grid;
    grid-template-columns: 44px 1fr;
    align-items: end;
    gap: var(--spacing-2);
    padding: var(--spacing-3) var(--spacing-4);
    border-bottom: 1px solid rgba(233, 225, 210, 0.08);
  }

  .method-step:last-child {
    border-bottom: 0;
  }

  .method-step__idx,
  .method-step__name,
  .method-step__outcome {
    font-size: 9px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .method-step__idx {
    color: rgba(233, 225, 210, 0.45);
  }

  .method-step__name {
    font-weight: 500;
    color: var(--color-text-on-dark-primary);
    opacity: 0.17;
    transition: opacity 0.32s ease;
  }

  .method-step__outcome {
    display: none;
    color: rgba(233, 225, 210, 0.36);
    opacity: 0.28;
    transition: opacity 0.32s ease;
    text-align: right;
  }

  .method-step.is-active .method-step__name {
    opacity: 1;
  }

  .method-step.is-active .method-step__outcome {
    opacity: 0.88;
  }

  /* ── Desktop: sticky two-column layout ───────────────────── */
  @media (min-width: 1024px) {
    .method__grid {
      grid-template-columns: minmax(260px, 0.64fr) minmax(0, 1.36fr);
      gap: var(--spacing-8);
      padding-block: var(--spacing-24) var(--spacing-12);
    }

    .method__copy {
      position: sticky;
      top: calc(var(--header-height) + var(--spacing-6));
      height: calc(100svh - var(--header-height) - var(--spacing-12));
    }

    .method__stage {
      position: sticky;
      top: calc(var(--header-height) + var(--spacing-4));
    }

    .method__headline {
      font-size: var(--font-size-display-lg);
      line-height: var(--line-height-display-lg);
    }

    .method-step {
      grid-template-columns: 44px 1fr auto;
    }

    .method-step__outcome {
      display: block;
    }
  }

  /* ── prefers-reduced-motion ──────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .method__stage {
      display: none;
    }
    .method-step__name,
    .method-step__outcome {
      opacity: 1;
      transition: none;
    }
  }
</style>

<script>
  // ── Method canvas: caos → estructura (scroll-driven) ──────────
  (() => {
    const methodEl = document.querySelector('.method');
    const canvas   = document.getElementById('methodCanvas');
    if (!canvas || !methodEl) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const ctx = canvas.getContext('2d');
    let MW = 1, MH = 1, MD = 1, progress = 0, current = -1;

    const clamp  = (v, a, b) => Math.max(a, Math.min(b, v));
    const smooth = (a, b, x) => { const t = clamp((x - a) / (b - a), 0, 1); return t * t * (3 - 2 * t); };
    const noise  = (x, y, t = 0) =>
      Math.sin(x * 1.71 + y * 0.73 + t) +
      Math.sin(x * 0.51 - y * 1.21 - t * 0.43) * 0.55 +
      Math.cos(y * 0.31 + x * 0.24 + t * 0.19) * 0.31;

    const steps = [...document.querySelectorAll('.method-step')];

    function sizeCanvas() {
      const r = canvas.getBoundingClientRect();
      MD = Math.min(devicePixelRatio || 1, 2);
      MW = Math.max(1, Math.floor(r.width  * MD));
      MH = Math.max(1, Math.floor(r.height * MD));
      canvas.width  = MW;
      canvas.height = MH;
    }

    function updateProgress() {
      const r = methodEl.getBoundingClientRect();
      // Start: section top at viewport bottom (canvas first enters view)
      // End:   section bottom at viewport bottom (step 06 exits)
      // Range = offsetHeight (160svh) → each of the 6 steps covers ~26.7svh of scroll
      progress = clamp((innerHeight - r.top) / methodEl.offsetHeight, 0, 1);

      const s = Math.min(5, Math.floor(progress * 6));
      if (s !== current) {
        current = s;
        steps.forEach((el, i) => el.classList.toggle('is-active', i === s));
      }
    }

    function draw(t) {
      ctx.fillStyle = '#131310';
      ctx.fillRect(0, 0, MW, MH);

      const lineCount = 68, top = MH * 0.06, bottom = MH * 0.94;
      for (let i = 0; i < lineCount; i++) {
        const u        = i / (lineCount - 1);
        const targetX  = MW * (0.09 + u * 0.82);
        // Spread across full [0→1] range so step 03 ≈ 50% organized, step 06 = fully structured
        const chaos    = (1 - smooth(0,    1,   progress)) * MW * 0.085;
        const organize = smooth(0,    0.8, progress); // 50% at p≈0.42 (step 03 midpoint)
        const clarity  = smooth(0.5,  1,   progress); // starts at step 03, done at step 06

        ctx.beginPath();
        for (let j = 0; j <= 90; j++) {
          const v = j / 90;
          const y = top + v * (bottom - top);
          let x = targetX
            + noise(u * 9, v * 7, t * 0.00017 + i * 0.02) * chaos * (0.55 + 0.45 * Math.sin(v * Math.PI));
          x += Math.sin(v * 8 + t * 0.00044 + i * 0.12) * MW * 0.006 * (1 - clarity);
          x += Math.sin((u - 0.5) * Math.PI) * Math.sin(v * Math.PI) * MW * 0.038 * (1 - organize);

          if (clarity > 0.01) {
            const lx   = MW * 0.31, rx = MW * 0.69;
            const pull = clarity * Math.exp(-Math.pow((u - (u < 0.5 ? 0.36 : 0.64)) / 0.14, 2)) * 0.32;
            x = x * (1 - pull) + (u < 0.5 ? lx : rx) * pull;
          }
          j === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        }
        ctx.strokeStyle = `rgba(233,225,210,${(0.10 + organize * 0.16 + clarity * 0.18).toFixed(3)})`;
        ctx.lineWidth   = Math.max(0.55 * MD, (0.6 + clarity * 0.35) * MD);
        ctx.stroke();
      }

      const rv = smooth(0.67, 1, progress); // grid appears step 04→06
      if (rv > 0.001) {
        const x = MW * 0.31, y = MH * 0.27, w = MW * 0.38, h = MH * 0.46;
        ctx.strokeStyle = `rgba(233,225,210,${(0.08 + rv * 0.55).toFixed(3)})`;
        ctx.lineWidth   = MD;
        ctx.strokeRect(x, y, w, h);

        for (let i = 1; i < 5; i++) {
          ctx.beginPath();
          ctx.moveTo(x + w * i / 5, y);
          ctx.lineTo(x + w * i / 5, y + h);
          ctx.strokeStyle = `rgba(233,225,210,${(0.03 + rv * 0.12).toFixed(3)})`;
          ctx.stroke();
        }
        for (let i = 1; i < 4; i++) {
          ctx.beginPath();
          ctx.moveTo(x, y + h * i / 4);
          ctx.lineTo(x + w, y + h * i / 4);
          ctx.stroke();
        }
      }

      requestAnimationFrame(draw);
    }

    const ro = new ResizeObserver(sizeCanvas);
    ro.observe(canvas.parentElement);
    window.addEventListener('scroll',  updateProgress, { passive: true });
    window.addEventListener('resize',  updateProgress);

    sizeCanvas();
    updateProgress();
    requestAnimationFrame(draw);
  })();
</script>
