---
import { problems, problemsCopy } from '@config/content';
import CornerMarks from '@components/base/CornerMarks.astro';
---

<section id="problemas" class="problems" aria-labelledby="problems-headline">
  <CornerMarks color="neutral" size={12} offset={14} />

  <div class="container">

    <div class="problems__header">
      <p class="eyebrow problems__eyebrow">{problemsCopy.eyebrow}</p>
      <h2 id="problems-headline" class="problems__headline">{problemsCopy.headline}</h2>
      <p class="problems__subheadline">{problemsCopy.subheadline}</p>
    </div>

    <p class="problems__frame">{problemsCopy.frame}</p>

    <ul class="problems__grid" role="list">
      {problems.map((problem) => (
        <li class="problem-card" data-pid={problem.id}>

          <!-- Badge: 44×44 con 4 puntos de esquina + ícono de línea -->
          <div class="badge" aria-hidden="true">
            <span class="badge__dot badge__dot--bl"></span>
            <span class="badge__dot badge__dot--br"></span>
            {problem.id === 1 && (
              <svg class="badge__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="5" width="16" height="11" rx="2"/>
                <path d="M9 20h6M12 16v4"/>
              </svg>
            )}
            {problem.id === 2 && (
              <svg class="badge__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6" cy="6" r="2.2"/>
                <circle cx="6" cy="18" r="2.2"/>
                <circle cx="18" cy="12" r="2.2"/>
                <path d="M8 6.8 16 11M8 17.2 16 13"/>
              </svg>
            )}
            {problem.id === 3 && (
              <svg class="badge__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="8" r="2.6"/>
                <circle cx="16" cy="9" r="2.1"/>
                <path d="M4 19c0-2.8 2.2-5 5-5s5 2.2 5 5M14.5 14.2c2.2.4 3.5 2.1 3.5 4.3"/>
              </svg>
            )}
            {problem.id === 4 && (
              <svg class="badge__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 20V10l4-2 4 2 4-2 4 2v10z"/>
                <path d="M8 8v12M16 8v12"/>
              </svg>
            )}
            {problem.id === 5 && (
              <svg class="badge__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 4h3v3.5a1.5 1.5 0 0 0 3 0V4h3v3h-3.5a1.5 1.5 0 0 0 0 3H18v3h-3v3.5a1.5 1.5 0 0 1-3 0V16H8.5a1.5 1.5 0 0 1 0-3H12V9H9z"/>
              </svg>
            )}
            {problem.id === 6 && (
              <svg class="badge__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="9" width="7" height="7" rx="1.5"/>
                <rect x="14" y="9" width="7" height="7" rx="1.5"/>
                <path d="M10 12h4" stroke-dasharray="2 2"/>
              </svg>
            )}
          </div>

          <h3 class="problem-card__title">{problem.title}</h3>
          <p class="problem-card__desc">{problem.description}</p>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  /* ── Section ──────────────────────────────────────────────── */
  .problems {
    background: var(--color-bg-subtle);
    padding-block: var(--spacing-20);
    scroll-margin-top: var(--header-height);
    position: relative;
  }

  /* ── Header ───────────────────────────────────────────────── */
  .problems__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--spacing-10);
    position: relative;
  }

  .problems__eyebrow {
    margin-bottom: var(--spacing-4);
  }

  .problems__headline {
    font-size: var(--font-size-display-md);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-display-md);
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-5);
  }

  .problems__subheadline {
    font-size: var(--font-size-body-xl);
    line-height: var(--line-height-body-xl);
    color: var(--color-text-secondary);
  }

  /* ── Frame ────────────────────────────────────────────────── */
  .problems__frame {
    font-size: var(--font-size-body-lg);
    line-height: var(--line-height-body-lg);
    color: var(--color-text-secondary);
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--spacing-12);
    padding-inline: var(--spacing-4);
  }

  /* ── Grid ─────────────────────────────────────────────────── */
  .problems__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* ── Badge (Cal.com signature) ───────────────────────────── */
  .badge {
    position: relative;
    width: 44px;
    height: 44px;
    background: var(--cj-white);
    border: 1px solid var(--cj-gray-200);
    border-radius: var(--radius-badge);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--spacing-5);
    flex-shrink: 0;
  }

  /* Top-left and top-right corner dots via pseudo-elements */
  .badge::before {
    content: '';
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--cj-gray-400);
    top: 6px;
    left: 6px;
  }
  .badge::after {
    content: '';
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--cj-gray-400);
    top: 6px;
    right: 6px;
  }

  /* Bottom-left and bottom-right corner dots via child spans */
  .badge__dot {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--cj-gray-400);
  }
  .badge__dot--bl { bottom: 6px; left: 6px; }
  .badge__dot--br { bottom: 6px; right: 6px; }

  .badge__ico {
    width: 19px;
    height: 19px;
    color: var(--cj-ink);
    display: block;
  }

  /* ── Problem card ─────────────────────────────────────────── */
  .problem-card {
    background: var(--cj-white);
    border: 1px solid var(--cj-gray-100);
    border-radius: var(--radius-card);
    padding: var(--spacing-6);
    opacity: 0; /* Motion will reveal */
    transition:
      transform  var(--duration-motion-fast) var(--ease-standard),
      box-shadow var(--duration-motion-fast) var(--ease-standard);
  }

  .problem-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 26px -18px rgba(17, 17, 16, 0.22);
  }

  .problem-card__title {
    font-size: var(--font-size-heading-sm);
    font-weight: var(--font-weight-bold);
    line-height: 1.35;
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-2);
  }

  .problem-card__desc {
    font-size: var(--font-size-body-sm);
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (min-width: 640px) {
    .problems__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .problems__headline {
      font-size: var(--font-size-display-md);
      line-height: var(--line-height-display-md);
    }
  }

  @media (min-width: 768px) {
    .problems {
      padding-block: var(--spacing-20);
    }
  }

  @media (min-width: 1024px) {
    .problems__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* prefers-reduced-motion: skip scroll-reveal, show immediately */
  @media (prefers-reduced-motion: reduce) {
    .problem-card {
      opacity: 1;
      transition: box-shadow var(--duration-motion-fast) var(--ease-standard);
    }

    .problem-card:hover {
      transform: none;
    }
  }
</style>

<script>
  import { inView, hover, animate } from 'motion';
  import { prefersReducedMotion } from '@lib/motion';

  const cards = document.querySelectorAll<HTMLElement>('.problem-card');

  if (prefersReducedMotion()) {
    cards.forEach((card) => { card.style.opacity = '1'; card.style.translate = 'none'; });
  } else {
    // Individual scroll-reveal per card
    cards.forEach((card) => {
      inView(card, (element) => {
        animate(element, { opacity: [0, 1], y: [12, 0] }, {
          duration: 0.4, ease: [0, 0, 0.2, 1]
        });
      }, { amount: 0.15, margin: '0px 0px -40px 0px' });
    });
  }

  // Badge icon: subtle scale on card hover
  if (!prefersReducedMotion()) {
    cards.forEach((card) => {
      const ico = card.querySelector<SVGElement>('.badge__ico');
      if (!ico) return;
      hover(card, () => {
        animate(ico, { scale: 1.12 }, { duration: 0.18, ease: [0, 0, 0.2, 1] });
        return () => animate(ico, { scale: 1 }, { duration: 0.15 });
      });
    });
  }
</script>
