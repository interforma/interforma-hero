---
import Icon from '@components/base/Icon.astro';
import Punto from '@components/base/Punto.astro';
import { site } from '@config/site';

const number = site.whatsappNumber;
const message = site.whatsappMessage;
const href = number
  ? `https://wa.me/${number}${message ? `?text=${encodeURIComponent(message)}` : ''}`
  : '#contacto';
const isExternal = !!number;
---

<a
  href={href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class="wa-float"
  aria-label="Hablar por WhatsApp"
  data-track-event="click_whatsapp_float"
  title="Hablar por WhatsApp"
>
  <Icon name="whatsapp" size={28} aria-hidden="true" />
  <span class="wa-float__tooltip" aria-hidden="true">Hablar por WhatsApp</span>
</a>

<!-- Saludo de Punto: aparece una vez por sesión, a los 6 s; se cierra solo a los 12 s -->
<div class="punto-hi" id="puntoHi" role="complementary" aria-label="Saludo de Interforma" hidden>
  <a
    href={href}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener noreferrer' : undefined}
    class="punto-hi__link"
    data-punto-hi-link
  >
    <Punto expr="saluda" size={44} alive />
    <span class="punto-hi__text">
      <strong>¿Conversamos?</strong>
      <span>Respondemos por WhatsApp.</span>
    </span>
  </a>
  <button type="button" class="punto-hi__close" aria-label="Cerrar saludo" data-punto-hi-close>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
</div>

<style>
  .wa-float {
    position: fixed;
    bottom: var(--spacing-6);
    right: var(--spacing-6);
    z-index: 90;
    width: 56px;
    height: 56px;
    background: #25D366;
    color: var(--color-neutral-0);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    box-shadow: var(--shadow-lg), 0 0 0 0 rgba(37, 211, 102, 0);
    transition:
      transform var(--duration-fast) var(--easing-default),
      box-shadow var(--duration-fast) var(--easing-default);
  }

  .wa-float::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-full);
    animation: wa-pulse 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    background: rgba(37, 211, 102, 0.35);
    z-index: -1;
  }

  .wa-float:hover {
    transform: scale(1.08);
    box-shadow: var(--shadow-lg), 0 8px 32px rgba(37, 211, 102, 0.4);
  }

  .wa-float:focus-visible {
    outline: 3px solid #25D366;
    outline-offset: 3px;
    transform: scale(1.08);
  }

  .wa-float:active {
    transform: scale(0.96);
  }

  /* ── Tooltip ──────────────────────────────────────────────── */
  .wa-float__tooltip {
    position: absolute;
    right: calc(100% + var(--spacing-3));
    top: 50%;
    transform: translateY(-50%);
    background: var(--color-neutral-900);
    color: var(--color-neutral-0);
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
    padding: var(--spacing-2) var(--spacing-4);
    border-radius: var(--radius-md);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-fast) var(--easing-default);
  }

  .wa-float__tooltip::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 100%;
    transform: translateY(-50%);
    border: 6px solid transparent;
    border-left-color: var(--color-neutral-900);
  }

  .wa-float:hover .wa-float__tooltip,
  .wa-float:focus-visible .wa-float__tooltip {
    opacity: 1;
  }

  /* ── Saludo de Punto ──────────────────────────────────────── */
  .punto-hi {
    position: fixed;
    right: var(--spacing-6);
    bottom: calc(var(--spacing-6) + 56px + 14px);
    z-index: 90;
    display: flex;
    align-items: center;
    gap: 4px;
    max-width: min(280px, calc(100vw - 2 * var(--spacing-6)));
    padding: 10px 6px 10px 12px;
    background: var(--white);
    color: var(--ink);
    border: 1px solid var(--color-border-default);
    border-radius: 16px;
    box-shadow: var(--shadow-lg);
    animation: punto-hi-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .punto-hi[hidden] { display: none; }

  /* Cola hacia el botón */
  .punto-hi::after {
    content: '';
    position: absolute;
    right: 22px;
    bottom: -7px;
    width: 12px;
    height: 12px;
    background: var(--white);
    border-right: 1px solid var(--color-border-default);
    border-bottom: 1px solid var(--color-border-default);
    transform: rotate(45deg);
  }

  .punto-hi__link {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    border-radius: 10px;
  }

  .punto-hi__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--font-size-body-sm);
    line-height: 1.3;
  }

  .punto-hi__text strong { font-weight: var(--font-weight-semibold); }
  .punto-hi__text span { color: var(--color-text-secondary); }

  .punto-hi__close {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    border-radius: 50%;
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  .punto-hi__close:hover { color: var(--ink); }

  .punto-hi__link:focus-visible,
  .punto-hi__close:focus-visible {
    outline: 2px solid var(--brand-800, #9A3D1A);
    outline-offset: 2px;
  }

  /* Mientras Punto saluda, el tooltip del botón no compite */
  :global(body.has-punto-hi) .wa-float__tooltip { display: none; }

  @keyframes punto-hi-in {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to   { opacity: 1; transform: none; }
  }

  /* ── Pulse animation ──────────────────────────────────────── */
  @keyframes wa-pulse {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    70% {
      transform: scale(1.5);
      opacity: 0;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  /* ── prefers-reduced-motion ───────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .wa-float::before {
      animation: none;
    }

    .wa-float:hover {
      transform: none;
    }

    .punto-hi {
      animation: none;
    }
  }
</style>

<script>
  import { track } from '@lib/analytics/track';

  document
    .querySelector('[data-track-event="click_whatsapp_float"]')
    ?.addEventListener('click', () => {
      track({ name: 'click_whatsapp', properties: { placement: 'float' } });
    });

  /*
   * Saludo de Punto
   * Objetivo: invitar a conversar sin interrumpir. KPI: tasa de clic del saludo
   * (click_whatsapp con placement 'punto_bubble' / punto_bubble_view).
   * Éxito: ≥ 3 % de clics sin subir el abandono de la página.
   */
  (() => {
    const hi = document.getElementById('puntoHi');
    if (!hi) return;
    const KEY = 'interforma:punto-hi';
    let seen = false;
    try { seen = sessionStorage.getItem(KEY) === '1'; } catch { /* almacenamiento bloqueado */ }
    if (seen) return;

    let hideTimer: ReturnType<typeof setTimeout> | undefined;

    const close = (reason: 'dismiss' | 'timeout' | 'click') => {
      if (hi.hidden) return;
      hi.hidden = true;
      document.body.classList.remove('has-punto-hi');
      clearTimeout(hideTimer);
      if (reason === 'dismiss') track({ name: 'punto_bubble_dismiss' });
    };

    setTimeout(() => {
      hi.hidden = false;
      document.body.classList.add('has-punto-hi');
      try { sessionStorage.setItem(KEY, '1'); } catch { /* sin almacenamiento */ }
      track({ name: 'punto_bubble_view', properties: { path: location.pathname } });
      hideTimer = setTimeout(() => close('timeout'), 12000);
    }, 6000);

    hi.querySelector('[data-punto-hi-link]')?.addEventListener('click', () => {
      track({ name: 'click_whatsapp', properties: { placement: 'punto_bubble' } });
      close('click');
    });
    hi.querySelector('[data-punto-hi-close]')?.addEventListener('click', () => close('dismiss'));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close('dismiss'); });
  })();
</script>
