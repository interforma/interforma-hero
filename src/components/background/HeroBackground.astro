---
/**
 * HeroBackground.astro
 * Fondo halftone abstracto para la sección Hero.
 * Tres capas con parallax sutil vinculado al scroll y al puntero.
 *
 * Capas:
 *   0 — blob grande, esquina inferior-izquierda (primary-500)
 *   1 — sphere, lado derecho superior (primary-500, baja opacidad) — solo desktop
 *   2 — hexagon, área del diagrama (neutral-300, muy baja opacidad) — solo desktop
 *
 * Sin dependencias externas. Canvas 2D + requestAnimationFrame.
 * Respeta prefers-reduced-motion y document.hidden.
 * aria-hidden="true". pointer-events: none.
 */
---

<canvas class="hero-bg" aria-hidden="true"></canvas>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    display: block;
  }
</style>

<script>
  import { drawHalftone } from '@lib/halftone';
  import type { ShapeType } from '@lib/halftone';
  import { prefersReducedMotion } from '@lib/motion';

  // ── Layer definition ───────────────────────────────────────────
  interface LayerDef {
    shape:      ShapeType;
    sizeD:      number;   // desktop size (px)
    sizeM:      number;   // mobile size (px)
    getX:       (W: number, size: number) => number;
    getY:       (H: number, size: number) => number;
    opacity:    number;
    lineGap:    number;
    lineWidth:  number;
    light:      number;
    angle:      number;
    color:      string;
    scrollFy:   number;   // px per scrollY px (vertical)
    scrollFx:   number;   // px per scrollY px (horizontal)
    pointerFy:  number;   // px per center-offset px (vertical)
    pointerFx:  number;   // px per center-offset px (horizontal)
    desktopOnly?: boolean;
  }

  const LAYERS: LayerDef[] = [
    // ── 0: Blob — bottom-left, primary blue ───────────────────
    {
      shape:     'blob',
      sizeD:     620, sizeM: 260,
      getX:      (_W, _s) => -140,
      getY:      (H, s)  => H - s * 0.60,
      opacity:   0.30,
      lineGap: 5.0, lineWidth: 0.36, light: 1.4, angle: 40,
      color:     '#2655E8',
      scrollFy: 0.026, scrollFx:  0.010,
      pointerFy: 0.004, pointerFx: 0.003,
    },
    // ── 1: Sphere — upper right, primary blue, lower opacity ──
    {
      shape:     'sphere',
      sizeD:     480, sizeM: 200,
      getX:      (W, s) => W - s * 0.70,
      getY:      (_H, s) => -s * 0.20,
      opacity:   0.20,
      lineGap: 5.5, lineWidth: 0.30, light: 1.3, angle: 55,
      color:     '#2655E8',
      scrollFy: -0.018, scrollFx: -0.012,
      pointerFy: -0.003, pointerFx: -0.002,
      desktopOnly: true,
    },
    // ── 2: Hexagon — behind diagram area, neutral ─────────────
    {
      shape:     'hexagon',
      sizeD:     300, sizeM: 150,
      getX:      (W, s) => W * 0.58 - s * 0.35,
      getY:      (H, s) => H * 0.22 - s * 0.15,
      opacity:   0.13,
      lineGap: 4.0, lineWidth: 0.40, light: 1.8, angle: 28,
      color:     '#D1D1CD',
      scrollFy: 0.013, scrollFx:  0.006,
      pointerFy: 0.002, pointerFx: 0.0015,
      desktopOnly: true,
    },
  ];

  // ── Internal state ─────────────────────────────────────────────
  interface RenderedLayer {
    def:       LayerDef;
    offCanvas: HTMLCanvasElement;
    baseX:     number;
    baseY:     number;
    size:      number;
  }

  const canvas = document.querySelector<HTMLCanvasElement>('.hero-bg')!;
  if (!canvas) throw new Error('HeroBackground: canvas not found');

  let ctx: CanvasRenderingContext2D | null = null;
  let W = 0, H = 0, isMobile = false;
  let scrollY = 0, pointerX = 0, pointerY = 0;
  let rafId: number | null = null;
  let rendered: RenderedLayer[] = [];
  const reduced = prefersReducedMotion();

  // ── Init canvas ────────────────────────────────────────────────
  function measure() {
    const hero = canvas.parentElement!;
    W = hero.offsetWidth  || window.innerWidth;
    H = hero.offsetHeight || Math.round(window.innerHeight * 0.88);
    isMobile = W < 768;
    canvas.width  = W;
    canvas.height = H;
    ctx = canvas.getContext('2d');
  }

  // ── Pre-render shapes to offscreen canvases ────────────────────
  function buildLayers() {
    rendered = [];
    for (const def of LAYERS) {
      if (def.desktopOnly && isMobile) continue;
      const size = isMobile ? def.sizeM : def.sizeD;
      const off  = document.createElement('canvas');
      drawHalftone(off, size, size, {
        shape:     def.shape,
        lineGap:   def.lineGap,
        lineWidth: def.lineWidth,
        light:     def.light,
        angle:     def.angle,
        color:     def.color,
      });
      rendered.push({
        def,
        offCanvas: off,
        baseX: def.getX(W, size),
        baseY: def.getY(H, size),
        size,
      });
    }
  }

  // ── Composite onto main canvas ─────────────────────────────────
  function render() {
    if (!ctx) return;
    ctx.clearRect(0, 0, W, H);
    for (const r of rendered) {
      const tx = r.baseX + scrollY * r.def.scrollFx + pointerX * r.def.pointerFx;
      const ty = r.baseY + scrollY * r.def.scrollFy + pointerY * r.def.pointerFy;
      ctx.globalAlpha = r.def.opacity;
      ctx.drawImage(r.offCanvas, tx, ty, r.size, r.size);
    }
    ctx.globalAlpha = 1;
    rafId = null;
  }

  function schedule() {
    if (rafId || document.hidden) return;
    rafId = requestAnimationFrame(render);
  }

  // ── Scroll ─────────────────────────────────────────────────────
  let scrollHandler: (() => void) | null = null;
  if (!reduced) {
    scrollHandler = () => {
      scrollY = window.scrollY;
      schedule();
    };
    window.addEventListener('scroll', scrollHandler, { passive: true });
  }

  // ── Pointer (desktop only, precise pointer) ────────────────────
  let pointerHandler: ((e: PointerEvent) => void) | null = null;
  let leaveHandler:   (() => void)          | null = null;

  if (!reduced) {
    const hero = canvas.parentElement!;

    pointerHandler = (e: PointerEvent) => {
      if (isMobile || e.pointerType !== 'mouse') return;
      pointerX = e.clientX - W / 2;
      pointerY = e.clientY - H / 2;
      schedule();
    };

    leaveHandler = () => {
      pointerX = 0; pointerY = 0;
      schedule();
    };

    hero.addEventListener('pointermove', pointerHandler);
    hero.addEventListener('pointerleave', leaveHandler);
  }

  // ── Resize ─────────────────────────────────────────────────────
  let resizeTimer: ReturnType<typeof setTimeout> | null = null;
  const resizeObs = new ResizeObserver(() => {
    if (resizeTimer) clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      measure();
      buildLayers();
      render();
    }, 120);
  });
  resizeObs.observe(canvas.parentElement!);

  // ── Visibility ─────────────────────────────────────────────────
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) schedule();
  });

  // ── Bootstrap ─────────────────────────────────────────────────
  // Wait one rAF so the hero has layout dimensions
  requestAnimationFrame(() => {
    measure();
    buildLayers();
    render();
  });
</script>
