      msgs:[
        {day:'JUEVES'},
        {d:'out',tpl:1,t:'11:20',h:'<span class="tag">Aviso de su agencia</span>Buenas noticias: su carga fue <b>liberada</b>. ¿Coordinamos el retiro y el transporte a su bodega en Quilicura?'},
        {d:'in',t:'11:26',h:'Sí, por favor'},
        {d:'out',t:'11:26',h:'Listo. Un ejecutivo de transporte le escribe hoy con la cotización.'},
        {sys:'Oportunidad de transporte creada en el CRM'}
      ]
    }
  ];

  var chat=document.getElementById('chat'), stepsEl=document.getElementById('steps'), actorsEl=document.getElementById('actors');
  var bar=document.getElementById('bar'), playBtn=document.getElementById('play'), statusEl=document.getElementById('wa-status');
  var reduce=window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var cur=0, playing=!reduce, timers=[], tick=null, t0=0, DWELL=5200;

  SCENES.forEach(function(s,i){
    var b=document.createElement('button'); b.type='button'; b.className='step';
    b.innerHTML='<span class="k">0'+(i+1)+'</span>'+s.key;
    b.addEventListener('click',function(){go(i,true)}); stepsEl.appendChild(b);
  });

  function clear(){timers.forEach(clearTimeout);timers=[];if(tick){clearInterval(tick);tick=null}}
  function bubble(m){
    var el=document.createElement('div');
    if(m.day){el.className='day';el.textContent=m.day;return el}
    if(m.sys){el.className='sys';el.textContent=m.sys;return el}
    el.className='b '+m.d+(m.tpl?' tpl':'')+(m.file?' file':'');
    if(m.file){
      el.innerHTML='<div class="ic'+(m.img?' img':'')+'">'+m.file[0]+'</div><div><div class="fn">'+m.file[1]+'</div><div class="fs">'+m.file[2]+' · '+m.t+'</div></div>';
    } else {
      el.innerHTML=m.h+'<span class="tm">'+m.t+'</span>';
    }
    return el;
  }
  function scroll(){chat.scrollTop=chat.scrollHeight}
  function renderSide(s,i){
    document.getElementById('sc-when').textContent=s.when;
    document.getElementById('sc-title').textContent=s.title;
    document.getElementById('sc-text').textContent=s.text;
    document.getElementById('sc-pain').innerHTML='<b>RESUELVE</b><span>'+s.pain+'</span>';
    document.getElementById('sc-rule').innerHTML=s.rule;
    actorsEl.innerHTML='';
    s.actors.forEach(function(a,j){
      var d=document.createElement('div'); d.className='actor '+(a[2]?'':'idle');
      d.innerHTML='<div class="who"><i></i>'+a[0]+'</div><p>'+a[1]+'</p>';
      actorsEl.appendChild(d);
    });
    Array.prototype.forEach.call(stepsEl.children,function(b,j){
      b.setAttribute('aria-current',j===i?'true':'false'); b.classList.toggle('done',j<i);
    });
  }
  function lightActor(j){var a=actorsEl.children[j];if(a&&!a.classList.contains('idle'))a.classList.add('on')}
  function go(i,user){
    clear(); cur=(i+SCENES.length)%SCENES.length; var s=SCENES[cur];
    renderSide(s,cur);
    chat.innerHTML=''; bar.style.width='0%';
    if(!playing||reduce){
      s.msgs.forEach(function(m){chat.appendChild(bubble(m))});
      Array.prototype.forEach.call(actorsEl.children,function(a,j){lightActor(j)});
      statusEl.textContent='cuenta de empresa · en línea'; scroll(); return;
    }
    var t=200, ai=0;
    s.msgs.forEach(function(m){
      if(m.d==='out' && !m.file){
        timers.push(setTimeout(function(){statusEl.textContent='escribiendo…';var ty=document.createElement('div');ty.className='typing';ty.id='ty';ty.innerHTML='<span></span><span></span><span></span>';chat.appendChild(ty);scroll()},t));
        t+=1100;
      }
      timers.push(setTimeout(function(){var ty=document.getElementById('ty');if(ty)ty.remove();statusEl.textContent='cuenta de empresa · en línea';chat.appendChild(bubble(m));scroll();lightActor(ai%4);ai++},t));
      t+= m.day?350:(m.sys?900:1300);
    });
    var total=t+DWELL; t0=Date.now();
    tick=setInterval(function(){var p=Math.min(1,(Date.now()-t0)/total);bar.style.width=(p*100)+'%'},120);
    timers.push(setTimeout(function(){go(cur+1)},total));
  }
  document.getElementById('prev').addEventListener('click',function(){go(cur-1,true)});
  document.getElementById('next').addEventListener('click',function(){go(cur+1,true)});
  playBtn.addEventListener('click',function(){
    playing=!playing; playBtn.textContent=playing?'Pausar':'Reproducir';
    if(playing){go(cur)} else {clear();bar.style.width='0%';go(cur)}
  });
  if(reduce){playBtn.textContent='Reproducir';playing=false}

  // Escena 1 visible desde el inicio; la animación parte cuando el caso entra en pantalla.
  renderSide(SCENES[0],0);
  Array.prototype.forEach.call(actorsEl.children,function(a,j){lightActor(j)});
  var started=false;
  function start(){if(started||!playing)return;started=true;go(0)}
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){start();io.disconnect()}})},{threshold:.35});
    io.observe(document.querySelector('.stage'));
  } else { start() }
})();
</script>
<script is:inline>
document.addEventListener('click',function(e){var a=e.target.closest&&e.target.closest('[data-track]');if(!a)return;
if(typeof window.gtag==='function'){window.gtag('event',a.getAttribute('data-track'),{page_path:location.pathname,placement:(a.closest('section')||{}).id||'header'})}});
</script>
</body>
</html>
