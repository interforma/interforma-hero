---
// Landing vertical: Interforma Agents para agencias de aduana.
// Página autocontenida (sin Base.astro) porque es una pieza comercial con identidad propia,
// enlazada desde el PDF descargable en /descargas. Eventos GA4: download_pdf, click_agendar,
// click_whatsapp, click_email (objetivo: reunión agendada; KPI: clics a Cal.com y WhatsApp).
const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID?.trim();
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Agente WhatsApp para agencias de aduana',
  serviceType: 'Agente de IA para atención por WhatsApp',
  provider: { '@type': 'Organization', name: 'Interforma', url: 'https://interforma.digital' },
  areaServed: 'CL',
  audience: { '@type': 'BusinessAudience', audienceType: 'Agencias de aduana y empresas de gestión de carga' },
  url: 'https://interforma.digital/agentes/aduanas',
  description: 'Agente en el WhatsApp de la agencia que informa el estado de cada operación, reúne documentos, comunica la provisión de fondos y avisa del aforo, con aprobación humana para montos y plazos.',
};
export const prerender = true;
---
<!DOCTYPE html>
<html lang="es-CL">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Agente WhatsApp para agencias de aduana</title>
<link rel="canonical" href="https://interforma.digital/agentes/aduanas">
<meta property="og:title" content="Agente WhatsApp para agencias de aduana · Interforma">
<meta property="og:url" content="https://interforma.digital/agentes/aduanas">
<meta name="description" content="Interforma Agents para agencias de aduana: estado de la carga, documentos, provisión de fondos y avisos de aforo por WhatsApp, con su equipo al mando.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
<style is:global>
:root{
  /* Sistema Interforma 2026: piedra clara, umbra, un solo naranja Energía.
     Idea de layout: el dolor primero, luego un teléfono que cuenta una importación de punta a punta. */
  --paper:#E4E3DF; --white:#F2F1EE; --ink:#281F18; --stone:#BEB8AE; --sky:#CCE2ED;
  --energia:#EE6E43; --energia-600:#D9582E; --primary-50:#FBE6DC; --primary-100:#F7CDBB; --primary-500:#9A3D1A; --primary-600:#7A2F13;
  --gray-100:#DCD9D3; --gray-200:#D0CCC4; --gray-400:#8F887E; --gray-500:#5C564E;
  --ok:#18794E; --ok-bg:#EFFAF6; --warn:#8A5A00; --warn-bg:#FFF6E0; --crit:#B3261E; --crit-bg:#FDEDEC;
  --wa:#DCF3D3; --wa-bg:#EFEAE2;
  --f-display:Outfit, system-ui, sans-serif; --f-body:Manrope, -apple-system, "Segoe UI", sans-serif; --f-mono:"JetBrains Mono", ui-monospace, Menlo, monospace;
  color-scheme:light;
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--paper);color:var(--ink);font-family:var(--f-body);font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:var(--primary-500)}
a:focus-visible,button:focus-visible{outline:3px solid var(--primary-500);outline-offset:3px;border-radius:6px}
h1,h2,h3{font-family:var(--f-display);font-weight:500;margin:0;text-wrap:balance;letter-spacing:-.025em}
p{margin:0}
.wrap{max-width:1180px;margin:0 auto;padding:0 28px}
.eyebrow{font-family:var(--f-mono);font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--primary-500)}
.eyebrow.muted{color:var(--gray-500)}
.lead{font-size:20px;line-height:1.55;color:var(--gray-500);max-width:620px}
section{padding:88px 0}
.sec-head{display:flex;flex-direction:column;gap:14px;margin-bottom:44px;max-width:780px}
.sec-head h2{font-size:clamp(32px,4.2vw,48px);line-height:1.08}

/* Nav */
.nav{position:sticky;top:0;z-index:20;background:rgba(228,227,223,.86);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--gray-200)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:64px;gap:16px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink)}
.brand span{font-family:var(--f-display);font-weight:500;font-size:22px;letter-spacing:-.02em}
.brand small{font-family:var(--f-mono);font-size:11px;letter-spacing:.08em;color:var(--gray-500);text-transform:uppercase;margin-left:6px}
.btn{display:inline-flex;align-items:center;gap:10px;font-family:var(--f-body);font-weight:600;font-size:16px;text-decoration:none;border-radius:28px;padding:13px 22px;border:1px solid transparent;cursor:pointer;transition:background .2s,transform .2s}
.btn:hover{transform:translateY(-1px)}
.btn-primary{background:var(--energia);color:var(--ink)}
.btn-primary:hover{background:#F2906D}
.btn-dark{background:var(--ink);color:var(--white)}
.btn-ghost{background:transparent;color:var(--ink);border-color:var(--ink)}
.btn-sm{padding:9px 16px;font-size:14px}

/* Hero */
.hero{padding:72px 0 64px}
.hero .wrap{display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:center}
.hero h1{font-size:clamp(38px,5.4vw,64px);line-height:1.04;letter-spacing:-.035em;margin:18px 0 22px}
.hero h1 em{font-style:normal;color:var(--primary-500)}
.hero .ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
.hero-meta{display:flex;flex-wrap:wrap;gap:8px 22px;margin-top:28px;font-family:var(--f-mono);font-size:12.5px;color:var(--gray-500);letter-spacing:.04em}

/* Hero: bandeja saturada */
.inbox{background:var(--white);border:1px solid var(--gray-200);border-radius:20px;padding:18px;position:relative;overflow:hidden}
.inbox-head{display:flex;justify-content:space-between;align-items:center;font-family:var(--f-mono);font-size:12px;color:var(--gray-500);letter-spacing:.06em;text-transform:uppercase;padding:4px 4px 14px;border-bottom:1px solid var(--gray-100)}
.inbox-head b{font-family:var(--f-body);font-size:13px;letter-spacing:0;text-transform:none;background:var(--crit-bg);color:var(--crit);border-radius:13px;padding:2px 10px;font-weight:600}
.inbox ul{list-style:none;margin:0;padding:6px 0 0;display:flex;flex-direction:column}
.inbox li{display:grid;grid-template-columns:36px 1fr auto;gap:12px;align-items:center;padding:11px 4px;border-bottom:1px solid var(--gray-100);animation:slidein .6s ease both}
.inbox li:nth-child(1){animation-delay:.1s}.inbox li:nth-child(2){animation-delay:.5s}.inbox li:nth-child(3){animation-delay:.9s}.inbox li:nth-child(4){animation-delay:1.3s}.inbox li:nth-child(5){animation-delay:1.7s}.inbox li:nth-child(6){animation-delay:2.1s}
.av{width:36px;height:36px;border-radius:50%;background:var(--paper);display:grid;place-items:center;font-family:var(--f-display);font-size:15px;color:var(--gray-500)}
.inbox .who{font-weight:600;font-size:14.5px;line-height:1.3}
.inbox .msg{font-size:14px;color:var(--gray-500);line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.inbox .t{font-family:var(--f-mono);font-size:11.5px;color:var(--gray-500);text-align:right}
.inbox .t i{display:block;margin-top:4px;margin-left:auto;width:20px;height:20px;border-radius:50%;background:var(--energia);color:var(--ink);font-style:normal;font-size:11px;line-height:20px;text-align:center;font-family:var(--f-body);font-weight:700}
.inbox-foot{margin-top:14px;padding:12px 14px;background:var(--primary-50);border-radius:12px;font-size:14px;line-height:1.45}
@keyframes slidein{from{opacity:.0;transform:translateY(-8px)}to{opacity:1;transform:none}}

/* Dolores */
.pains{display:grid;grid-template-columns:repeat(6,1fr);gap:18px}
.pain{grid-column:span 2;background:var(--white);border:1px solid var(--gray-200);border-radius:16px;padding:28px;display:flex;flex-direction:column;gap:12px}
.pain:nth-child(4),.pain:nth-child(5){grid-column:span 3}
.pain .n{font-family:var(--f-mono);font-size:12.5px;color:var(--primary-500);letter-spacing:.08em}
.pain h3{font-size:24px;line-height:1.18}
.pain p{color:var(--gray-500);font-size:16px;line-height:1.55}
.pain .cost{margin-top:auto;padding-top:14px;border-top:1px solid var(--gray-100);font-size:14.5px;line-height:1.45;color:var(--ink)}
.pain .cost b{font-family:var(--f-mono);font-weight:400;font-size:11.5px;letter-spacing:.08em;color:var(--crit);display:block;margin-bottom:2px}

/* Caso */
.case{background:var(--ink);color:var(--white)}
.case .eyebrow{color:var(--energia)}
.case .sec-head h2{color:var(--white)}
.case .lead{color:var(--stone)}
.steps{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px}
.step{font-family:var(--f-body);background:transparent;color:var(--stone);border:1px solid #4a4038;border-radius:13px;padding:9px 14px;font-size:14px;cursor:pointer;display:flex;gap:10px;align-items:center;transition:all .25s}
.step .k{font-family:var(--f-mono);font-size:11.5px;color:var(--gray-400)}
.step[aria-current="true"]{background:var(--energia);color:var(--ink);border-color:var(--energia)}
.step[aria-current="true"] .k{color:var(--ink)}
.step.done{color:var(--white);border-color:#6b5f55}
.stage{display:grid;grid-template-columns:400px 1fr;gap:48px;align-items:start}

.phone{background:#1a140f;border-radius:44px;padding:12px;box-shadow:0 30px 60px -20px rgba(0,0,0,.6);width:100%;max-width:400px;margin:0 auto}
.screen{background:var(--wa-bg);border-radius:34px;overflow:hidden;height:640px;display:flex;flex-direction:column}
.wa-top{background:#F7F5F1;color:var(--ink);display:flex;align-items:center;gap:10px;padding:16px 16px 12px;border-bottom:1px solid var(--gray-100)}
.wa-top .pic{width:38px;height:38px;border-radius:50%;background:var(--ink);display:grid;place-items:center;flex:none}
.wa-top .nm{font-weight:700;font-size:15px;line-height:1.2}
.wa-top .st{font-size:12px;color:var(--gray-500)}
.chat{flex:1;overflow-y:auto;padding:14px 12px 18px;display:flex;flex-direction:column;gap:6px;scroll-behavior:smooth}
.day{align-self:center;background:#F7F5F1;color:var(--gray-500);font-size:11.5px;font-family:var(--f-mono);padding:4px 10px;border-radius:8px;margin:6px 0 4px;letter-spacing:.04em}
.b{max-width:84%;padding:8px 11px 6px;border-radius:12px;font-size:14.5px;line-height:1.42;color:#1d1712;position:relative;animation:pop .35s ease both;box-shadow:0 1px 1px rgba(40,31,24,.08)}
.b .tm{display:block;text-align:right;font-size:10.5px;color:var(--gray-500);margin-top:2px;font-family:var(--f-mono)}
.b.in{align-self:flex-start;background:#fff;border-top-left-radius:4px}
.b.out{align-self:flex-end;background:var(--wa);border-top-right-radius:4px}
.b.tpl{border-left:3px solid var(--energia)}
.b .tag{display:block;font-family:var(--f-mono);font-size:10.5px;letter-spacing:.06em;color:var(--primary-500);margin-bottom:3px;text-transform:uppercase}
.b.file{display:flex;gap:10px;align-items:center}
.b.file .ic{width:34px;height:40px;border-radius:5px;background:var(--crit);color:#fff;font-size:10px;font-weight:700;display:grid;place-items:center;flex:none;font-family:var(--f-mono)}
.b.file .ic.img{background:var(--sky);color:var(--ink)}
.b.file .fn{font-weight:600;font-size:13.5px;line-height:1.3}
.b.file .fs{font-size:11.5px;color:var(--gray-500)}
.check{margin-top:6px;display:flex;flex-direction:column;gap:5px;font-size:13.5px}
.check div{display:flex;justify-content:space-between;gap:10px;align-items:center}
.pill{font-size:11px;font-weight:700;border-radius:13px;padding:1px 8px;white-space:nowrap}
.pill.ok{background:var(--ok-bg);color:var(--ok)}
.pill.no{background:var(--warn-bg);color:var(--warn)}
.money{margin-top:6px;background:#fff;border:1px solid var(--gray-200);border-radius:10px;padding:10px 12px;font-size:13.5px}
.money .row{display:flex;justify-content:space-between;gap:12px;font-variant-numeric:tabular-nums}
.money .row.tot{border-top:1px solid var(--gray-200);margin-top:6px;padding-top:6px;font-weight:700}
.money .note{font-size:11px;color:var(--gray-500);margin-top:6px;font-family:var(--f-mono)}
.wa-btn{margin-top:6px;text-align:center;color:#1f7a5a;font-weight:600;font-size:13.5px;border-top:1px solid rgba(40,31,24,.1);padding-top:6px}
.typing{align-self:flex-start;background:#fff;border-radius:12px;border-top-left-radius:4px;padding:10px 14px;display:flex;gap:4px;animation:pop .25s ease both}
.typing span{width:7px;height:7px;border-radius:50%;background:var(--gray-400);animation:dot 1s infinite}
.typing span:nth-child(2){animation-delay:.15s}.typing span:nth-child(3){animation-delay:.3s}
.sys{align-self:center;background:var(--primary-50);color:var(--primary-600);font-size:12px;padding:5px 10px;border-radius:8px;font-weight:600;animation:pop .35s ease both;text-align:center}
@keyframes pop{from{opacity:0;transform:translateY(6px) scale(.98)}to{opacity:1;transform:none}}
@keyframes dot{0%,60%,100%{transform:none;opacity:.5}30%{transform:translateY(-4px);opacity:1}}
.wa-input{background:#F7F5F1;padding:10px 12px;display:flex;gap:8px;align-items:center;border-top:1px solid var(--gray-100)}
.wa-input div{flex:1;background:#fff;border-radius:20px;padding:8px 14px;font-size:13px;color:var(--gray-400)}
.wa-input i{width:36px;height:36px;border-radius:50%;background:#1f7a5a;flex:none}

.inside{display:flex;flex-direction:column;gap:22px}
.scene-head{display:flex;flex-direction:column;gap:10px}
.scene-head .when{font-family:var(--f-mono);font-size:13px;color:var(--energia);letter-spacing:.06em;text-transform:uppercase}
.scene-head h3{font-size:clamp(26px,3vw,36px);line-height:1.12;color:var(--white)}
.scene-head p{color:var(--stone);font-size:17px;max-width:560px}
.pain-tag{display:inline-flex;align-self:flex-start;gap:8px;align-items:center;background:#3a2f26;border:1px solid #54473c;border-radius:13px;padding:5px 12px;font-size:13.5px;color:var(--white)}
.pain-tag b{font-family:var(--f-mono);font-weight:400;font-size:11px;color:var(--energia);letter-spacing:.08em}
.actors{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.actor{background:#33291f;border:1px solid #4a4038;border-radius:14px;padding:16px 18px;display:flex;flex-direction:column;gap:6px;transition:border-color .3s,background .3s}
.actor .who{font-family:var(--f-mono);font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--gray-400);display:flex;align-items:center;gap:8px}
.actor .who i{width:8px;height:8px;border-radius:2px;background:var(--gray-400)}
.actor p{font-size:15px;line-height:1.45;color:var(--white)}
.actor.on{border-color:var(--energia);background:#3b2e24}
.actor.on .who{color:var(--energia)}
.actor.on .who i{background:var(--energia);border-radius:50%}
.actor.idle p{color:var(--gray-400)}
.rule{border-left:3px solid var(--energia);padding:4px 0 4px 16px;color:var(--stone);font-size:15.5px}
.rule b{color:var(--white);font-weight:600}
.controls{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.ctrl{font-family:var(--f-body);font-weight:600;font-size:14px;background:transparent;color:var(--white);border:1px solid #6b5f55;border-radius:11px;padding:9px 16px;cursor:pointer}
.ctrl:hover{border-color:var(--white)}
.ctrl.main{background:var(--white);color:var(--ink);border-color:var(--white)}
.prog{flex:1;min-width:120px;height:4px;background:#4a4038;border-radius:2px;overflow:hidden}
.prog i{display:block;height:100%;width:0;background:var(--energia);transition:width .2s linear}
.fict{font-family:var(--f-mono);font-size:11.5px;color:var(--gray-400);letter-spacing:.04em}

/* Antes / después */
.compare{width:100%;border-collapse:collapse;background:var(--white);font-size:16px}
.compare th{font-family:var(--f-mono);font-weight:400;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--gray-500);text-align:left;padding:16px 22px;border-bottom:1px solid var(--gray-200)}
.compare th:last-child{color:var(--primary-500)}
.compare td{padding:18px 22px;border-bottom:1px solid var(--gray-200);vertical-align:top;line-height:1.5}
.compare td:first-child{font-weight:600;width:22%}
.compare td:nth-child(2){color:var(--gray-500);width:36%}
.compare tr:last-child td{border-bottom:0}
.tbl{overflow-x:auto;border:1px solid var(--gray-200)}

/* Reglas */
.cards3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card{background:var(--white);border:1px solid var(--gray-200);border-radius:16px;padding:28px;display:flex;flex-direction:column;gap:12px}
.card h3{font-size:22px;line-height:1.2}
.card p{color:var(--gray-500);font-size:16px}
.card.hl{background:var(--sky);border-color:var(--sky)}
.card.hl p{color:var(--ink)}

/* Piloto */
.pilot{display:grid;grid-template-columns:1fr 1.2fr;gap:56px;align-items:start}
.mods{display:flex;flex-direction:column}
.mod{display:grid;grid-template-columns:64px 1fr;gap:20px;padding:22px 0;border-top:1px solid var(--gray-200);align-items:start}
.mod:last-child{border-bottom:1px solid var(--gray-200)}
.mod .sh{width:52px;height:52px;background:var(--ink)}
.mod h3{font-size:22px;margin-bottom:4px}
.mod p{color:var(--gray-500);font-size:16px}
.gate{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:22px}
.gate div{border-radius:12px;padding:16px;font-size:14.5px;line-height:1.45;background:var(--white);border:1px solid var(--gray-200)}
.gate b{display:block;font-family:var(--f-display);font-weight:500;font-size:19px;margin-bottom:4px}

/* Referencia */
.ref{background:var(--white);border-top:1px solid var(--gray-200);border-bottom:1px solid var(--gray-200);padding:56px 0}
.ref .wrap{display:grid;grid-template-columns:auto 1fr auto;gap:40px;align-items:center}
.ref h3{font-size:clamp(24px,2.6vw,32px);line-height:1.2}
.ref p{color:var(--gray-500);margin-top:8px;max-width:640px}

/* CTA */
.cta{background:var(--energia);color:var(--ink);padding:96px 0}
.cta .wrap{display:grid;grid-template-columns:1fr auto;gap:48px;align-items:center}
.cta h2{font-size:clamp(38px,5.4vw,68px);line-height:1.02;letter-spacing:-.035em}
.cta .ctas{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}
.cta .btn-ghost{background:var(--white);border-color:var(--white)}
.contacts{display:grid;grid-template-columns:repeat(4,auto);justify-content:start;gap:16px 44px;margin-top:40px}
.contacts span{display:block;font-family:var(--f-mono);font-size:11.5px;letter-spacing:.08em;color:var(--primary-900,#4A1C0B)}
.contacts a{color:var(--ink);font-weight:600;text-decoration:none;border-bottom:1px solid rgba(40,31,24,.35)}
.punto{width:220px;height:220px}
.punto .body{animation:bob 3.2s ease-in-out infinite}
.punto .eyes{transform-box:fill-box;transform-origin:center;animation:blink 4.6s linear infinite}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
@keyframes blink{0%,90%,100%{transform:scaleY(1)}93%{transform:scaleY(.08)}96%{transform:scaleY(1)}}

footer{background:var(--ink);color:var(--stone);padding:28px 0;font-family:var(--f-mono);font-size:12.5px;letter-spacing:.04em}
footer .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
footer a{color:var(--stone)}

@media (max-width:980px){
  .hero .wrap,.stage,.pilot,.cta .wrap{grid-template-columns:1fr}
  .pains{grid-template-columns:1fr 1fr}
  .pain,.pain:nth-child(4),.pain:nth-child(5){grid-column:span 1}
  .pain:nth-child(5){grid-column:span 2}
  .cards3{grid-template-columns:1fr}
  .ref .wrap{grid-template-columns:1fr}
  .contacts{grid-template-columns:1fr 1fr}
  .punto{display:none}
}
@media (max-width:600px){
  section{padding:64px 0}
  .wrap{padding:0 18px}
  .pains{grid-template-columns:1fr}
  .pain:nth-child(5){grid-column:span 1}
  .actors{grid-template-columns:1fr}
  .gate{grid-template-columns:1fr}
  .contacts{grid-template-columns:1fr}
  .screen{height:560px}
  .brand small{display:none}
  .nav .btn{display:none}
  .compare td:first-child{width:auto}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
}
</style>
