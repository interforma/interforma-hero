  @media (min-width: 1024px) {
    html { scroll-padding-top: calc(var(--header-height, 76px) + 48px); }
  }
  .report {
    --report-container: 1280px;
    --report-gutter: 20px;
  }
  @media (min-width: 768px) { .report { --report-gutter: 32px; } }
