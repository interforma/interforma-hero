    transition: opacity 500ms var(--ease-default, cubic-bezier(0.16, 1, 0.3, 1)),
                transform 500ms var(--ease-default, cubic-bezier(0.16, 1, 0.3, 1));
  }
  @media (prefers-reduced-motion: reduce) {
