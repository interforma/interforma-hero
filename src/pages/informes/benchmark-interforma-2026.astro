</style>

<script>
  /* ═══════════════════════════════════════════
     INTERACTIVITY — Vanilla JS
     ═══════════════════════════════════════════ */

  // ── Mobile nav toggle ──
  const navToggle = document.getElementById('nav-toggle') as HTMLButtonElement;
  const navLinksContainer = document.getElementById('nav-links') as HTMLDivElement;
  const navToggleLabel = document.getElementById('nav-toggle-label') as HTMLSpanElement;

  navToggle?.addEventListener('click', () => {
    const isOpen = navToggle.getAttribute('aria-expanded') === 'true';
    navToggle.setAttribute('aria-expanded', String(!isOpen));
    navLinksContainer.classList.toggle('is-open', !isOpen);
  });

  // ── Scroll-based section nav highlighting + progress ──
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const sectionEls = document.querySelectorAll<HTMLElement>('.report__section');
  const progressBar = document.getElementById('progress-bar') as HTMLDivElement;

  function updateActiveNav() {
    const scrollY = window.scrollY + 160;
    let currentId = '';
    let currentLabel = 'Resumen';

    sectionEls.forEach(section => {
      if (section.offsetTop <= scrollY) {
        currentId = section.id;
      }
    });

    navLinks.forEach(link => {
      const isActive = link.dataset.navLink === currentId;
      link.classList.toggle('is-active', isActive);
      if (isActive) currentLabel = link.textContent || currentLabel;
    });

    // Update mobile toggle label
    if (navToggleLabel) navToggleLabel.textContent = currentLabel;

    // Update progress bar
    if (progressBar) {
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (window.scrollY / docHeight) * 100 : 0;
      progressBar.style.width = `${Math.min(progress, 100)}%`;
    }
  }

  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        updateActiveNav();
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });
  updateActiveNav();

  // ── Smooth scroll for nav links ──
  navLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const target = document.getElementById(link.dataset.navLink || '');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      // Close mobile nav after click
      navToggle?.setAttribute('aria-expanded', 'false');
      navLinksContainer?.classList.remove('is-open');
    });
  });

  // ── Competitor filter ──
  const competitorFilters = document.querySelectorAll<HTMLButtonElement>('#competitor-filters .filter-btn');
  const competitorRows = document.querySelectorAll<HTMLTableRowElement>('#competitors-table tbody tr');

  competitorFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      competitorFilters.forEach(b => b.classList.remove('filter-btn--active'));
      btn.classList.add('filter-btn--active');

      const filter = btn.dataset.filter;
      competitorRows.forEach(row => {
        if (filter === 'all' || row.dataset.grupo === filter) {
          row.classList.remove('is-hidden');
        } else {
          row.classList.add('is-hidden');
        }
      });
    });
  });

  // ── Action plan filter ──
  const actionFilters = document.querySelectorAll<HTMLButtonElement>('#action-filters .filter-btn');
  const actionRows = document.querySelectorAll<HTMLTableRowElement>('#actions-table tbody tr');

  actionFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      actionFilters.forEach(b => b.classList.remove('filter-btn--active'));
      btn.classList.add('filter-btn--active');

      const filter = btn.dataset.actionFilter;
      actionRows.forEach(row => {
        if (filter === 'all' || row.dataset.horizon === filter) {
          row.classList.remove('is-hidden');
        } else {
          row.classList.add('is-hidden');
        }
      });
    });
  });

  // ── Table sorting ──
  document.querySelectorAll<HTMLTableElement>('.data-table').forEach(table => {
    const headers = table.querySelectorAll<HTMLTableCellElement>('th[data-sort]');
    const tbody = table.querySelector('tbody');
    if (!tbody) return;

    headers.forEach((header, colIndex) => {
      let ascending = true;

      header.addEventListener('click', () => {
        const rows = Array.from(tbody.querySelectorAll('tr'));
        const key = header.dataset.sort || '';
        const isNumeric = ['posic', 'web', 'crm', 'casos', 'comercial', 'indice'].includes(key);

        // Find actual column index
        const allHeaders = Array.from(table.querySelectorAll('th'));
        const actualIndex = allHeaders.indexOf(header);

        rows.sort((a, b) => {
          const aText = a.cells[actualIndex]?.textContent?.trim() || '';
          const bText = b.cells[actualIndex]?.textContent?.trim() || '';

          if (isNumeric) {
            const aNum = parseFloat(aText) || 0;
            const bNum = parseFloat(bText) || 0;
            return ascending ? aNum - bNum : bNum - aNum;
          }
          return ascending
            ? aText.localeCompare(bText, 'es')
            : bText.localeCompare(aText, 'es');
        });

        rows.forEach(row => tbody.appendChild(row));
        ascending = !ascending;
      });
    });
  });

  // ── Intersection observer for fade-up ──
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );

    document.querySelectorAll('[data-animate]').forEach(el => observer.observe(el));
  } else {
    document.querySelectorAll('[data-animate]').forEach(el => el.classList.add('is-visible'));
  }
</script>
