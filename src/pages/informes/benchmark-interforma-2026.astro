---
import Base from '@layouts/Base.astro';
import Eyebrow from '@components/base/Eyebrow.astro';
import SectionHeading from '@components/base/SectionHeading.astro';

const title = 'Benchmark competitivo Interforma — Chile 2026';
const description = 'Análisis exploratorio de información pública: posicionamiento, servicios, tecnología, casos y precios de 13 empresas chilenas y 3 referencias internacionales.';

/* ── Competitors data ── */
const competitors = [
  { empresa: 'Redsoft', url: 'https://redsoftchile.cl/', especializacion: 'Marketing, SEO, anuncios, CRM, IA e integraciones', lectura: 'Documentar conexión entre captación y resultados comerciales', grupo: 'integral' },
  { empresa: 'Quolab', url: 'https://quolab.cl/', especializacion: 'Web, WordPress, n8n, WhatsApp API, OpenAI, campañas', lectura: 'Diferenciar diagnóstico, rediseño de procesos y adopción', grupo: 'integral' },
  { empresa: 'Z Digital', url: 'https://zdigital.cl/', especializacion: 'Growth, BI, marketing, CRM y automatización', lectura: 'Destacar KPIs e impacto del CRM y los datos', grupo: 'integral' },
  { empresa: 'Consultores Raise', url: 'https://consultoresraise.com/', especializacion: 'Desarrollo web, SaaS, Make, n8n, SEO/GEO', lectura: 'Mostrar casos y objetivos cuantificados', grupo: 'integral' },
  { empresa: 'LADO DIGITAL', url: 'https://agencialadodigital.com/', especializacion: 'Web, marketing, sistemas, automatización, agentes', lectura: 'Simplificar productos y contratación', grupo: 'integral' },
  { empresa: 'Hi Agencia', url: 'https://hiagencia.com/', especializacion: 'n8n, Chatwoot, WhatsApp, CRM y agentes de IA', lectura: 'Traducir proyectos técnicos a historias comerciales', grupo: 'automatizacion' },
  { empresa: 'FutureFlow', url: 'https://www.futureflow.cl/', especializacion: 'Consultoría, IA, automatización, web', lectura: 'Reforzar experiencia sectorial', grupo: 'automatizacion' },
  { empresa: 'AIntelligence', url: 'https://aintelligence.cl/', especializacion: 'Software, Python, PostgreSQL, Docker, AWS, n8n, CRM', lectura: 'Comunicar arquitectura y seguridad accesiblemente', grupo: 'automatizacion' },
  { empresa: 'SURMET', url: 'https://www.surmet.cl/', especializacion: 'n8n, Odoo, Shopify, AWS, servidores y agentes IA', lectura: 'Destacar continuidad operacional y privacidad', grupo: 'automatizacion' },
  { empresa: 'YAGO', url: 'https://yago.cl/', especializacion: 'APIs, OCR, RPA, IA, agentes, productos verticales', lectura: 'Construir soluciones sectoriales reutilizables', grupo: 'automatizacion' },
  { empresa: 'Digitals', url: 'https://digitals.cl/', especializacion: 'Marketing, datos, CRM con IA y automatización', lectura: 'Reforzar contenidos y activos propios', grupo: 'datos' },
  { empresa: 'Artifact', url: 'https://www.artifact.cl/about', especializacion: 'Web, marketing, n8n, WhatsApp, Chatwoot', lectura: 'Ofrecer entrada comercial sin competir solo por precio', grupo: 'datos' },
  { empresa: 'Vulkca', url: 'https://www.vulkca.com/', especializacion: 'Next.js, Supabase, CRM, agentes IA, SEO/GEO', lectura: 'Publicar tecnología, alcance y casos claramente', grupo: 'tech' },
];

/* ── Documentation matrix ── */
const matrix = [
  { empresa: 'Vulkca', posic: 2, web: 2, crm: 2, casos: 2, comercial: 2, indice: 100 },
  { empresa: 'YAGO', posic: 2, web: 1, crm: 2, casos: 2, comercial: 2, indice: 95 },
  { empresa: 'Interforma', posic: 2, web: 2, crm: 2, casos: 2, comercial: 1, indice: 92.5 },
  { empresa: 'Consultores Raise', posic: 2, web: 2, crm: 2, casos: 2, comercial: 1, indice: 92.5 },
  { empresa: 'LADO DIGITAL', posic: 2, web: 2, crm: 2, casos: 1, comercial: 2, indice: 87.5 },
  { empresa: 'Quolab', posic: 2, web: 2, crm: 2, casos: 1, comercial: 1, indice: 80 },
  { empresa: 'Hi Agencia', posic: 2, web: 1, crm: 2, casos: 2, comercial: 0, indice: 80 },
  { empresa: 'Digitals', posic: 2, web: 2, crm: 1, casos: 2, comercial: 0, indice: 75 },
  { empresa: 'Redsoft', posic: 2, web: 2, crm: 2, casos: 1, comercial: 0, indice: 72.5 },
  { empresa: 'FutureFlow', posic: 2, web: 1, crm: 2, casos: 1, comercial: 0, indice: 67.5 },
  { empresa: 'Artifact', posic: 1, web: 2, crm: 2, casos: 0, comercial: 2, indice: 65 },
  { empresa: 'Z Digital', posic: 2, web: 2, crm: 1, casos: 1, comercial: 0, indice: 62.5 },
  { empresa: 'AIntelligence', posic: 2, web: 1, crm: 2, casos: 0, comercial: 0, indice: 55 },
  { empresa: 'SURMET', posic: 2, web: 0, crm: 2, casos: 0, comercial: 0, indice: 40 },
];

/* ── Prices ── */
const prices = [
  { empresa: 'Artifact', precio: 'Web desde $150.000 CLP', notas: 'Precio de entrada, no proyecto comparable' },
  { empresa: 'LADO DIGITAL', precio: 'Implementación desde $190.000 + IVA; operación mensual $250.000–$1.400.000 + IVA', notas: 'Distingue setup y continuidad' },
  { empresa: 'Vulkca', precio: 'Web desde $300.000; agente IA avanzado desde $400.000; mantenimiento bot desde $100.000/mes', notas: 'Ofertas con fecha 2025; verificar vigencia' },
  { empresa: 'YAGO', precio: 'SADT desde 31,80 UF/mes; AXIS desde 22,13 UF + IVA/mes', notas: 'Productos específicos, no desarrollo general' },
  { empresa: 'Consultores Raise', precio: 'Cotización después de diagnóstico', notas: 'No hay tarifa general' },
];

/* ── International references ── */
const intl = [
  { empresa: 'Aptitude 8', url: 'https://aptitude8.com/', aprender: 'CRM, Revenue Operations, integraciones, casos con resultados' },
  { empresa: 'SmartBug Media', url: 'https://www.smartbugmedia.com/', aprender: 'Marketing + CRM + servicios recurrentes + verticalización' },
  { empresa: 'DEPT', url: 'https://www.dept.global/', aprender: 'Narrativa de transformación digital y experiencias' },
];

/* ── Action plan ── */
const actions = [
  { n: 1, iniciativa: 'Estandarizar casos de éxito con KPIs antes/después', impacto: 'Muy alto', esfuerzo: 'Medio', horizonte: '0–30 días' },
  { n: 2, iniciativa: 'Crear páginas comerciales por industria', impacto: 'Muy alto', esfuerzo: 'Medio', horizonte: '0–45 días' },
  { n: 3, iniciativa: 'Publicar oferta clara de piloto IA', impacto: 'Muy alto', esfuerzo: 'Bajo', horizonte: '0–30 días' },
  { n: 4, iniciativa: 'Definir planes de implementación y mantenimiento', impacto: 'Alto', esfuerzo: 'Bajo', horizonte: '0–30 días' },
  { n: 5, iniciativa: 'Diseñar oferta RevOps para empresas medianas', impacto: 'Muy alto', esfuerzo: 'Alto', horizonte: '30–90 días' },
  { n: 6, iniciativa: 'Crear soluciones reutilizables para logística y salud', impacto: 'Muy alto', esfuerzo: 'Alto', horizonte: '30–90 días' },
  { n: 7, iniciativa: 'Publicar contenidos SEO especializados', impacto: 'Alto', esfuerzo: 'Medio', horizonte: '30–90 días' },
  { n: 8, iniciativa: 'Desarrollar calculadora de retorno de automatización', impacto: 'Alto', esfuerzo: 'Medio', horizonte: '30–60 días' },
  { n: 9, iniciativa: 'Documentar seguridad, continuidad y gobernanza IA', impacto: 'Alto', esfuerzo: 'Medio', horizonte: '0–60 días' },
  { n: 10, iniciativa: 'Repetir benchmarking con histórico trimestral', impacto: 'Medio', esfuerzo: 'Medio', horizonte: '60–90 días' },
];

/* ── Sections nav ── */
const sections = [
  { id: 'resumen', label: 'Resumen' },
  { id: 'alcance', label: 'Alcance' },
  { id: 'competidores', label: 'Competidores' },
  { id: 'matriz', label: 'Matriz' },
  { id: 'precios', label: 'Precios' },
  { id: 'seo', label: 'SEO y visibilidad' },
  { id: 'internacionales', label: 'Internacionales' },
  { id: 'foda', label: 'FODA' },
  { id: 'plan', label: 'Plan de acción' },
  { id: 'recomendaciones', label: 'Recomendaciones' },
  { id: 'fuentes', label: 'Fuentes' },
  { id: 'notas', label: 'Notas metodológicas' },
];

const grupoLabels: Record<string, string> = {
  integral: 'Competencia integral',
  automatizacion: 'Especialistas en automatización',
  datos: 'Crecimiento y datos',
  tech: 'Desarrollo tecnológico con agentes/SEO para IA',
};

const grupoColors: Record<string, string> = {
  integral: 'var(--brand-500)',
  automatizacion: 'var(--color-neutral-200)',
  datos: 'var(--color-success-500)',
  tech: 'var(--brand-800)',
};
---

<Base title={title} description={description} noindex>

  <!-- ════════════════ STICKY NAV ════════════════ -->
  <nav class="report-nav" aria-label="Navegación del informe" id="report-nav">
    <button class="report-nav__toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-links">
      <span class="report-nav__toggle-label" id="nav-toggle-label">Resumen</span>
      <svg class="report-nav__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="report-nav__links" id="nav-links">
      {sections.map(s => (
        <a href={`#${s.id}`} class="report-nav__link" data-nav-link={s.id}>{s.label}</a>
      ))}
    </div>
    <div class="report-nav__progress" aria-hidden="true">
      <div class="report-nav__progress-bar" id="progress-bar"></div>
    </div>
  </nav>

  <div class="report">

    <!-- ════════════════ HEADER ════════════════ -->
    <header class="report__header">
      <div class="container">
        <Eyebrow variant="primary">Informe interno v1.0</Eyebrow>
        <SectionHeading size="xl" as="h1">
          Benchmark competitivo Interforma — Chile 2026
        </SectionHeading>
        <p class="report__meta">
          Versión 1.0 — 12 de noviembre de 2026
        </p>
        <div class="report__disclaimer">
          <svg class="report__icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zm0 3.5a.75.75 0 01.75.75v4a.75.75 0 01-1.5 0v-4A.75.75 0 0110 5.5zm0 8a.75.75 0 110-1.5.75.75 0 010 1.5z" fill="currentColor"/></svg>
          <p>
            <strong>Estado:</strong> análisis exploratorio de información pública. Esto no constituye una auditoría financiera, SEO cuantitativa ni técnica interna. La información proviene de una transferencia desde ChatGPT y ha sido revisada con juicio editorial.
          </p>
        </div>
      </div>
    </header>

    <!-- ════════════════ 1. RESUMEN EJECUTIVO ════════════════ -->
    <section id="resumen" class="report__section" data-animate>
      <div class="container">
        <Eyebrow variant="primary">01</Eyebrow>
        <SectionHeading size="lg" id="resumen-heading">Resumen ejecutivo</SectionHeading>

        <div class="summary-card">
          <h3 class="summary-card__title">Hallazgo principal</h3>
          <p>
            Interforma tiene una oferta transversal (estrategia, procesos, tecnología, automatización, IA) que otros proveedores chilenos también ofrecen. La oportunidad no está en listar más tecnologías, sino en demostrar cómo transforma procesos completos con resultados medibles.
          </p>
        </div>

        <div class="summary-card summary-card--accent">
          <h3 class="summary-card__title">Posicionamiento recomendado</h3>
          <p class="summary-card__quote">
            &laquo;Conectamos procesos, personas y tecnología para que su empresa funcione mejor.&raquo;
          </p>
        </div>

        <h3 class="report__h3">Tres prioridades inmediatas</h3>
        <ol class="priority-list">
          <li>
            <span class="priority-list__number">1</span>
            <span>Casos de éxito con métricas antes/después</span>
          </li>
          <li>
            <span class="priority-list__number">2</span>
            <span>Páginas comerciales por industria</span>
          </li>
          <li>
            <span class="priority-list__number">3</span>
            <span>Oferta clara de piloto para automatización e IA</span>
          </li>
        </ol>

        <h3 class="report__h3">Lo que Interforma ya publica</h3>
        <ul class="check-list">
          <li>Cinco capacidades declaradas</li>
          <li>Método de seis etapas</li>
          <li>Seis casos de éxito</li>
          <li>Especialización en salud, logística y servicios profesionales</li>
          <li>Piloto de agentes IA de 30 días</li>
        </ul>
      </div>
    </section>

    <!-- ════════════════ 2. ALCANCE Y METODOLOGÍA ════════════════ -->
    <section id="alcance" class="report__section report__section--alt" data-animate>
      <div class="container">
        <Eyebrow variant="muted">02</Eyebrow>
        <SectionHeading size="lg" id="alcance-heading">Alcance y metodología</SectionHeading>

        <div class="method-grid">
          <div class="method-card">
            <h3 class="method-card__title">Universo</h3>
            <p class="method-card__value">13 empresas chilenas + 3 referencias internacionales</p>
          </div>
          <div class="method-card">
            <h3 class="method-card__title">Dimensiones</h3>
            <p>Posicionamiento, servicios, tecnología declarada, CRM/automatización/IA, SEO/contenido visible, casos comerciales, precios publicados.</p>
          </div>
          <div class="method-card">
            <h3 class="method-card__title">Exclusiones</h3>
            <p>No se midieron: tráfico, posiciones orgánicas, tasa de conversión, inversión publicitaria, rentabilidad ni calidad de implementación.</p>
          </div>
          <div class="method-card">
            <h3 class="method-card__title">Tipos de evidencia</h3>
            <ul class="evidence-list">
              <li><span class="evidence-tag evidence-tag--a">A</span> Oferta declarada en sitio</li>
              <li><span class="evidence-tag evidence-tag--b">B</span> Caso publicado por el proveedor</li>
              <li><span class="evidence-tag evidence-tag--c">C</span> Interpretación estratégica</li>
              <li><span class="evidence-tag evidence-tag--d">D</span> Dato no disponible</li>
            </ul>
          </div>
        </div>

        <div class="report__disclaimer">
          <svg class="report__icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zm0 3.5a.75.75 0 01.75.75v4a.75.75 0 01-1.5 0v-4A.75.75 0 0110 5.5zm0 8a.75.75 0 110-1.5.75.75 0 010 1.5z" fill="currentColor"/></svg>
          <p>
            <strong>Advertencia editorial:</strong> no publique el índice exploratorio como &laquo;mejores agencias en Chile&raquo;. Es un ejercicio de documentación pública, no un ranking de calidad.
          </p>
        </div>
      </div>
    </section>

    <!-- ════════════════ 3. COMPETIDORES CHILENOS ════════════════ -->
    <section id="competidores" class="report__section" data-animate>
      <div class="container">
        <Eyebrow variant="primary">03</Eyebrow>
        <SectionHeading size="lg" id="competidores-heading">Competidores chilenos</SectionHeading>

        <div class="filter-bar" id="competitor-filters">
          <button class="filter-btn filter-btn--active" data-filter="all">Todos</button>
          {Object.entries(grupoLabels).map(([key, label]) => (
            <button class="filter-btn" data-filter={key}>{label}</button>
          ))}
        </div>

        <div class="table-wrap">
          <table class="data-table" id="competitors-table">
            <thead>
              <tr>
                <th data-sort="empresa">Empresa</th>
                <th data-sort="especializacion">Especialización</th>
                <th data-sort="lectura">Lectura estratégica</th>
                <th>Grupo</th>
              </tr>
            </thead>
            <tbody>
              {competitors.map(c => (
                <tr data-grupo={c.grupo}>
                  <td>
                    <a href={c.url} target="_blank" rel="noopener noreferrer" class="ext-link">
                      {c.empresa}
                      <svg class="ext-icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3.5 1.5h7v7M10 2L2 10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </a>
                  </td>
                  <td>{c.especializacion}</td>
                  <td>{c.lectura}</td>
                  <td>
                    <span class="grupo-badge" style={`--badge-color: ${grupoColors[c.grupo]}`}>
                      {grupoLabels[c.grupo]}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ════════════════ 4. MATRIZ DE DOCUMENTACIÓN ════════════════ -->
    <section id="matriz" class="report__section report__section--alt" data-animate>
      <div class="container">
        <Eyebrow variant="muted">04</Eyebrow>
        <SectionHeading size="lg" id="matriz-heading">Matriz de documentación pública</SectionHeading>

        <div class="report__disclaimer report__disclaimer--strong">
          <svg class="report__icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M8.485 3.495c.673-1.167 2.357-1.167 3.03 0l5.942 10.29c.674 1.167-.168 2.625-1.515 2.625H4.058c-1.347 0-2.189-1.458-1.515-2.626l5.942-10.29zM10 7.5v3M10 13h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div>
            <p><strong>Esto es un índice exploratorio de documentación pública, NO un ranking de calidad.</strong></p>
            <p>Ponderación: posicionamiento y método 20 %; marketing y web 20 %; CRM, automatización e IA 20 %; casos y evidencia 25 %; transparencia comercial 15 %.</p>
            <p>Escala: 0 = sin evidencia encontrada; 1 = evidencia parcial; 2 = evidencia explícita y detallada. Un &laquo;0&raquo; no significa que la empresa carezca de esa capacidad.</p>
          </div>
        </div>

        <!-- Bar chart -->
        <div class="chart" role="img" aria-label="Gráfico de barras del índice de documentación pública">
          {matrix.map(m => {
            const isInterforma = m.empresa === 'Interforma';
            return (
              <div class:list={['chart__row', { 'chart__row--highlight': isInterforma }]}>
                <span class="chart__label">{m.empresa}</span>
                <div class="chart__bar-wrap">
                  <div class="chart__bar" style={`--bar-width: ${m.indice}%`}>
                    <span class="chart__value">{m.indice}</span>
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <!-- Detail table -->
        <div class="table-wrap">
          <table class="data-table data-table--compact" id="matrix-table">
            <thead>
              <tr>
                <th data-sort="empresa">Empresa</th>
                <th data-sort="posic" class="num-col">Posic.</th>
                <th data-sort="web" class="num-col">Web/Mkt</th>
                <th data-sort="crm" class="num-col">CRM/IA</th>
                <th data-sort="casos" class="num-col">Casos</th>
                <th data-sort="comercial" class="num-col">Comercial</th>
                <th data-sort="indice" class="num-col">Índice /100</th>
              </tr>
            </thead>
            <tbody>
              {matrix.map(m => {
                const isInterforma = m.empresa === 'Interforma';
                return (
                  <tr class:list={[{ 'row--highlight': isInterforma }]}>
                    <td>{m.empresa}</td>
                    <td class="num-col"><span class={`score score--${m.posic}`}>{m.posic}</span></td>
                    <td class="num-col"><span class={`score score--${m.web}`}>{m.web}</span></td>
                    <td class="num-col"><span class={`score score--${m.crm}`}>{m.crm}</span></td>
                    <td class="num-col"><span class={`score score--${m.casos}`}>{m.casos}</span></td>
                    <td class="num-col"><span class={`score score--${m.comercial}`}>{m.comercial}</span></td>
                    <td class="num-col mono-num"><strong>{m.indice}</strong></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ════════════════ 5. PRECIOS ════════════════ -->
    <section id="precios" class="report__section" data-animate>
      <div class="container">
        <Eyebrow variant="primary">05</Eyebrow>
        <SectionHeading size="lg" id="precios-heading">Precios publicados</SectionHeading>

        <div class="report__disclaimer">
          <svg class="report__icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zm0 3.5a.75.75 0 01.75.75v4a.75.75 0 01-1.5 0v-4A.75.75 0 0110 5.5zm0 8a.75.75 0 110-1.5.75.75 0 010 1.5z" fill="currentColor"/></svg>
          <p>
            Nunca promedie estos valores. Corresponden a conceptos, monedas e IVA distintos. Todos están <strong>pendientes de verificación</strong> a la fecha de este informe.
          </p>
        </div>

        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Empresa</th>
                <th>Precio observado</th>
                <th>Notas</th>
              </tr>
            </thead>
            <tbody>
              {prices.map(p => (
                <tr>
                  <td><strong>{p.empresa}</strong></td>
                  <td class="mono-num">{p.precio}</td>
                  <td>{p.notas}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ════════════════ 6. SEO Y VISIBILIDAD ════════════════ -->
    <section id="seo" class="report__section report__section--alt" data-animate>
      <div class="container">
        <Eyebrow variant="muted">06</Eyebrow>
        <SectionHeading size="lg" id="seo-heading">SEO, contenido y visibilidad IA</SectionHeading>

        <p class="report__body">
          Comparación cualitativa de servicios anunciados. No se dispone de datos validados de tráfico, cuota de búsqueda, autoridad, conversiones, inversión ni posiciones de palabras clave.
        </p>

        <h3 class="report__h3">Ideas de landing pages</h3>
        <p class="report__body report__body--small">
          No implementar sin revisar la arquitectura actual del sitio.
        </p>
        <ul class="landing-list">
          <li><code>/automatizacion-procesos-empresas-chile/</code></li>
          <li><code>/agentes-ia-whatsapp-empresas/</code></li>
          <li><code>/implementacion-crm-chile/</code></li>
          <li><code>/automatizacion-logistica-comercio-exterior/</code></li>
