  }
  .report-nav__chevron {
    transition: transform var(--duration-normal, 200ms) var(--ease-default);
  }
  .report-nav__toggle[aria-expanded="true"] .report-nav__chevron {
    transform: rotate(180deg);
  }
  @media (min-width: 1024px) {
    .report-nav__toggle { display: none; }
  }

  /* ── Links container ── */
  .report-nav__links {
    max-width: var(--report-container);
