                const isInmediato = a.horizonte.startsWith('0–');
                return (
                  <tr data-horizon={isInmediato ? 'inmediato' : 'corto'}>
                    <td class="num-col mono-num">{a.n}</td>
                    <td>{a.iniciativa}</td>
                    <td>
                      <span class:list={['impact-badge', { 'impact-badge--high': a.impacto === 'Muy alto', 'impact-badge--med': a.impacto === 'Alto', 'impact-badge--low': a.impacto === 'Medio' }]}>
