---
/**
 * ProblemsSection — «¿Le suena familiar?» contado por Punto.
 *
 * Un escenario SVG con 6 escenas (una por problema) + un cierre, en loop.
 * El texto de los 6 problemas sigue en el HTML (lista de pasos a la derecha):
 * lectores de pantalla, buscadores y reduced motion lo leen igual.
 *
 * Línea de tiempo: el script calcula t y llama a la función de la escena
 * activa con su progreso p (0 → 1). Todo es determinista: saltar a una escena
 * o pausar no rompe nada.
 */
import Eyebrow from '@components/base/Eyebrow.astro';
import SectionHeading from '@components/base/SectionHeading.astro';
import { puntoSvg, type PuntoExpr } from '@lib/punto';

const problems = [
  { num: '01', title: 'Tecnología que nadie usa', body: 'Se instalan sistemas costosos que el equipo evita. La herramienta queda; el proceso no cambia.' },
  { num: '02', title: 'Procesos sin mapear', body: 'Se digitalizan flujos mal definidos y el software amplifica el caos.' },
  { num: '03', title: 'Equipos que no adoptan', body: 'Sin acompañamiento, el equipo vuelve al Excel.' },
  { num: '04', title: 'Sin resultados medibles', body: 'Meses de implementación sin métricas claras.' },
  { num: '05', title: 'Proveedores sin contexto', body: 'Soluciones genéricas que ignoran la operación real.' },
  { num: '06', title: 'Sistemas que no se integran', body: 'Cada área trabaja en su silo y la información no fluye.' },
];

// Expresiones de Punto que usa la animación (capas superpuestas).
const exprs: PuntoExpr[] = ['atento', 'escucha', 'piensa', 'trabaja', 'sorpresa', 'uy'];
const puntoLayers = exprs
  .map((e) => {
    const svg = puntoSvg(e, { size: 170, decor: true, alive: true });
    return svg.replace('<svg class="punto"', `<svg class="punto ps-layer" data-expr="${e}" x="58" y="168"`);
  })
  .join('');

// Madejas (trocoides): líneas que se enredan sobre sí mismas.
function tangle(x0: number, x1: number, y0: number, r: number, loops: number, steps = 220): string {
  let d = '';
  for (let i = 0; i <= steps; i++) {
    const s = i / steps;
    const a = s * loops * Math.PI * 2;
    const rr = r * (0.75 + 0.35 * Math.sin(s * 7.3));
    const x = x0 + s * (x1 - x0) + rr * Math.cos(a);
    const y = y0 + rr * Math.sin(a) * (0.8 + 0.3 * Math.cos(s * 5.1));
    d += `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`;
  }
  return d;
}
const tangleIn = tangle(318, 448, 250, 20, 5);
const tangleOut = tangle(660, 768, 250, 30, 9);

// Engranaje simple (8 dientes) centrado en 0,0.
const gear = Array.from({ length: 8 }, (_, i) => {
  const a = (i / 8) * Math.PI * 2;
  const x = Math.cos(a) * 30;
  const y = Math.sin(a) * 30;
  return `<rect x="${(x - 6).toFixed(1)}" y="${(y - 6).toFixed(1)}" width="12" height="12" rx="2" transform="rotate(${(a * 180) / Math.PI} ${x.toFixed(1)} ${y.toFixed(1)})"/>`;
}).join('');
---

<section id="problemas" class="problems" aria-labelledby="problems-heading">
  <div class="problems__header">
    <div class="problems__lead">
      <Eyebrow>El problema de fondo</Eyebrow>
      <SectionHeading size="xl" id="problems-heading">¿Le suena familiar?</SectionHeading>
    </div>
    <p class="problems__intro">
      La mayoría de los proyectos de transformación digital no fracasan por la
      tecnología, sino por lo que ocurre alrededor de ella.
    </p>
  </div>

  <div class="problems__body" data-problems>
    <!-- Escenario -->
    <figure class="ps-stage">
      <svg class="ps-svg" viewBox="0 0 800 460" role="img" aria-labelledby="ps-title" preserveAspectRatio="xMidYMid meet">
        <title id="ps-title">Animación: Punto, la mascota de Interforma, vive los seis problemas de la lista.</title>

        <!-- Marcador de escena -->
        <text class="ps-mono ps-counter" x="32" y="44" data-counter></text>

        <!-- Escenas 01–06 + suelo: un solo grupo que se reubica en vertical -->
        <g data-props>
        <line x1="32" y1="400" x2="768" y2="400" class="ps-floor" />

        <!-- ── 01 · Tecnología que nadie usa ─────────────── -->
        <g class="ps-scene" data-scene="0">
          <ellipse cx="560" cy="398" rx="96" ry="9" class="ps-shadow" data-s1-shadow />
          <g data-s1-box>
            <rect x="-96" y="-138" width="192" height="138" rx="16" fill="#EE6E43" data-s1-fill />
            <rect x="-14" y="-138" width="28" height="138" class="ps-ribbon" />
            <rect x="-96" y="-82" width="192" height="26" class="ps-ribbon" />
            <text x="0" y="-100" class="ps-label ps-label--ink" text-anchor="middle">APP NUEVA</text>
            <g data-s1-spark class="ps-spark">
              <path d="M-118 -150l-12 -12M118 -150l12 -12M0 -162v-18M-130 -70h-16M130 -70h16" />
            </g>
            <g data-s1-dust class="ps-dust">
              <circle cx="-60" cy="-140" r="4" /><circle cx="-20" cy="-141" r="3" /><circle cx="34" cy="-140" r="5" />
              <circle cx="70" cy="-141" r="3" /><circle cx="-84" cy="-60" r="3" /><circle cx="78" cy="-30" r="4" />
            </g>
            <path data-s1-web class="ps-web" d="M96 -138 l-40 0 M96 -138 l0 40 M96 -138 l-32 30 M66 -138 q4 18 30 22 M84 -138 q2 10 12 12" />
          </g>
          <g data-s1-tag>
            <rect x="660" y="96" width="128" height="34" rx="17" class="ps-pill" />
            <text x="724" y="118" text-anchor="middle" class="ps-mono ps-mono--sm">+6 meses · 0 uso</text>
          </g>
        </g>

        <!-- ── 02 · Procesos sin mapear ─────────────────── -->
        <g class="ps-scene" data-scene="1">
          <path d={tangleIn} class="ps-tangle ps-tangle--in" data-s2-in />
          <g transform="translate(558 250)">
            <rect x="-86" y="-74" width="172" height="148" rx="18" class="ps-machine" />
            <g data-s2-gear class="ps-gear"><circle r="26" />{/* dientes */}<Fragment set:html={gear} /><circle r="9" class="ps-gear-hole" /></g>
            <text x="0" y="58" text-anchor="middle" class="ps-label ps-label--paper">SOFTWARE</text>
          </g>
          <path d={tangleOut} class="ps-tangle ps-tangle--out" data-s2-out />
          <text x="558" y="372" text-anchor="middle" class="ps-mono" data-s2-note>más rápido… igual de enredado</text>
        </g>

        <!-- ── 03 · Equipos que no adoptan ──────────────── -->
        <g class="ps-scene" data-scene="2">
          <g transform="translate(560 96)">
            <rect width="190" height="132" rx="12" class="ps-window" />
            <path d="M0 12a12 12 0 0 1 12-12h166a12 12 0 0 1 12 12v18H0z" fill="#EE6E43" />
            <rect x="20" y="50" width="96" height="10" rx="5" class="ps-skel" />
            <rect x="20" y="72" width="150" height="10" rx="5" class="ps-skel" />
            <rect x="20" y="94" width="120" height="10" rx="5" class="ps-skel" />
            <text x="95" y="21" text-anchor="middle" class="ps-label ps-label--ink ps-label--sm">APP NUEVA</text>
          </g>
          <g transform="translate(330 292)">
            <text x="0" y="-12" class="ps-mono ps-mono--sm">planilla_final_v7.xlsx</text>
            {Array.from({ length: 12 }, (_, i) => (
              <rect x={(i % 4) * 46} y={Math.floor(i / 4) * 30} width="46" height="30" class={i < 4 ? 'ps-cell ps-cell--head' : 'ps-cell'} />
            ))}
          </g>
          <g data-s3-team>
            <rect width="24" height="24" rx="6" class="ps-mod" data-s3-m="0" />
            <rect width="24" height="24" rx="6" class="ps-mod" data-s3-m="1" />
            <rect width="24" height="24" rx="6" class="ps-mod" data-s3-m="2" />
          </g>
          <text x="655" y="262" text-anchor="middle" class="ps-q" data-s3-q>?</text>
        </g>

        <!-- ── 04 · Sin resultados medibles ─────────────── -->
        <g class="ps-scene" data-scene="3">
          <g transform="translate(340 120)">
            <rect width="150" height="160" rx="14" class="ps-window" />
            <path d="M0 14a14 14 0 0 1 14-14h122a14 14 0 0 1 14 14v34H0z" fill="#EE6E43" />
            <rect x="34" y="-12" width="10" height="26" rx="5" class="ps-ink" />
            <rect x="106" y="-12" width="10" height="26" rx="5" class="ps-ink" />
            <text x="75" y="106" text-anchor="middle" class="ps-month" data-s4-month>ENE</text>
            <text x="75" y="136" text-anchor="middle" class="ps-mono ps-mono--sm">2026</text>
          </g>
          <g transform="translate(540 110)">
            <path d="M0 0v220h220" class="ps-axis" />
            <rect x="26" width="34" rx="4" class="ps-bar" data-s4-bar="0" />
            <rect x="84" width="34" rx="4" class="ps-bar" data-s4-bar="1" />
            <rect x="142" width="34" rx="4" class="ps-bar" data-s4-bar="2" />
            <line x1="0" y1="214" x2="220" y2="214" class="ps-flat" />
            <text x="110" y="-10" text-anchor="middle" class="ps-mono" data-s4-kpi>KPI: ¿?</text>
          </g>
        </g>

        <!-- ── 05 · Proveedores sin contexto ────────────── -->
        <g class="ps-scene" data-scene="4">
          <rect x="400" y="120" width="250" height="230" rx="20" class="ps-window" />
          <text x="525" y="150" text-anchor="middle" class="ps-mono ps-mono--sm">SU OPERACIÓN</text>
          <path d="M470 330v-60h40v-40h40v-40h40v140z" class="ps-slot" />
          <g data-s5-block>
            <rect x="-56" y="-56" width="112" height="112" rx="10" class="ps-block" />
            <text x="0" y="-4" text-anchor="middle" class="ps-label ps-label--ink ps-label--sm">TALLA</text>
            <text x="0" y="16" text-anchor="middle" class="ps-label ps-label--ink ps-label--sm">ÚNICA</text>
          </g>
          <g data-s5-bump class="ps-spark"><path d="M532 196l-14-10M528 220h-18M532 244l-14 10" /></g>
        </g>

        <!-- ── 06 · Sistemas que no se integran ─────────── -->
        <g class="ps-scene" data-scene="5">
          <g transform="translate(320 110)">
            <rect width="140" height="96" rx="18" class="ps-island" />
            <text x="70" y="-10" text-anchor="middle" class="ps-mono ps-mono--sm">VENTAS</text>
            <circle r="9" class="ps-datum" data-s6-dot="0" />
          </g>
          <g transform="translate(580 110)">
            <rect width="140" height="96" rx="18" class="ps-island" />
            <text x="70" y="-10" text-anchor="middle" class="ps-mono ps-mono--sm">OPERACIÓN</text>
            <circle r="9" class="ps-datum" data-s6-dot="1" />
          </g>
          <g transform="translate(450 268)">
            <rect width="140" height="96" rx="18" class="ps-island" />
            <text x="70" y="124" text-anchor="middle" class="ps-mono ps-mono--sm">FINANZAS</text>
            <circle r="9" class="ps-datum" data-s6-dot="2" />
          </g>
          <line x1="460" y1="158" x2="460" y2="158" class="ps-bridge" data-s6-bridge="0" />
          <line x1="620" y1="206" x2="620" y2="206" class="ps-bridge" data-s6-bridge="1" />
        </g>
        </g>

        <!-- ── Cierre ───────────────────────────────────── -->
        <g class="ps-scene" data-scene="6">
          <g class="ps-h">
            <text x="292" y="206" class="ps-claim">No falla la tecnología.</text>
            <text x="292" y="252" class="ps-claim ps-claim--accent">Falla lo que ocurre alrededor.</text>
          </g>
          <g class="ps-v" text-anchor="middle">
            <text x="225" y="410" class="ps-claim ps-claim--v">No falla</text>
            <text x="225" y="452" class="ps-claim ps-claim--v">la tecnología.</text>
            <text x="225" y="512" class="ps-claim ps-claim--v ps-claim--accent">Falla lo que ocurre</text>
            <text x="225" y="554" class="ps-claim ps-claim--v ps-claim--accent">alrededor.</text>
          </g>
          <g data-s7-arrow transform="translate(296 300)">
            <text x="38" y="5" class="ps-mono ps-mono--sm" data-s7-arrow-text>El Método empieza aquí</text>
            <path d="M0 -6l10 10 10-10" class="ps-chevron" transform="translate(4 0)" />
          </g>
        </g>

        <!-- Solo en el reel para redes (?ps-render=reel): título, subtítulos y marca -->
        <g class="ps-social" aria-hidden="true">
          <text x="225" y="58" text-anchor="middle" class="ps-social__eyebrow">EL PROBLEMA DE FONDO</text>
          <text x="225" y="100" text-anchor="middle" class="ps-social__title">¿Le suena familiar?</text>
          <g data-social-cap>
            <text x="225" y="694" text-anchor="middle" class="ps-social__num" data-cap-num></text>
            <text x="225" y="726" text-anchor="middle" class="ps-social__cap" data-cap-title></text>
            <text x="225" y="754" text-anchor="middle" class="ps-social__body" data-cap-body></text>
          </g>
          <g data-social-brand>
            <text x="225" y="742" text-anchor="middle" class="ps-social__brand">interforma.digital</text>
          </g>
        </g>

        <!-- Punto (capas por expresión) -->
        <g data-punto><Fragment set:html={puntoLayers} /></g>
      </svg>

      <figcaption class="ps-controls">
        <button type="button" class="ps-toggle" data-toggle aria-pressed="false">
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" class="ps-ico-pause"><rect x="2" y="1" width="3.5" height="12" rx="1"/><rect x="8.5" y="1" width="3.5" height="12" rx="1"/></svg>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" class="ps-ico-play"><path d="M3 1.5v11l9-5.5z"/></svg>
          <span data-toggle-label>Pausar</span>
        </button>
        <button type="button" class="ps-toggle" data-sound aria-pressed="false">
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 5h3l4-3v10L4 9H1z"/><path class="ps-wave" d="M10 4.5q2 2.5 0 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span data-sound-label>Activar sonido</span>
        </button>
      </figcaption>
    </figure>

    <!-- Lista real de problemas: índice de escenas -->
    <ol class="ps-steps" role="list">
      {problems.map((p, i) => (
        <li class="ps-step" data-step={i} aria-current={i === 0 ? 'step' : undefined}>
          <h3 class="ps-step__title">
            <button type="button" class="ps-step__btn" data-goto={i} aria-describedby={`ps-body-${i}`}>
              <span class="ps-step__num">{p.num}</span>
              <span>{p.title}</span>
            </button>
          </h3>
          <p class="ps-step__body" id={`ps-body-${i}`}>{p.body}</p>
          <span class="ps-step__bar" aria-hidden="true"><span data-bar={i}></span></span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .problems {
    padding: clamp(64px, 8vw, 120px) clamp(20px, 5.5vw, 80px);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .problems__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    flex-wrap: wrap;
  }
  .problems__lead { display: flex; flex-direction: column; gap: 16px; max-width: 700px; }
  .problems__intro {
    margin: 0;
    font-size: var(--font-size-body-lg);
    line-height: 1.6;
    color: var(--gray-700);
    max-width: 460px;
  }

  /* ── Cuerpo: escenario + pasos ─────────────────────────── */
  .problems__body {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(280px, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  .ps-stage {
    margin: 0;
    position: relative;
    background: var(--paper);
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-card-lg);
    overflow: hidden;
  }
  .ps-svg { display: block; width: 100%; height: auto; }

  .ps-controls { position: absolute; right: 16px; bottom: 14px; display: none; }
  .is-ready .ps-controls { display: flex; gap: 8px; }
  .ps-wave { opacity: .35; }
  .ps-toggle[data-sound][aria-pressed='true'] .ps-wave { opacity: 1; }
  .ps-toggle {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 14px;
    border-radius: var(--radius-full);
    border: 1px solid var(--gray-200);
    background: var(--white);
    color: var(--ink);
    font: 600 13px/1 var(--font-family-ui);
    cursor: pointer;
  }
  .ps-toggle svg { fill: currentColor; }
  .ps-toggle:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }
  .ps-ico-play { display: none; }
  .ps-toggle[aria-pressed='true'] .ps-ico-play { display: block; }
  .ps-toggle[aria-pressed='true'] .ps-ico-pause { display: none; }

  /* ── Elementos del escenario ───────────────────────────── */
  /* Sin JS se ve el cierre (frase + Punto); el script toma el control. */
  .ps-scene:not([data-scene='6']) { opacity: 0; }
  .ps-floor { stroke: var(--gray-200); stroke-width: 2; }
  .ps-shadow { fill: var(--ink); opacity: .08; }
  .ps-ribbon { fill: var(--ink); opacity: .12; }
  .ps-label { font: 600 16px var(--font-family-ui); letter-spacing: .08em; }
  .ps-label--sm { font-size: 12px; }
  .ps-label--ink { fill: var(--ink); }
  .ps-label--paper { fill: var(--white); }
  .ps-mono { font: 400 15px var(--font-family-mono); fill: var(--gray-500); }
  .ps-mono--sm { font-size: 12px; }
  .ps-counter { fill: var(--primary-500); font-size: 13px; letter-spacing: .06em; }
  .ps-spark path, .ps-chevron { stroke: var(--ink); stroke-width: 4; stroke-linecap: round; fill: none; }
  .ps-chevron { stroke: var(--brand-800); }
  .ps-dust circle { fill: var(--gray-400); }
  .ps-web { stroke: var(--gray-400); stroke-width: 1.5; fill: none; }
  .ps-pill { fill: var(--white); stroke: var(--gray-200); }
  .ps-tangle { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .ps-tangle--in { stroke: var(--ink); stroke-width: 3; }
  .ps-tangle--out { stroke: var(--brand-600); stroke-width: 4; }
  .ps-machine { fill: var(--ink); }
  .ps-gear { fill: var(--brand-500); }
  .ps-gear-hole { fill: var(--ink); }
  .ps-window { fill: var(--white); stroke: var(--gray-200); stroke-width: 2; }
  .ps-skel { fill: var(--gray-200); }
  .ps-cell { fill: var(--white); stroke: var(--gray-400); stroke-width: 1; }
  .ps-cell--head { fill: var(--sky); }
  .ps-mod { fill: var(--ink); }
  .ps-q { font: 500 34px var(--font-family-heading); fill: var(--brand-800); }
  .ps-ink { fill: var(--ink); }
  .ps-month { font: 500 40px var(--font-family-heading); fill: var(--ink); letter-spacing: -.02em; }
  .ps-axis { stroke: var(--ink); stroke-width: 2; fill: none; }
  .ps-bar { fill: var(--brand-500); }
  .ps-flat { stroke: var(--brand-800); stroke-width: 2; stroke-dasharray: 6 6; }
  .ps-slot { fill: var(--ink); opacity: .85; }
  .ps-block { fill: var(--stone); stroke: var(--ink); stroke-width: 2; }
  .ps-island { fill: var(--white); stroke: var(--gray-200); stroke-width: 2; }
  .ps-datum { fill: var(--brand-500); }
  .ps-bridge { stroke: var(--ink); stroke-width: 5; stroke-dasharray: 7 6; stroke-linecap: round; }
  .ps-claim { font: 500 31px var(--font-family-heading); fill: var(--ink); letter-spacing: -.02em; }
  .ps-claim--v { font-size: 36px; }

  /* Variantes de composición: horizontal (escritorio) y vertical (móvil y reel) */
  .ps-v, .ps-social { display: none; }
  .ps-svg.is-v .ps-v { display: inline; }
  .ps-svg.is-v .ps-h { display: none; }
  .ps-svg.is-social .ps-social { display: inline; }
  .ps-svg.is-social .ps-counter { display: none; }
  .ps-svg.is-social :global(.ps-layer) { transition: none; }
  .ps-social__eyebrow { font: 500 13px var(--font-family-ui); letter-spacing: .1em; fill: var(--primary-500); }
  .ps-social__title { font: 500 38px var(--font-family-heading); letter-spacing: -.02em; fill: var(--ink); }
  .ps-social__num { font: 500 14px var(--font-family-mono); fill: var(--primary-500); }
  .ps-social__cap { font: 500 25px var(--font-family-heading); letter-spacing: -.01em; fill: var(--ink); }
  .ps-social__body { font: 400 15px var(--font-family-ui); fill: var(--gray-700); }
  .ps-social__brand { font: 600 20px var(--font-family-ui); fill: var(--ink); letter-spacing: .01em; }
  .ps-claim--accent { fill: var(--brand-800); }
  /* Las capas de Punto llegan por set:html: necesitan :global */
  :global(.ps-layer) { opacity: 0; transition: opacity .18s ease; }
  :global(.ps-layer[data-expr='atento']) { opacity: 1; }

  /* ── Pasos ─────────────────────────────────────────────── */
  .ps-steps {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: 6px;
  }
  .ps-step {
    position: relative;
    border: 1px solid transparent;
    border-radius: var(--radius-card);
    padding: 14px 18px 16px;
    transition: background .25s, border-color .25s;
  }
  .ps-step[aria-current='step'] { background: var(--white); border-color: var(--gray-200); }
  .ps-step__btn {
    all: unset;
    cursor: pointer;
    display: flex; align-items: baseline; gap: 12px;
    width: 100%;
  }
  .ps-step__btn:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 4px; border-radius: 4px; }
  .ps-step__num { font: 500 12px var(--font-family-mono); color: var(--gray-500); }
  .ps-step[aria-current='step'] .ps-step__num { color: var(--primary-500); }
  .ps-step__title {
    margin: 0;
    font: 500 18px/1.25 var(--font-family-heading);
    letter-spacing: -.01em;
    color: var(--gray-500);
    transition: color .25s;
  }
  .ps-step__title:hover,
  .ps-step[aria-current='step'] .ps-step__title { color: var(--ink); }
  .ps-step__body {
    margin: 0;
    padding-left: 30px;
    font-size: var(--font-size-body-sm);
    line-height: var(--line-height-body-sm);
    color: var(--gray-700);
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height .35s var(--ease-default), opacity .25s, margin .35s;
  }
  .ps-step[aria-current='step'] .ps-step__body { max-height: 80px; opacity: 1; margin-top: 8px; }
  .ps-step__bar {
    position: absolute; left: 18px; right: 18px; bottom: 6px;
    height: 2px; border-radius: 2px; background: var(--gray-100);
    opacity: 0;
  }
  .ps-step[aria-current='step'] .ps-step__bar { opacity: 1; }
  .ps-step__bar span {
    display: block; height: 100%; width: 100%;
    background: var(--brand-500);
    transform-origin: left; transform: scaleX(0);
    border-radius: inherit;
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .problems__body { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .problems__header { flex-direction: column; align-items: flex-start; }
    .problems__intro { max-width: none; }
    .ps-step { padding: 12px 14px 14px; }
    .ps-step__title { font-size: 16px; }
    .ps-counter { display: none; }
    .ps-controls { right: auto; left: 10px; top: 10px; bottom: auto; }
    .ps-toggle { padding: 8px; }
    .ps-toggle span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }

  /* Sin movimiento: escenas fijas, sin barra de avance ni botón de pausa */
  @media (prefers-reduced-motion: reduce) {
    .is-ready .ps-controls, .ps-step__bar { display: none; }
    .ps-step__body, :global(.ps-layer) { transition: none; }
  }
</style>

<script>
  import { track } from '@lib/analytics/track';

  // Duración de cada escena en segundos: 6 problemas + cierre.
  const DUR = [4.6, 4.6, 5.0, 4.4, 4.6, 4.8, 5.2];
  const TOTAL = DUR.reduce((a, b) => a + b, 0);

  // Efectos de sonido: [escena, progreso, efecto]. design/motion/audio_problemas.py
  // usa esta misma lista para el reel; si cambia aquí, cambia allá.
  type Sfx = 'thump' | 'pop' | 'swish' | 'tick' | 'bonk' | 'snap' | 'chime';
  const EVENTS: [number, number, Sfx][] = [
    [0, 0.24, 'thump'], [0, 0.5, 'pop'],
    [1, 0.04, 'swish'], [1, 0.42, 'swish'], [1, 0.55, 'pop'],
    [2, 0.1, 'tick'], [2, 0.18, 'tick'], [2, 0.26, 'tick'], [2, 0.34, 'pop'], [2, 0.58, 'tick'], [2, 0.68, 'tick'], [2, 0.78, 'tick'],
    ...[1, 2, 3, 4, 5, 6, 7, 8].map((k): [number, number, Sfx] => [3, 0.05 + (k * 0.8) / 9, 'tick']),
    [4, 0.28, 'bonk'], [4, 0.31, 'pop'], [4, 0.66, 'bonk'],
    [5, 0.4, 'snap'], [5, 0.76, 'snap'], [5, 0.77, 'pop'],
    [6, 0.1, 'chime'],
  ];
  const START = DUR.map((_, i) => DUR.slice(0, i).reduce((a, b) => a + b, 0));

  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
  const ease = (x: number) => 1 - Math.pow(1 - x, 3);
  const easeInOut = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
  const back = (x: number) => { const c = 1.7; return 1 + (c + 1) * Math.pow(x - 1, 3) + c * Math.pow(x - 1, 2); };
  const mix = (a: number, b: number, k: number) => a + (b - a) * k;
  const mixHex = (h1: string, h2: string, k: number) => {
    const p = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
    const [a, b] = [p(h1), p(h2)];
    return '#' + a.map((v, i) => Math.round(mix(v, b[i], k)).toString(16).padStart(2, '0')).join('');
  };

  function initProblems(root: HTMLElement) {
    const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const qa = <T extends Element>(sel: string) => Array.from(root.querySelectorAll<T>(sel));
    const scenes = qa<SVGGElement>('.ps-scene');
    const steps = qa<HTMLLIElement>('.ps-step');
    const bars = qa<HTMLSpanElement>('[data-bar]');
    const layers = qa<SVGSVGElement>('.ps-layer');
    const punto = q<SVGGElement>('[data-punto]');
    const counter = q<SVGTextElement>('[data-counter]');
    const toggle = q<HTMLButtonElement>('[data-toggle]');
    const toggleLabel = q<HTMLSpanElement>('[data-toggle-label]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const svg = q<SVGSVGElement>('.ps-svg');
    const props = q<SVGGElement>('[data-props]');
    const social = new URLSearchParams(location.search).get('ps-render') === 'reel';
    const capNum = q<SVGTextElement>('[data-cap-num]');
    const capTitle = q<SVGTextElement>('[data-cap-title]');
    const capBody = q<SVGTextElement>('[data-cap-body]');
    const capGroup = q<SVGGElement>('[data-social-cap]');
    const brand = q<SVGGElement>('[data-social-brand]');
    const titles = steps.map((st) => st.querySelector('.ps-step__btn span:last-child')!.textContent!.trim());
    const bodies = steps.map((st) => st.querySelector('.ps-step__body')!.textContent!.trim());

    // ── Composición: horizontal en escritorio, vertical en móvil y en el reel ─
    const LAYOUTS = {
      h: { vb: '0 0 800 460', props: '', punto: [143, 253, 1], arrow: [296, 300] },
      v: { vb: '0 40 450 640', props: 'translate(-265.5 249.5) scale(0.9)', punto: [225, 200, 1.15], arrow: [112, 610] },
      reel: { vb: '0 0 450 800', props: 'translate(-265.5 268) scale(0.9)', punto: [225, 228, 1.12], arrow: [112, 610] },
    };
    const mqV = window.matchMedia('(max-width: 640px)');
    let L = LAYOUTS.h;
    function applyLayout() {
      L = social ? LAYOUTS.reel : mqV.matches ? LAYOUTS.v : LAYOUTS.h;
      svg.setAttribute('viewBox', L.vb);
      svg.classList.toggle('is-v', L !== LAYOUTS.h);
      svg.classList.toggle('is-social', social);
      props.setAttribute('transform', L.props);
    }
    applyLayout();
    mqV.addEventListener('change', () => { applyLayout(); render(performance.now() / 1000); });

    // ── Sonido (apagado por defecto; se activa con el botón) ─
    let audio: AudioContext | null = null;
    let master: GainNode | null = null;
    let soundOn = false;
    function tone(f1: number, f2: number, d: number, type: OscillatorType, vol: number, delay = 0) {
      if (!audio || !master) return;
      const t0 = audio.currentTime + delay;
      const o = audio.createOscillator();
      const g = audio.createGain();
      o.type = type;
      o.frequency.setValueAtTime(f1, t0);
      o.frequency.exponentialRampToValueAtTime(f2, t0 + d);
      g.gain.setValueAtTime(0.0001, t0);
      g.gain.exponentialRampToValueAtTime(vol, t0 + 0.008);
      g.gain.exponentialRampToValueAtTime(0.0001, t0 + d);
      o.connect(g).connect(master);
      o.start(t0);
      o.stop(t0 + d + 0.02);
    }
    function swish() {
      if (!audio || !master) return;
      const d = 0.35;
      const buf = audio.createBuffer(1, Math.floor(audio.sampleRate * d), audio.sampleRate);
      const ch = buf.getChannelData(0);
      for (let i = 0; i < ch.length; i++) ch[i] = (Math.random() * 2 - 1) * Math.sin((Math.PI * i) / ch.length) ** 2;
      const src = audio.createBufferSource();
      const bp = audio.createBiquadFilter();
      const g = audio.createGain();
      src.buffer = buf;
      bp.type = 'bandpass';
      bp.frequency.value = 1800;
      g.gain.value = 0.25;
      src.connect(bp).connect(g).connect(master);
      src.start();
    }
    const SFX: Record<Sfx, () => void> = {
      thump: () => tone(150, 55, 0.3, 'sine', 0.9),
      pop: () => tone(520, 880, 0.12, 'sine', 0.45),
      swish,
      tick: () => tone(2400, 1800, 0.035, 'triangle', 0.12),
      bonk: () => tone(240, 150, 0.16, 'triangle', 0.6),
      snap: () => tone(1100, 280, 0.09, 'square', 0.12),
      chime: () => { tone(784, 780, 0.9, 'sine', 0.3); tone(1175, 1170, 1.1, 'sine', 0.2, 0.12); },
    };
    const EVENT_T = EVENTS.map(([sc, pp, fx]) => [START[sc] + pp * DUR[sc], fx] as const);
    function playBetween(a: number, b: number) {
      if (!soundOn) return;
      for (const [et, fx] of EVENT_T) {
        const hit = a <= b ? et > a && et <= b : et > a || et <= b; // cruza el inicio del loop
        if (hit) SFX[fx]();
      }
    }

    // ── Punto ───────────────────────────────────────────────
    let currentExpr = '';
    let exprChangedAt = 0;
    function setPunto(expr: string, x = 0, y = 0, now = 0) {
      if (expr !== currentExpr) {
        layers.forEach((l) => (l.style.opacity = l.dataset.expr === expr ? '1' : '0'));
        currentExpr = expr;
        exprChangedAt = now;
      }
      // Pequeño rebote al cambiar de expresión (0,3 s).
      const k = reduced ? 1 : clamp((now - exprChangedAt) / 0.3);
      const s = 1 + 0.07 * Math.sin(Math.PI * k);
      const [px, py, ps] = L.punto;
      punto.setAttribute('transform', `translate(${x + px} ${y + py}) scale(${ps * s}) translate(-143 -253)`);
    }

    // ── Escenas: cada una recibe p (0 → 1) y el tiempo global ─
    const s1 = {
      box: q<SVGGElement>('[data-s1-box]'), fill: q<SVGRectElement>('[data-s1-fill]'),
      spark: q<SVGGElement>('[data-s1-spark]'), dust: qa<SVGCircleElement>('[data-s1-dust] circle'),
      web: q<SVGPathElement>('[data-s1-web]'), tag: q<SVGGElement>('[data-s1-tag]'), shadow: q<SVGEllipseElement>('[data-s1-shadow]'),
    };
    const s2 = {
      tin: q<SVGPathElement>('[data-s2-in]'), tout: q<SVGPathElement>('[data-s2-out]'),
      gear: q<SVGGElement>('[data-s2-gear]'), note: q<SVGTextElement>('[data-s2-note]'),
    };
    const lenIn = s2.tin.getTotalLength();
    const lenOut = s2.tout.getTotalLength();
    [[s2.tin, lenIn], [s2.tout, lenOut]].forEach(([el, l]) => {
      (el as SVGPathElement).style.strokeDasharray = `${l}`;
    });
    const s3 = { mods: qa<SVGRectElement>('[data-s3-m]'), q: q<SVGTextElement>('[data-s3-q]') };
    const s4 = { month: q<SVGTextElement>('[data-s4-month]'), bars: qa<SVGRectElement>('[data-s4-bar]'), kpi: q<SVGTextElement>('[data-s4-kpi]') };
    const s5 = { block: q<SVGGElement>('[data-s5-block]'), bump: q<SVGGElement>('[data-s5-bump]') };
    const s6 = { dots: qa<SVGCircleElement>('[data-s6-dot]'), bridges: qa<SVGLineElement>('[data-s6-bridge]') };
    const s7 = { arrow: q<SVGGElement>('[data-s7-arrow]') };
    const MONTHS = ['ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN', 'JUL', 'AGO', 'SEP'];

    const draw: ((p: number, now: number) => void)[] = [
      // 01 — La app llega brillante y se llena de polvo.
      (p, now) => {
        const drop = back(seg(p, 0.04, 0.26));
        s1.box.setAttribute('transform', `translate(560 ${mix(-10, 398, drop)})`);
        s1.shadow.style.opacity = String(0.08 * drop);
        const aging = seg(p, 0.45, 0.75);
        s1.fill.setAttribute('fill', mixHex('#EE6E43', '#BEB8AE', aging));
        s1.spark.style.opacity = String(seg(p, 0.24, 0.3) * (1 - seg(p, 0.42, 0.5)));
        s1.dust.forEach((d, i) => (d.style.opacity = String(seg(p, 0.5 + i * 0.04, 0.6 + i * 0.04))));
        s1.web.style.opacity = String(seg(p, 0.62, 0.8));
        s1.tag.style.opacity = String(seg(p, 0.55, 0.66));
        setPunto(p < 0.5 ? 'atento' : 'uy', 0, 0, now);
      },
      // 02 — Una madeja entra al software y sale más grande y más rápida.
      (p, now) => {
        s2.tin.style.strokeDashoffset = String(lenIn * (1 - ease(seg(p, 0.02, 0.36))));
        s2.gear.setAttribute('transform', `rotate(${p * 540})`);
        const out = seg(p, 0.42, 0.72);
        s2.tout.style.strokeDashoffset = String(lenOut * (1 - out));
        const jitter = out > 0 && out < 1 ? Math.sin(now * 40) * 1.5 : 0;
        s2.tout.setAttribute('transform', `translate(0 ${jitter})`);
        s2.note.style.opacity = String(seg(p, 0.72, 0.82));
        setPunto(p < 0.55 ? 'piensa' : 'sorpresa', 0, 0, now);
      },
      // 03 — El equipo va a la app nueva, duda y vuelve a la planilla.
      (p, now) => {
        const there = easeInOut(seg(p, 0.05, 0.32));
        const back2 = easeInOut(seg(p, 0.5, 0.86));
        s3.mods.forEach((m, i) => {
          const start = { x: 300 + i * 30, y: 372 };
          const app = { x: 600 + i * 34, y: 250 };
          const cell = { x: 330 + i * 46 + 11, y: 292 + 30 * (1 + (i % 2)) + 3 };
          let x = mix(start.x, app.x, there);
          let y = mix(start.y, app.y, there);
          x = mix(x, cell.x, back2);
          y = mix(y, cell.y, back2);
          const moving = (there > 0 && there < 1) || (back2 > 0 && back2 < 1);
          const hop = moving ? Math.abs(Math.sin(now * 9 + i)) * 10 : 0;
          m.setAttribute('x', String(x));
          m.setAttribute('y', String(y - hop));
        });
        s3.q.style.opacity = String(seg(p, 0.33, 0.38) * (1 - seg(p, 0.48, 0.52)));
        setPunto(p < 0.55 ? 'escucha' : 'uy', 0, 0, now);
      },
      // 04 — Pasan los meses; las barras intentan subir y vuelven a cero.
      (p, now) => {
        const m = Math.min(MONTHS.length - 1, Math.floor(seg(p, 0.05, 0.85) * MONTHS.length));
        s4.month.textContent = MONTHS[m];
        s4.bars.forEach((b, i) => {
          const k = seg(p, 0.12 + i * 0.12, 0.32 + i * 0.12);
          const h = Math.sin(Math.PI * k) * (46 + i * 14);
          b.setAttribute('height', String(Math.max(0, h)));
          b.setAttribute('y', String(214 - Math.max(0, h)));
        });
        s4.kpi.style.opacity = String(seg(p, 0.6, 0.7));
        setPunto('piensa', 0, 0, now);
      },
      // 05 — La pieza «talla única» no calza en la operación.
      (p, now) => {
        // Llega, choca, retrocede, gira e intenta de nuevo.
        const a = ease(seg(p, 0.04, 0.28));
        const r1 = seg(p, 0.3, 0.42);
        const b = ease(seg(p, 0.46, 0.66));
        const r2 = seg(p, 0.68, 0.8);
        let x = mix(880, 600, a) + 56 * Math.sin(Math.PI * r1);
        x = mix(x, 588, b) + 56 * Math.sin(Math.PI * r2);
        const rot = mix(0, 18, b);
        const shake = (r1 > 0 && r1 < 0.3) || (r2 > 0 && r2 < 0.3) ? Math.sin(now * 60) * 3 : 0;
        s5.block.setAttribute('transform', `translate(${x + shake} 236) rotate(${rot})`);
        s5.bump.style.opacity = String(Math.max(Math.sin(Math.PI * seg(p, 0.27, 0.4)), Math.sin(Math.PI * seg(p, 0.64, 0.76))));
        setPunto(p < 0.3 ? 'atento' : 'sorpresa', 0, 0, now);
      },
      // 06 — Datos atrapados en sus islas; el puente no alcanza.
      (p, now) => {
        s6.dots.forEach((d, i) => {
          const t = now * (0.9 + i * 0.25);
          const tri = (v: number) => 1 - Math.abs(((v % 2) + 2) % 2 - 1);
          d.setAttribute('cx', String(14 + tri(t * 0.9) * 112));
          d.setAttribute('cy', String(14 + tri(t * 1.3 + 0.4) * 68));
        });
        const tries = [seg(p, 0.12, 0.42), seg(p, 0.48, 0.78)];
        s6.bridges.forEach((br, i) => {
          const k = Math.min(1, 2.5 * Math.sin(Math.PI * tries[i])) * 0.86;
          const [x1, y1, x2, y2] = i === 0 ? [460, 158, 580, 158] : [620, 206, 560, 268];
          br.setAttribute('x2', String(mix(x1, x2, k)));
          br.setAttribute('y2', String(mix(y1, y2, k)));
        });
        setPunto(p < 0.76 ? 'trabaja' : 'uy', 0, 0, now);
      },
      // Cierre — la frase y la flecha hacia el Método.
      (p, now) => {
        s7.arrow.style.opacity = String(seg(p, 0.35, 0.5));
        const bob = reduced ? 0 : Math.sin(now * 4) * 4;
        s7.arrow.setAttribute('transform', `translate(${L.arrow[0]} ${L.arrow[1] + bob})`);
        setPunto('atento', 0, 0, now);
      },
    ];

    // ── Reloj ───────────────────────────────────────────────
    let t = 0;
    let playing = !reduced;
    let visible = false;
    let last = 0;
    let shownScene = -1;
    const seen = new Set<number>();

    function sceneAt(time: number) {
      let i = START.findIndex((s, k) => time >= s && time < s + DUR[k]);
      return i < 0 ? 0 : i;
    }

    function render(now: number) {
      const i = sceneAt(t);
      const p = (t - START[i]) / DUR[i];
      // Fundido de entrada y salida de cada escena.
      scenes.forEach((s, k) => {
        s.style.opacity = k === i ? String(reduced ? 1 : Math.min(seg(p, 0, 0.07), 1 - seg(p, 0.93, 1))) : '0';
      });
      draw[i](reduced ? 0.8 : p, now);
      counter.textContent = i < 6 ? `${String(i + 1).padStart(2, '0')} / 06` : '';
      const stepIdx = Math.min(i, 5);
      if (i !== shownScene) {
        shownScene = i;
        steps.forEach((s, k) => (k === stepIdx && i < 6 ? s.setAttribute('aria-current', 'step') : s.removeAttribute('aria-current')));
        if (i === 6) steps.forEach((s) => s.removeAttribute('aria-current'));
        if (!seen.has(i)) {
          seen.add(i);
          track('problems_scene_view', { scene: i < 6 ? i + 1 : 'cierre' });
        }
      }
      bars.forEach((b, k) => (b.style.transform = `scaleX(${k === i ? p : 0})`));

      // Reel: subtítulo de la escena y marca en el cierre.
      if (social) {
        const fade = Math.min(seg(p, 0.02, 0.1), 1 - seg(p, 0.92, 0.99));
        if (i < 6) {
          capNum.textContent = `${String(i + 1).padStart(2, '0')} / 06`;
          capTitle.textContent = titles[i];
          // Ajuste a líneas de ~42 caracteres.
          const lines: string[] = [''];
          for (const w of bodies[i].split(' ')) {
            if ((lines[lines.length - 1] + ' ' + w).trim().length > 42) lines.push(w);
            else lines[lines.length - 1] = (lines[lines.length - 1] + ' ' + w).trim();
          }
          capBody.innerHTML = lines.map((ln, k) => `<tspan x="225" dy="${k ? 21 : 0}">${ln}</tspan>`).join('');
        }
        capGroup.style.opacity = i < 6 ? String(fade) : '0';
        brand.style.opacity = i === 6 ? String(seg(p, 0.45, 0.6)) : '0';
      }
    }

    function frame(ms: number) {
      const now = ms / 1000;
      const dt = last ? Math.min(0.1, now - last) : 0;
      last = now;
      if (playing && visible) {
        const prev = t;
        t = (t + dt) % TOTAL;
        playBetween(prev, t);
      }
      render(now);
      if (visible) requestAnimationFrame(frame);
      else last = 0;
    }

    function goTo(i: number) {
      t = START[i] + (reduced ? 0 : 0.001);
      render(performance.now() / 1000);
    }

    // Saltar a una escena desde la lista.
    qa<HTMLButtonElement>('[data-goto]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const i = Number(btn.dataset.goto);
        goTo(i);
        track('problems_chip_click', { scene: i + 1 });
      });
    });

    // Pausar / reanudar.
    function setPlaying(v: boolean) {
      playing = v;
      toggle.setAttribute('aria-pressed', String(!v));
      toggleLabel.textContent = v ? 'Pausar' : 'Reproducir';
    }
    toggle.addEventListener('click', () => {
      setPlaying(!playing);
      track('problems_toggle', { state: playing ? 'play' : 'pause' });
    });

    // Solo corre mientras la sección está en pantalla.
    const io = new IntersectionObserver(
      ([entry]) => {
        const was = visible;
        visible = entry.isIntersecting;
        if (visible && !was) requestAnimationFrame(frame);
      },
      { threshold: 0.35 },
    );
    io.observe(root);

    // Sonido: el navegador solo permite audio tras un gesto del usuario.
    const soundBtn = q<HTMLButtonElement>('[data-sound]');
    const soundLabel = q<HTMLSpanElement>('[data-sound-label]');
    soundBtn.addEventListener('click', async () => {
      soundOn = !soundOn;
      if (soundOn && !audio) {
        audio = new AudioContext();
        master = audio.createGain();
        master.gain.value = 0.35;
        master.connect(audio.destination);
      }
      if (audio) await (soundOn ? audio.resume() : audio.suspend());
      if (soundOn) SFX.pop();
      soundBtn.setAttribute('aria-pressed', String(soundOn));
      soundLabel.textContent = soundOn ? 'Silenciar' : 'Activar sonido';
      track('problems_sound', { state: soundOn ? 'on' : 'off' });
    });

    // Modo reel (?ps-render=reel): el renderizador fija el tiempo cuadro a cuadro.
    if (social) {
      setPlaying(false);
      (window as unknown as { psRender: (time: number) => void; psTotal: number }).psRender = (time: number) => {
        t = time % TOTAL;
        render(time);
      };
      (window as unknown as { psTotal: number }).psTotal = TOTAL;
      q<SVGTextElement>('[data-s7-arrow-text]').textContent = 'Conozca el Método Interforma';
    }

    if (reduced) setPlaying(false);
    root.classList.add('is-ready');
    render(0);
  }

  document.querySelectorAll<HTMLElement>('[data-problems]').forEach(initProblems);
</script>
