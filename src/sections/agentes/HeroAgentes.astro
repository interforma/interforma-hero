---
// HeroAgentes.astro — Sección hero de la página /agentes
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__container">
    <div class="hero__grid">

      <!-- Columna izquierda: copy -->
      <div class="hero__copy">
        <h1 id="hero-heading" class="hero__h1">
          <span class="hero__h1-line">Tu primer agente de IA, en 30 días.</span>
          <span class="hero__h1-accent">Con una persona al mando.</span>
        </h1>
        <p class="hero__body">
          Interforma Agents atiende las conversaciones repetitivas de tu equipo por WhatsApp, web o Instagram.
          Cuando algo sale de la política, deriva a tu operador con todo el contexto — y nada se cotiza,
          reserva o descuenta sin su aprobación.
        </p>
        <div class="hero__ctas">
          <a href="#empezar" class="hero__cta hero__cta--primary">
            Agendar piloto
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="square" aria-hidden="true">
              <path d="M5 12h14"/>
              <path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
          <a href="#como" class="hero__cta hero__cta--ghost">
            Cómo funciona
          </a>
        </div>
      </div>

      <!-- Columna derecha: mock operador -->
      <div class="hero__mock-wrap">
        <div class="hero__mock" role="img" aria-label="Tarjeta de derivación del operador">
          <!-- Header rojo -->
          <div class="mock__header">
            <span class="mock__label">Espera humano · 6 min</span>
            <span class="mock__channel">WhatsApp</span>
          </div>

          <!-- Body -->
          <div class="mock__body">
            <p class="mock__name">María José Pérez</p>
            <p class="mock__desc">Pide 20% de descuento; la política permite máximo 10%.</p>

            <!-- Tabla de contexto -->
            <table class="mock__table" aria-label="Contexto del agente">
              <tbody>
                <tr>
                  <th scope="row">Intención</th>
                  <td>Cotización · plan mensual</td>
                </tr>
                <tr>
                  <th scope="row">Datos</th>
                  <td>3 sucursales · 40 usuarios</td>
                </tr>
                <tr>
                  <th scope="row">Confianza</th>
                  <td>54%</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- CTA row -->
          <div class="mock__cta-row">
            <span>Tomar conversación</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="square" aria-hidden="true">
              <path d="M5 12h14"/>
              <path d="m12 5 7 7-7 7"/>
            </svg>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(56px, 9vw, 112px) 0 72px;
    background: var(--color-bg-page);
  }

  .hero__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 72px);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 56px;
    align-items: center;
  }

  /* ── Copy ─────────────────────────────────────────────── */
  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .hero__h1 {
    margin: 0;
    font-family: var(--font-family-host-grotesk);
    font-size: clamp(42px, 6vw, 80px);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: var(--color-text-primary);
    display: flex;
    flex-direction: column;
    gap: 0.05em;
  }

  .hero__h1-accent {
    color: var(--agents-accent);
  }

  .hero__body {
    margin: 0;
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 52ch;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--font-family-host-grotesk);
    font-weight: 700;
    font-size: 16px;
    border-radius: var(--radius-none);
    cursor: pointer;
    transition: opacity 150ms, background 150ms;
  }

  .hero__cta--primary {
    padding: 16px 24px;
    background: var(--agents-accent);
    color: #fff;
    border: none;
  }

  .hero__cta--primary:hover {
    opacity: 0.9;
  }

  .hero__cta--primary:focus-visible {
    outline: 2px solid var(--agents-accent);
    outline-offset: 3px;
  }

  .hero__cta--ghost {
    padding: 14px 24px;
    background: transparent;
    color: var(--color-text-primary);
    border: 2px solid var(--color-border-default);
  }

  .hero__cta--ghost:hover {
    background: var(--color-bg-subtle, #F6F6F5);
  }

  .hero__cta--ghost:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 3px;
  }

  /* ── Mock card ────────────────────────────────────────── */
  .hero__mock-wrap {
    display: flex;
    justify-content: center;
  }

  .hero__mock {
    width: 100%;
    max-width: 440px;
    border: 2px solid var(--color-border-default);
    box-shadow: var(--shadow-md);
    background: var(--color-bg-page);
    display: flex;
    flex-direction: column;
  }

  .mock__header {
    background: var(--agents-accent);
    color: #fff;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mock__label {
    font-family: var(--font-family-host-grotesk);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .mock__channel {
    font-family: var(--font-family-host-grotesk);
    font-size: 13px;
    font-weight: 600;
    opacity: 0.85;
  }

  .mock__body {
    padding: 24px 20px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mock__name {
    margin: 0;
    font-family: var(--font-family-host-grotesk);
    font-size: 24px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .mock__desc {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .mock__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    border-top: 2px solid var(--color-border-default);
  }

  .mock__table tr {
    border-bottom: 1px solid var(--color-border-default);
  }

  .mock__table th,
  .mock__table td {
    padding: 10px 0;
    text-align: left;
    vertical-align: top;
  }

  .mock__table th {
    color: var(--color-text-secondary);
    font-weight: 400;
    width: 100px;
    min-width: 100px;
    padding-right: 12px;
  }

  .mock__table td {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .mock__cta-row {
    margin-top: 20px;
    background: var(--color-text-primary);
    color: #fff;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-family-host-grotesk);
    font-size: 15px;
    font-weight: 700;
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 640px) {
    .hero__ctas {
      flex-direction: column;
      align-items: flex-start;
    }
    .hero__cta {
      width: 100%;
      justify-content: center;
    }
  }
</style>
