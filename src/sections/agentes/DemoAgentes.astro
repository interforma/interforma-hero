---
// DemoAgentes.astro — Sección demo animada del operador para la página /agentes
---

<section id="demo" class="demo-section" aria-labelledby="demo-heading">
  <div class="demo-section__container">
    <div class="demo-section__grid">

      <!-- Columna izquierda: pasos -->
      <div class="demo__left">
        <p class="demo__eyebrow" aria-hidden="true">Demo · app del operador</p>
        <h2 id="demo-heading" class="demo__h2">Un turno, en treinta segundos.</h2>

        <ol class="demo__steps" id="demoAgStepsList" aria-label="Pasos de la demostración">
          <li class="demo__step" data-start="0" data-end="10">
            <button type="button" class="demo__step-btn" data-goto="0"
                    aria-label="Ir al paso 1: El agente atiende">
              <span class="demo__snum">01</span>
              <span class="demo__scontent">
                <span class="demo__stitle">El agente atiende</span>
                <span class="demo__sdesc">Responde por WhatsApp y recoge los datos de la cotización.</span>
              </span>
              <span class="demo__sbar" aria-hidden="true">
                <span class="demo__sbar-fill"></span>
              </span>
            </button>
          </li>
          <li class="demo__step" data-start="10" data-end="16">
            <button type="button" class="demo__step-btn" data-goto="10"
                    aria-label="Ir al paso 2: Pide ayuda">
              <span class="demo__snum">02</span>
              <span class="demo__scontent">
                <span class="demo__stitle">Pide ayuda</span>
                <span class="demo__sdesc">Detecta un descuento fuera de política y deriva con todo el contexto.</span>
              </span>
              <span class="demo__sbar" aria-hidden="true">
                <span class="demo__sbar-fill"></span>
              </span>
            </button>
          </li>
          <li class="demo__step" data-start="16" data-end="22">
            <button type="button" class="demo__step-btn" data-goto="16"
                    aria-label="Ir al paso 3: Tomas la conversación">
              <span class="demo__snum">03</span>
              <span class="demo__scontent">
                <span class="demo__stitle">Tomas la conversación</span>
                <span class="demo__sdesc">El agente queda en pausa; respondes sin volver a preguntar.</span>
              </span>
              <span class="demo__sbar" aria-hidden="true">
                <span class="demo__sbar-fill"></span>
              </span>
            </button>
          </li>
          <li class="demo__step" data-start="22" data-end="29">
            <button type="button" class="demo__step-btn" data-goto="22"
                    aria-label="Ir al paso 4: Apruebas la cotización">
              <span class="demo__snum">04</span>
              <span class="demo__scontent">
                <span class="demo__stitle">Apruebas la cotización</span>
                <span class="demo__sdesc">Nada llega al cliente sin tu visto bueno.</span>
              </span>
              <span class="demo__sbar" aria-hidden="true">
                <span class="demo__sbar-fill"></span>
              </span>
            </button>
          </li>
          <li class="demo__step" data-start="29" data-end="35">
            <button type="button" class="demo__step-btn" data-goto="29"
                    aria-label="Ir al paso 5: Mides el piloto">
              <span class="demo__snum">05</span>
              <span class="demo__scontent">
                <span class="demo__stitle">Mides el piloto</span>
                <span class="demo__sdesc">El KPI acordado, día a día, hasta la decisión del día 30.</span>
              </span>
              <span class="demo__sbar" aria-hidden="true">
                <span class="demo__sbar-fill"></span>
              </span>
            </button>
          </li>
        </ol>

        <button type="button" class="demo__playpause" id="demoAgPlayPause" aria-label="Pausar demo">
          <svg class="demo__icon-pause" width="14" height="14" viewBox="0 0 24 24"
               fill="currentColor" aria-hidden="true">
            <rect x="6" y="4" width="4" height="16"/>
            <rect x="14" y="4" width="4" height="16"/>
          </svg>
          <svg class="demo__icon-play" width="14" height="14" viewBox="0 0 24 24"
               fill="currentColor" aria-hidden="true" style="display:none">
            <path d="M6 4l14 8-14 8z"/>
          </svg>
          <span class="demo__pp-label">Pausar demo</span>
        </button>
      </div>

      <!-- Columna derecha: phone mockup -->
      <div class="demo__right">
        <div class="phone" id="demoAgPhone" role="img"
             aria-label="Simulación de la aplicación del operador">
          <div class="phone__notch" aria-hidden="true"></div>
          <div class="phone__status" aria-hidden="true">9:41</div>
          <div class="phone__screen" id="demoAgPhoneScreen"
               aria-live="polite" aria-atomic="true"></div>
          <div class="phone__home-bar" aria-hidden="true"></div>
        </div>
        <p class="demo__disclaimer">Demostración con datos de ejemplo.</p>
      </div>

    </div>
  </div>
</section>

<style>
  .demo-section {
    padding: 96px 0 72px;
  }

  .demo-section__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 72px);
  }

  .demo-section__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: 56px;
    align-items: center;
  }

  /* ── Left column ──────────────────────────────────────── */
  .demo__left {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .demo__eyebrow {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--agents-700);
  }

  .demo__h2 {
    margin: 0;
    font-family: var(--font-family-host-grotesk);
    font-size: clamp(30px, 3.6vw, 44px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    max-width: 18ch;
  }

  /* ── Steps ────────────────────────────────────────────── */
  .demo__steps {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 2px solid var(--color-border-default);
  }

  .demo__step {
    border-bottom: 2px solid var(--color-border-default);
  }

  .demo__step-btn {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    cursor: pointer;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 12px;
    padding: 16px 0;
    position: relative;
  }

  .demo__step-btn:focus-visible {
    outline: 2px solid var(--agents-accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .demo__snum {
    font-weight: 700;
    font-size: 14px;
    line-height: 24px;
    color: var(--color-text-tertiary, #9C9C97);
    transition: color 200ms;
  }

  .demo__step.is-active .demo__snum { color: var(--agents-accent); }
  .demo__step.is-done   .demo__snum { color: var(--color-text-secondary); }

  .demo__scontent {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .demo__stitle {
    font-family: var(--font-family-host-grotesk);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-text-tertiary, #9C9C97);
    transition: color 200ms;
  }

  .demo__step.is-active .demo__stitle,
  .demo__step.is-done   .demo__stitle { color: var(--color-text-primary); }

  .demo__sdesc {
    display: none;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .demo__step.is-active .demo__sdesc { display: block; }

  /* Progress bar */
  .demo__sbar {
    position: absolute;
    left: 0;
    bottom: -2px;
    height: 2px;
    width: 100%;
    background: transparent;
  }

  .demo__sbar-fill {
    display: block;
    height: 100%;
    width: 0;
    background: var(--agents-accent);
    transition: none;
  }

  /* Play/pause */
  .demo__playpause {
    align-self: flex-start;
    display: inline-flex;
    gap: 10px;
    align-items: center;
    height: 44px;
    padding: 0 18px;
    background: transparent;
    color: var(--color-text-primary);
    border: 2px solid var(--color-border-default);
    border-radius: 0;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 150ms, background 150ms;
  }

  .demo__playpause:hover {
    border-color: var(--color-text-secondary);
    background: var(--color-bg-subtle, #F6F6F5);
  }

  .demo__playpause:focus-visible {
    outline: 2px solid var(--agents-accent);
    outline-offset: 3px;
  }

  .demo__icon-pause,
  .demo__icon-play { color: var(--agents-accent); }

  /* ── Right column: phone ──────────────────────────────── */
  .demo__right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    zoom: 0.82;
  }

  .phone {
    width: 402px;
    height: 740px;
    border-radius: 40px;
    border: 8px solid #1a1a18;
    background: #F6F6F5;
    position: relative;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.08),
      0 40px 80px rgba(0,0,0,0.22);
    color: #111110;
    font-family: var(--font-family-host-grotesk);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }

  .phone__notch {
    position: absolute;
    top: 10px;
    left: 50%;
    margin-left: -56px;
    width: 112px;
    height: 32px;
    border-radius: 20px;
    background: #000;
    z-index: 50;
  }

  .phone__status {
    position: absolute;
    top: 18px;
    left: 32px;
    font-size: 14px;
    font-weight: 600;
    z-index: 40;
    pointer-events: none;
  }

  .phone__screen {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .phone__home-bar {
    position: absolute;
    bottom: 8px;
    left: 50%;
    margin-left: -60px;
    width: 120px;
    height: 5px;
    border-radius: 3px;
    background: rgba(0,0,0,0.22);
    z-index: 60;
  }

  .demo__disclaimer {
    font-size: 12px;
    color: var(--color-text-secondary);
    margin: 0;
    text-align: center;
  }

  /* ── Phone animation keyframes ────────────────────────── */
  @keyframes agMsgIn {
    from { opacity: 0; transform: translateY(10px) scale(0.98); }
    to   { opacity: 1; transform: none; }
  }

  @keyframes agScreenIn {
    from { opacity: 0; transform: translateX(18px); }
    to   { opacity: 1; transform: none; }
  }

  @keyframes agBannerIn {
    from { opacity: 0; transform: translateY(-16px); }
    to   { opacity: 1; transform: none; }
  }

  @keyframes agCaretBlink { 50% { opacity: 0; } }

  @keyframes agTapRing {
    from { transform: scale(0.6); opacity: 1; }
    to   { transform: scale(1.6); opacity: 0; }
  }

  @keyframes agTypingDot {
    0%, 60%, 100% { transform: translateY(0);    opacity: 0.5; }
    30%            { transform: translateY(-4px); opacity: 1; }
  }

  .ag-phone-msg    { animation: agMsgIn    0.35s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .ag-phone-screen { animation: agScreenIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .ag-phone-banner { animation: agBannerIn 0.4s  cubic-bezier(0.16, 1, 0.3, 1) both; }
  .ag-caret        { animation: agCaretBlink 1s steps(1) infinite; }
  .ag-tap          { animation: agTapRing 0.7s ease-out infinite; }

  .ag-typing-inline { display: inline-flex; gap: 3px; }
  .ag-typing-inline i {
    display: block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #6E6E68;
    animation: agTypingDot 1s infinite;
  }
  .ag-typing-inline i:nth-child(2) { animation-delay: 0.15s; }
  .ag-typing-inline i:nth-child(3) { animation-delay: 0.3s; }

  /* ── Responsive ───────────────────────────────────────── */
  @media (max-width: 900px) {
    .phone {
      width: 320px;
      height: 592px;
      border-radius: 32px;
    }

    .phone__notch {
      width: 90px;
      height: 26px;
      margin-left: -45px;
    }
  }

  @media (max-width: 640px) {
    .phone {
      width: 280px;
      height: 520px;
      border-radius: 28px;
    }
  }

  /* ── Reduced motion ───────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .ag-phone-msg, .ag-phone-screen, .ag-phone-banner,
    .ag-caret, .ag-tap { animation: none; }
    .ag-typing-inline i { animation: none; }
  }
</style>

<script>
  (() => {
    const LEN  = 35;
    const TICK = 750;
    const REPLY = 'Hola María José, soy Carla. Puedo ofrecerte 10% + implementación sin costo. ¿Te preparo la cotización?';

    const STEPS = [
      { start: 0,  end: 10 },
      { start: 10, end: 16 },
      { start: 16, end: 22 },
      { start: 22, end: 29 },
      { start: 29, end: 35 },
    ];

    const MSGS = [
      { t: 1,  from: 'cliente',  text: 'Hola, necesito cotizar el plan mensual para 3 sucursales.' },
      { t: 3,  from: 'agente',   text: '¡Claro! ¿Cuántos usuarios en total y por cuánto tiempo?' },
      { t: 5,  from: 'cliente',  text: '40 usuarios, 12 meses. ¿Me pueden dar 20% de descuento?' },
      { t: 7,  from: 'agente',   text: 'Déjame consultarlo con el equipo. Te respondo en unos minutos.' },
      { t: 8,  from: 'sistema',  text: 'Derivada a una persona · descuento fuera de política' },
      { t: 16, from: 'sistema',  text: 'Carla tomó la conversación · agente en pausa' },
      { t: 20, from: 'operador', text: REPLY },
    ];

    const C = {
      ink:  '#111110',
      wht:  '#FFFFFF',
      ppr:  '#F6F6F5',
      g200: '#E3E3E0',
      g300: '#D1D1CD',
      g400: '#9C9C97',
      g500: '#6E6E68',
      g700: '#3D3D3B',
      a100: '#FFE0D9',
      a400: '#FF9783',
      a500: '#FF563C',
      a600: '#DD2B0F',
      a700: '#AE1800',
      a800: '#7C1405',
      acc:  '#EC3013',
    };

    const MS: Record<string, { align: string; bg: string; fg: string; bd: string; who: string; radius: string }> = {
      cliente:  { align: 'flex-start', bg: C.g200, fg: C.ink,  bd: 'none',                   who: '',          radius: '12px 12px 12px 4px' },
      agente:   { align: 'flex-end',   bg: C.ink,  fg: C.wht,  bd: 'none',                   who: 'Agente IA', radius: '12px 12px 4px 12px' },
      operador: { align: 'flex-end',   bg: C.a700, fg: C.wht,  bd: 'none',                   who: 'Carla',     radius: '12px 12px 4px 12px' },
      sistema:  { align: 'center',     bg: 'transparent', fg: C.g500, bd: `1px solid ${C.g300}`, who: '',      radius: '8px' },
    };

    const stepItems  = Array.from(document.querySelectorAll('#demoAgStepsList .demo__step'));
    const stepFills  = stepItems.map(li => li.querySelector('.demo__sbar-fill'));
    const phoneEl    = document.getElementById('demoAgPhoneScreen');
    const ppBtn      = document.getElementById('demoAgPlayPause');
    const ppLabel    = ppBtn?.querySelector('.demo__pp-label');
    const ppPause    = ppBtn?.querySelector('.demo__icon-pause');
    const ppPlay     = ppBtn?.querySelector('.demo__icon-play');
    const sectionEl  = document.getElementById('demo');

    let tick = 3, playing = true;
    let iv: ReturnType<typeof setInterval> | null = null;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function buildMsg(m: typeof MSGS[0], animate: boolean): string {
      const s = MS[m.from];
      const cls = animate ? 'ag-phone-msg' : '';
      const who = s.who ? `<span style="font-size:9.5px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;opacity:0.8;">${s.who}</span>` : '';
      const fs   = m.from === 'sistema' ? '11.5px' : '13px';
      const maxw = m.from === 'sistema' ? '100%' : '84%';
      return `<div class="${cls}" style="align-self:${s.align};max-width:${maxw};background:${s.bg};color:${s.fg};border:${s.bd};border-radius:${s.radius};padding:9px 11px;font-size:${fs};line-height:1.4;display:flex;flex-direction:column;gap:3px;">${who}<span>${m.text}</span></div>`;
    }

    function buildChatScreen(t: number): string {
      const opPhase = t >= 16;
      const tag = !opPhase
        ? (t >= 8 ? { label: 'Espera persona', bg: C.a600, fg: C.wht }
                  : { label: 'Agente IA', bg: C.g200, fg: C.g700 })
        : { label: 'Atiende usted', bg: C.a100, fg: C.a800 };

      const msgsHtml = MSGS.filter(m => t >= m.t)
        .map(m => buildMsg(m, m.t === t)).join('');

      const typingHtml = (t === 2 || t === 6)
        ? `<div style="align-self:flex-end;display:flex;align-items:center;gap:8px;background:${C.g200};color:${C.g700};border-radius:12px;padding:9px 11px;font-size:12.5px;"><span class="ag-typing-inline"><i></i><i></i><i></i></span>Agente IA escribiendo</div>`
        : '';

      const bannerHtml = (t === 10 || t === 11)
        ? `<div class="ag-phone-banner" style="position:absolute;top:50px;left:10px;right:10px;z-index:30;background:${C.ink};color:${C.wht};border-radius:14px;padding:13px 15px;box-shadow:0 12px 32px rgba(0,0,0,0.3);display:flex;flex-direction:column;gap:4px;"><span style="font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:${C.a400};">Interforma Agents · ahora</span><span style="font-weight:800;font-size:14px;">María José espera a una persona</span><span style="font-size:12.5px;line-height:1.4;color:${C.g200};">Pide 20% de descuento. Política: máximo 10%.</span></div>`
        : '';

      const draft = (t >= 17 && t < 20) ? REPLY.slice(0, Math.round(REPLY.length * (t - 16) / 3.4)) : '';
      const agentStatus = t >= 8 ? 'Agente en pausa · esperando a una persona' : 'El agente está atendiendo';

      const bottomHtml = opPhase
        ? `<div style="display:flex;gap:8px;"><div style="flex:1;border:1px solid ${C.g300};border-radius:10px;background:${C.wht};padding:9px 11px;font-size:13px;line-height:1.35;min-height:18px;">${draft}<span class="ag-caret" style="display:inline-block;width:2px;height:15px;background:${C.a600};vertical-align:-3px;margin-left:1px;"></span></div><div style="width:42px;border-radius:10px;background:${C.a600};color:${C.wht};display:flex;align-items:center;justify-content:center;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></div></div>`
        : `<div style="display:flex;align-items:center;gap:10px;font-size:12.5px;color:${C.g700};"><span style="width:8px;height:8px;background:${C.acc};display:block;flex-shrink:0;"></span>${agentStatus}</div>`;

      return `<div style="padding:56px 16px 12px;border-bottom:1px solid ${C.g300};display:flex;align-items:center;gap:10px;"><div style="flex:1;display:flex;flex-direction:column;gap:2px;"><span style="font-weight:800;font-size:16px;">María José Pérez</span><span style="font-size:12px;color:${C.g500};">WhatsApp · Cotización</span></div><span style="font-size:10px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;padding:5px 8px;border-radius:4px;white-space:nowrap;background:${tag.bg};color:${tag.fg};">${tag.label}</span></div><div style="flex:1;display:flex;flex-direction:column;justify-content:flex-end;gap:8px;padding:14px;overflow:hidden;">${msgsHtml}${typingHtml}</div><div style="border-top:1px solid ${C.g300};padding:12px 14px 30px;">${bottomHtml}</div>${bannerHtml}`;
    }

    function buildHandoffScreen(t: number): string {
      const tapHtml = (t === 14 || t === 15)
        ? `<span class="ag-tap" style="position:absolute;left:50%;top:50%;width:34px;height:34px;margin:-17px 0 0 -17px;border-radius:50%;border:2px solid ${C.wht};background:rgba(255,255,255,0.3);"></span>` : '';
      const takeBg = t === 15 ? C.a700 : C.a600;
      return `<div class="ag-phone-screen" style="display:flex;flex-direction:column;flex:1;"><div style="background:${C.acc};color:${C.wht};padding:58px 18px 16px;display:flex;flex-direction:column;gap:8px;"><span style="font-size:10px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;">Espera a una persona · 6 min</span><span style="font-size:26px;font-weight:800;line-height:1.05;letter-spacing:-0.02em;">María José Pérez</span></div><div style="flex:1;padding:16px 18px;display:flex;flex-direction:column;gap:16px;"><div style="display:flex;flex-direction:column;gap:5px;"><span style="font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:${C.a700};">Por qué pidió ayuda</span><span style="font-size:15px;line-height:1.45;font-weight:600;">Pide 20% de descuento; la política permite máximo 10%.</span></div><div style="display:flex;flex-direction:column;"><span style="font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:${C.g500};padding-bottom:6px;">Lo que aprendió el agente</span><div style="border-top:1px solid ${C.ink};font-size:13px;"><div style="display:grid;grid-template-columns:88px 1fr;gap:8px;padding:9px 0;border-bottom:1px solid ${C.g200};"><span style="color:${C.g500};">Intención</span><span style="font-weight:600;">Cotización · plan mensual</span></div><div style="display:grid;grid-template-columns:88px 1fr;gap:8px;padding:9px 0;border-bottom:1px solid ${C.g200};"><span style="color:${C.g500};">Datos</span><span style="font-weight:600;">3 sucursales · 40 usuarios</span></div><div style="display:grid;grid-template-columns:88px 1fr;gap:8px;padding:9px 0;border-bottom:1px solid ${C.g200};"><span style="color:${C.g500};">Sugerencia</span><span style="font-weight:600;">10% + implementación sin costo</span></div><div style="display:grid;grid-template-columns:88px 1fr;gap:8px;padding:9px 0;border-bottom:1px solid ${C.g200};"><span style="color:${C.g500};">Confianza</span><span style="font-weight:600;">54%</span></div></div></div></div><div style="padding:12px 14px 30px;border-top:1px solid ${C.g300};"><div style="position:relative;display:flex;justify-content:space-between;align-items:center;background:${takeBg};color:${C.wht};border-radius:12px;padding:15px;font-weight:700;font-size:15px;"><span>Tomar conversación</span><span>→</span>${tapHtml}</div></div></div>`;
    }

    function buildAprobScreen(t: number): string {
      const tapHtml = (t === 25 || t === 26)
        ? `<span class="ag-tap" style="position:absolute;left:50%;top:50%;width:34px;height:34px;margin:-17px 0 0 -17px;border-radius:50%;border:2px solid ${C.wht};background:rgba(255,255,255,0.3);"></span>` : '';
      const approveBg = t === 26 ? C.a700 : C.a600;
      const aprobCount = t >= 27 ? '2' : '3';
      const bottomHtml = t < 27
        ? `<div style="display:grid;grid-template-columns:1fr 1.4fr;gap:8px;"><div style="border:1px solid ${C.ink};border-radius:12px;padding:14px;font-weight:700;font-size:14px;text-align:center;">Rechazar</div><div style="position:relative;display:flex;justify-content:space-between;align-items:center;background:${approveBg};color:${C.wht};border-radius:12px;padding:14px;font-weight:700;font-size:14px;"><span>Aprobar y enviar</span><span>✓</span>${tapHtml}</div></div>`
        : `<div class="ag-phone-msg" style="display:flex;align-items:center;gap:10px;background:${C.ink};color:${C.wht};border-radius:12px;padding:15px;font-weight:700;font-size:14px;"><span style="color:${C.a500};">✓</span><span>Aprobada · enviada a María José</span></div>`;
      return `<div class="ag-phone-screen" style="display:flex;flex-direction:column;flex:1;"><div style="padding:58px 18px 12px;border-bottom:1px solid ${C.g300};display:flex;justify-content:space-between;align-items:baseline;"><span style="font-size:26px;font-weight:800;letter-spacing:-0.02em;">Aprobaciones</span><span style="font-size:20px;font-weight:800;color:${C.acc};">${aprobCount}</span></div><div style="flex:1;padding:16px 18px;display:flex;flex-direction:column;gap:12px;overflow:hidden;"><span style="font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:${C.a700};">Cotización · propuesta por el agente</span><span style="font-size:20px;font-weight:800;line-height:1.15;letter-spacing:-0.01em;">Plan mensual · 40 usuarios · María José Pérez</span><div style="border-top:1px solid ${C.ink};font-size:13px;"><div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid ${C.g200};"><span style="color:${C.g500};">Precio lista</span><span style="font-weight:600;">US$ 2.400 / mes</span></div><div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid ${C.g200};"><span style="color:${C.g500};">Descuento</span><span style="font-weight:600;">10% · dentro de política</span></div><div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid ${C.g200};"><span style="color:${C.g500};">Implementación</span><span style="font-weight:600;">Sin costo</span></div><div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid ${C.ink};font-size:15px;font-weight:800;"><span>Total mensual</span><span>US$ 2.160</span></div></div></div><div style="padding:12px 14px 30px;border-top:1px solid ${C.g300};">${bottomHtml}</div></div>`;
    }

    function buildHomeScreen(t: number): string {
      const homeT = t - 29;
      const kpiVal = homeT >= 2 ? '42 s' : '18 min';
      const barsH = [100, 92, 70, 48, 30, 18, 12, 9, 7, 6, 5, 4];
      const barsHtml = barsH.map((h, i) => {
        const ht = homeT >= 1 ? `${h}%` : '2%';
        const bg = i < 2 ? '#BAB6B6' : C.acc;
        return `<span style="flex:1;height:${ht};background:${bg};border-radius:2px 2px 0 0;transition:height .5s;"></span>`;
      }).join('');
      return `<div class="ag-phone-screen" style="padding:58px 18px 0;display:flex;flex-direction:column;flex:1;"><div style="display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid ${C.g300};padding-bottom:10px;"><span style="font-size:13px;color:${C.g500};">Hola, Carla</span><span style="font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:${C.a700};">Piloto · Día 12 de 30</span></div><div style="font-size:26px;font-weight:800;line-height:1.05;letter-spacing:-0.02em;margin:14px 0 16px;">Cotizaciones</div><div style="border-top:1px solid ${C.ink};border-bottom:1px solid ${C.ink};padding:14px 0;display:flex;flex-direction:column;gap:8px;"><span style="font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:${C.g500};">KPI del piloto · Tiempo de respuesta</span><div style="display:flex;align-items:baseline;gap:10px;"><span style="font-size:52px;font-weight:800;line-height:1;letter-spacing:-0.04em;">${kpiVal}</span><span style="font-size:18px;font-weight:800;color:${C.acc};">−96%</span></div><div style="display:flex;align-items:flex-end;gap:4px;height:56px;margin-top:4px;">${barsHtml}</div><div style="display:flex;justify-content:space-between;font-size:12px;color:${C.g500};"><span>Línea base 18 min</span><span>Meta −50%</span></div></div><div style="font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:${C.g500};margin:16px 0 6px;">Requiere tu atención</div><div style="border-top:1px solid ${C.ink};"><div style="display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid ${C.g200};"><span style="font-size:22px;font-weight:800;min-width:28px;color:${C.acc};">1</span><span style="font-size:13px;font-weight:600;">Conversación espera a una persona</span></div><div style="display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid ${C.g200};"><span style="font-size:22px;font-weight:800;min-width:28px;color:${C.acc};">2</span><span style="font-size:13px;font-weight:600;">Acciones por aprobar</span></div></div></div>`;
    }

    function render(t: number) {
      stepItems.forEach((li, i) => {
        const s = STEPS[i];
        const active = t >= s.start && t < s.end;
        const done   = t >= s.end;
        li.classList.toggle('is-active', active);
        li.classList.toggle('is-done',   done);
        const pct = active
          ? `${((t - s.start + 1) / (s.end - s.start)) * 100}%`
          : (done ? '100%' : '0%');
        const fill = stepFills[i] as HTMLElement | null;
        if (fill) {
          fill.style.transition = active ? 'width 0.75s linear' : 'none';
          fill.style.width = pct;
        }
      });

      if (!phoneEl) return;
      const view = t < 12 ? 'chat' : t < 16 ? 'handoff' : t < 22 ? 'chat' : t < 29 ? 'aprob' : 'home';
      if      (view === 'chat')    phoneEl.innerHTML = buildChatScreen(t);
      else if (view === 'handoff') phoneEl.innerHTML = buildHandoffScreen(t);
      else if (view === 'aprob')   phoneEl.innerHTML = buildAprobScreen(t);
      else                         phoneEl.innerHTML = buildHomeScreen(t);
    }

    if (reduced) {
      render(25);
      if (ppBtn) (ppBtn as HTMLElement).style.display = 'none';
      return;
    }

    function syncPPBtn() {
      if (ppLabel)  ppLabel.textContent = playing ? 'Pausar demo' : 'Reproducir demo';
      if (ppBtn)    ppBtn.setAttribute('aria-label', playing ? 'Pausar demo' : 'Reproducir demo');
      if (ppPause)  (ppPause as HTMLElement).style.display = playing ? '' : 'none';
      if (ppPlay)   (ppPlay as HTMLElement).style.display  = playing ? 'none' : '';
    }

    ppBtn?.addEventListener('click', () => {
      playing = !playing;
      syncPPBtn();
    });

    document.querySelectorAll('#demoAgStepsList .demo__step-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const goto = parseInt((btn as HTMLElement).dataset.goto ?? '', 10);
        if (!isNaN(goto)) { tick = goto; render(tick); }
      });
    });

    function startTimer() {
      if (iv) return;
      iv = setInterval(() => {
        if (!playing) return;
        tick = (tick + 1) % LEN;
        render(tick);
      }, TICK);
    }

    function stopTimer() {
      if (iv) { clearInterval(iv); iv = null; }
    }

    if (sectionEl && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        entries => entries.forEach(e => e.isIntersecting ? startTimer() : stopTimer()),
        { threshold: 0.1 }
      );
      io.observe(sectionEl);
    } else {
      startTimer();
    }

    render(tick);
  })();
</script>
